{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "connections_overhaul/**",
              "dashboard_overhaul/**",
              "design_handoff_comfyui_combined/design/**",
              "design_handoff_comfyui_imagegen/design/**",
              "design_handoff_dashboard/design/**",
              "design_handoff_inference_memmap/design/**",
              "design_handoff_inference_slots/src/**",
              "design_handoff_npu_combined/design/**",
              "design_handoff_npu_widgets/design/**",
              "design_handoff_stacks_focus/**",
              "explorations/agent-cards/**",
              "explorations/comfyui-row/**",
              "explorations/inference-row/**",
              "memory_overhaul/**",
              "npu_widget/**",
              "profiles_overhaul/**",
              "stacks_overhaul/**",
              "ui_kits/board/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|JetBrains Mono|Monomaniac One))/i]",
        "message": "Font not provided by the design system. Available: Geist, JetBrains Mono, Monomaniac One."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentAbility'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|cost|desc|key|ref|className|style|children)$/]",
        "message": "<AgentAbility> doesn't accept that prop. Declared props: name, cost, desc."
      },
      {
        "selector": "JSXOpeningElement[name.name='BannerAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|primary|onClick|key|ref|className|style|children)$/]",
        "message": "<BannerAction> doesn't accept that prop. Declared props: label, primary, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|right|padded|bodyClassName|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, right, padded, bodyClassName."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|outlined|icon|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, outlined, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|amber|ok|warn|err|info|gpu-vulkan|vulkan|gpu-rocm|rocm|npu|cpu)$/]",
        "message": "<Chip> tone must be one of 'default' | 'amber' | 'ok' | 'warn' | 'err' | 'info' | 'gpu-vulkan' | 'vulkan' | 'gpu-rocm' | 'rocm' | 'npu' | 'cpu'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|sw|fill|stroke|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, sw, fill, stroke, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:dashboard|slots|models|hardware|backends|logs|connections|agent|settings|bell|search|send|attach|mic|chev|chevR|close|menu|check|warn|plus|ext|download|restart|unload|start|edit|more|cpu|flame|chat)$/]",
        "message": "<Icon> name must be one of 'dashboard' | 'slots' | 'models' | 'hardware' | 'backends' | 'logs' | 'connections' | 'agent' | 'settings' | 'bell' | 'search' | 'send' | 'attach' | 'mic' | 'chev' | 'chevR' | 'close' | 'menu' | 'check' | 'warn' | 'plus' | 'ext' | 'download' | 'restart' | 'unload' | 'start' | 'edit' | 'more' | 'cpu' | 'flame' | 'chat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:mono|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: mono, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|title|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: state, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:serving|ready|recent|idle|stale|warming|starting|pulling|unloading|loading|error|offline|empty|coresident)$/]",
        "message": "<StatusDot> state must be one of 'serving' | 'ready' | 'recent' | 'idle' | 'stale' | 'warming' | 'starting' | 'pulling' | 'unloading' | 'loading' | 'error' | 'offline' | 'empty' | 'coresident'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|mono|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, mono, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
