    color: var(--accent);
  }
  @media (max-width: 640px) {
    .drawer-run {
      width: 100vw;
    }
  }
</style>

<script>
  // Vanilla filter island — no framework. Cards carry data-intent / data-lane
  // / data-families (space-separated); pills carry data-facet + data-value.
  // Selecting several pills within one facet is OR ("chat" or "coding");
  // selecting pills across facets is AND (family match AND intent match).
  // Server renders every card up front, so no-JS visitors still get the
  // full gallery — filtering here is purely a display toggle.
  const root = document.querySelector('[data-profile-filters]');
  const grid = document.querySelector('[data-profile-grid]');
  if (root && grid) {
    const cards = Array.from(grid.querySelectorAll('[data-profile-card]'));
    const readout = root.querySelector('[data-profile-readout]');
    const clearBtn = root.querySelector('[data-profile-clear]');
    const pills = Array.from(root.querySelectorAll('.fpill[data-facet]'));
    const facets = ['family', 'intent', 'lane'];
    /** @type {Record<string, Set<string>>} */
    const active = { family: new Set(), intent: new Set(), lane: new Set() };

    function syncPillClasses() {
      let anyActive = false;
      for (const facet of facets) {
        const isAll = active[facet].size === 0;
        if (!isAll) anyActive = true;
        for (const pill of pills) {
          if (pill.dataset.facet !== facet) continue;
          const isAllPill = pill.dataset.value === '__all__';
          const on = isAllPill ? isAll : active[facet].has(pill.dataset.value);
          pill.classList.toggle('on', on);
          pill.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
      }
      if (clearBtn) clearBtn.hidden = !anyActive;
    }

    function applyFilters() {
      let visible = 0;
      for (const card of cards) {
        const matches = facets.every((facet) => {
          if (active[facet].size === 0) return true;
          if (facet === 'family') {
            const cardFamilies = (card.dataset.families ?? '').split(' ').filter(Boolean);
            return cardFamilies.some((f) => active.family.has(f));
          }
          return active[facet].has(card.dataset[facet]);
        });
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (readout) readout.textContent = `${visible} of ${cards.length} profiles`;
    }

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        const facet = pill.dataset.facet;
        const value = pill.dataset.value;
        if (!facet || !value) return;
        if (value === '__all__') {
          active[facet].clear();
        } else if (active[facet].has(value)) {
          active[facet].delete(value);
        } else {
          active[facet].add(value);
        }
        syncPillClasses();
        applyFilters();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        for (const facet of facets) active[facet].clear();
        syncPillClasses();
        applyFilters();
      });
    }
  }
</script>

<script>
  // Detail drawer island — no framework. Every profile's <aside class="drawer-run">
  // is pre-rendered hidden; a card click (or Enter/Space, since cards are
  // role="button" tabindex="0") opens its drawer, pushes `?p=<slug>` so the
  // view is deep-linkable, and locks body scroll. Scrim click / close button
  // / Escape closes it, walking history back only when we're the ones who
  // pushed the state (a page load that already carries ?p=<slug> just shows
  // the drawer without adding a redundant history entry).
  (() => {
    const scrim = document.querySelector<HTMLElement>('[data-profile-scrim]');
    const drawers = Array.from(document.querySelectorAll<HTMLElement>('.drawer-run[data-profile]'));
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-profile-open]'));
    if (!scrim || drawers.length === 0) return;

    const bySlug = new Map<string, HTMLElement>(
      drawers.map((d) => [d.dataset.profile ?? '', d]).filter(([slug]) => slug),
    );
    const triggerBySlug = new Map<string, HTMLElement>(
      triggers.map((t) => [t.dataset.profileOpen ?? '', t]).filter(([slug]) => slug),
    );
    let openSlug: string | null = null;
    let pushedState = false;

    // Focus containment: while a drawer is open, everything outside it
    // (header/subnav, the page's own content, footer) is made `inert` —
    // the browser removes it from both the tab order and AT navigation,
    // so Tab can no longer walk out through the scrim onto an obscured
    // card behind it. `inert` cascades to descendants and can't be
    // "opted back in" on a child, so we inert body's other top-level
    // regions plus main's other children individually — never `<main>`
    // itself, since the drawers/scrim are its children too.
    function setShellInert(on: boolean) {
      for (const el of Array.from(document.body.children)) {
        if (el.tagName === 'MAIN' || el.tagName === 'SCRIPT') continue;
        if (on) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      }
      const mainEl = document.querySelector('main');
      if (!mainEl) return;
      for (const child of Array.from(mainEl.children)) {
        if (child === scrim || child.classList.contains('drawer-run')) continue;
        if (on) child.setAttribute('inert', '');
        else child.removeAttribute('inert');
      }
    }

    function focusableIn(container: HTMLElement): HTMLElement[] {
      return Array.from(
        container.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute('inert') && el.getClientRects().length > 0);
    }

    // Belt-and-braces Tab cycling on top of `inert`: once the rest of the
    // page is inert, a Tab off either end of the drawer's focusables has
    // nowhere else to land, so wrap explicitly rather than trust browser
    // fallback behavior.
    document.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== 'Tab' || !openSlug) return;
      const drawer = bySlug.get(openSlug);
      if (!drawer) return;
      const focusables = focusableIn(drawer);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (ke.shiftKey && document.activeElement === first) {
        ke.preventDefault();
        last.focus();
      } else if (!ke.shiftKey && document.activeElement === last) {
        ke.preventDefault();
        first.focus();
      }
    });

    function show(slug: string) {
      for (const [s, drawer] of bySlug) drawer.hidden = s !== slug;
      if (scrim) scrim.hidden = false;
      document.body.style.overflow = 'hidden';
      openSlug = slug;
      setShellInert(true);
      bySlug.get(slug)?.querySelector<HTMLElement>('[data-profile-close]')?.focus();
    }

    function hideAll() {
      for (const drawer of bySlug.values()) drawer.hidden = true;
      if (scrim) scrim.hidden = true;
      document.body.style.overflow = '';
      setShellInert(false);
    }

    function openDrawer(slug: string) {
      if (!bySlug.has(slug)) return;
      show(slug);
      const url = new URL(window.location.href);
      if (url.searchParams.get('p') !== slug) {
        url.searchParams.set('p', slug);
        window.history.pushState({ profile: slug }, '', url);
        pushedState = true;
      }
    }

    function closeDrawer() {
      if (!openSlug) return;
      const trigger = triggerBySlug.get(openSlug);
      hideAll();
      openSlug = null;
      if (pushedState) {
        pushedState = false;
        window.history.back();
      }
      trigger?.focus();
    }

    for (const trigger of triggers) {
      const slug = trigger.dataset.profileOpen;
      if (!slug) continue;
      trigger.addEventListener('click', () => openDrawer(slug));
      trigger.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          e.preventDefault();
          openDrawer(slug);
        }
      });
    }

    for (const drawer of drawers) {
      drawer.querySelector('[data-profile-close]')?.addEventListener('click', () => closeDrawer());
    }

    scrim.addEventListener('click', () => closeDrawer());

    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && openSlug) closeDrawer();
    });

    window.addEventListener('popstate', () => {
      const slug = new URL(window.location.href).searchParams.get('p');
      pushedState = false;
      if (slug && bySlug.has(slug)) {
        show(slug);
      } else if (openSlug) {
        const trigger = triggerBySlug.get(openSlug);
        hideAll();
        openSlug = null;
        trigger?.focus();
      }
    });

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-profile-copy-flags]')) {
      const original = btn.textContent;
      btn.addEventListener('click', async () => {
        if (!navigator.clipboard) return;
        const flags = btn.dataset.flags ?? '';
        try {
          await navigator.clipboard.writeText(flags);
        } catch {
          // clipboard denied/unavailable — no swap, so the button never
          // claims a copy that didn't happen
          return;
        }
        btn.textContent = 'flags copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1400);
      });
    }

    // Honor a deep link on load: `?p=<slug>` opens that profile's drawer
    // without pushing a new history entry (the URL already carries it).
    const initialSlug = new URL(window.location.href).searchParams.get('p');
    if (initialSlug && bySlug.has(initialSlug)) show(initialSlug);
  })();
</script>
</MarketingLayout>
