---
/**
 * /profiles — community profile gallery.
 *
 * Renders every profile ingested from Hal0ai/hal0-profiles (src/data/profiles.json,
 * refreshed by scripts/sync-profiles.mjs on prebuild) as a card, with a
 * vanilla-JS filter island (family / intent / lane pills, AND across facets,
 * OR within a facet). Bench numbers on the card come only from `benchFor`
 * (src/lib/profiles-join.mjs) joining the profile's models against the
 * first-party ROSTER — a card never shows a number none of its own models
 * produced, and the metric row is omitted entirely when the join is empty.
 *
 * Visual source of truth: docs/design/2026-08-09-community-comps/03 Profiles.html
 * (Card component + the on-page card-anatomy spec). The detail drawer from
 * that comp is Task 4 — cards render inert here (no drawer, no onclick).
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/site-data.css';
import profilesSnapshot from '../data/profiles.json';
import { benchFor, familiesOf, familyOf, renderProfileToml, tintToml } from '../lib/profiles-join.mjs';
import { ROSTER } from '../data/model-roster.ts';

const CONTRIBUTING_URL = 'https://github.com/Hal0ai/hal0-profiles/blob/main/CONTRIBUTING.md';
const PROFILES_REPO_RAW = 'https://github.com/Hal0ai/hal0-profiles/blob/main/profiles';

const profiles = profilesSnapshot.profiles;

// Strip the noise short() clips from a roster model id down to a short,
// scannable display name (ported from the comp's `short()` helper).
function shortName(id) {
  return id
    .replace(/-(rocmfp4|strix-lean|mtp|dynamic|it)(?=-|$)/g, '')
    .replace(/-(q\d[\w-]*|f16|mxfp4)$/i, '')
    .replace(/-+$/, '');
}

function modelIdsOf(profile) {
  return [profile.model.id, ...(profile.model.compatible ?? [])];
}

// Per-profile derived view data, computed once at build time.
const cards = profiles.map((record) => {
  const { profile, runner, history } = record;
  const models = modelIdsOf(record);
  const families = familiesOf(record);
  const bench = benchFor(record, ROSTER);
  const latest = history[0];
  const toml = tintToml(renderProfileToml(record));
  return {
    record,
    profile,
    runner,
    latest,
    models,
    families,
    bench,
    toml,
  };
});

// Static, full-corpus facet counts + option lists (derived from the data,
// not hardcoded — a new profile in a new family/intent/lane shows up here
// for free on the next sync).
function countBy(getValues) {
  const counts = new Map();
  for (const c of cards) {
    for (const v of getValues(c)) {
      counts.set(v, (counts.get(v) ?? 0) + 1);
    }
  }
  return counts;
}

const familyCounts = countBy((c) => c.families);
const intentCounts = countBy((c) => [c.profile.intent]);
const laneCounts = countBy((c) => [c.runner.lane]);

const familyOptions = [...familyCounts.keys()].sort();
const intentOptions = [...intentCounts.keys()].sort();
const laneOptions = [...laneCounts.keys()].sort();

const total = cards.length;

const description =
  "A profile is the flag string that produced a number, versioned and downloadable. Find the one for your model, install it with the CLI, or read the config and steal the parts you want.";
---

<MarketingLayout title="profiles — hal0" description={description}>
  <div class="wrap wide phead">
    <div class="phead-row">
      <div>
        <span class="eyebrow">shared configs · hal0-profiles</span>
        <h1 class="site-h1" style="margin: 10px 0 10px">profiles</h1>
        <p class="site-body" style="max-width: 60ch">
          A profile is the flag string that produced a number, versioned and downloadable.
          Find the one for your model, install it with the CLI, or read the config and steal the
          parts you want.
        </p>
      </div>
      <div style="display: flex; gap: 8px">
        <a class="btn ghost" href={CONTRIBUTING_URL} rel="noopener">how profiles work</a>
        <a class="btn" href={CONTRIBUTING_URL} rel="noopener">submit a profile</a>
      </div>
    </div>
  </div>

  <div class="wrap wide">
    <div class="filterbar" data-profile-filters>
      <div class="frow">
        <span class="label">model</span>
        <div class="fbar">
          <button type="button" class="fpill on" data-facet="family" data-value="__all__" aria-pressed="true">
            all<span class="n num">{total}</span>
          </button>
          {familyOptions.map((f) => (
            <button type="button" class="fpill" data-facet="family" data-value={f} aria-pressed="false">
              {f}<span class="n num">{familyCounts.get(f)}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="frow">
        <span class="label">intent</span>
        <div class="fbar">
          <button type="button" class="fpill on" data-facet="intent" data-value="__all__" aria-pressed="true">
            all<span class="n num">{total}</span>
          </button>
          {intentOptions.map((i) => (
            <button type="button" class="fpill" data-facet="intent" data-value={i} aria-pressed="false">
              {i}<span class="n num">{intentCounts.get(i)}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="frow">
        <span class="label">lane</span>
        <div class="fbar">
          <button type="button" class="fpill on" data-facet="lane" data-value="__all__" aria-pressed="true">
            all<span class="n num">{total}</span>
          </button>
          {laneOptions.map((l) => (
            <button type="button" class="fpill" data-facet="lane" data-value={l} aria-pressed="false">
              {l}<span class="n num">{laneCounts.get(l)}</span>
            </button>
          ))}
        </div>
      </div>
      <div style="display:flex; align-items:center; gap:12px; border-top:1px solid var(--line-soft); padding-top:11px; flex-wrap:wrap">
        <span class="mono" style="font-size:11.5px; color:var(--fg-3)" data-profile-readout>
          {total} of {total} profiles
        </span>
        <button type="button" class="btn ghost sm" data-profile-clear hidden>clear</button>
      </div>
    </div>

    <div class="pgrid" data-profile-grid>
      {cards.map(({ profile, runner, latest, models, families, bench }) => (
        <article
          class="pcard"
          data-profile-card
          data-profile-open={profile.slug}
          data-intent={profile.intent}
          data-lane={runner.lane}
          data-families={families.join(' ')}
          role="button"
          tabindex="0"
        >
          <div class="pc-top">
            <span class="eyebrow">profile · v{latest.v} · {runner.lane}</span>
            <span class="chip amber">{profile.intent}</span>
          </div>
          <div>
            <h3 class="pc-title mono">{profile.slug}</h3>
            <p class="pc-desc">{profile.title}</p>
          </div>

          <div class="pc-models">
            <span class="label">runs these models</span>
            <div class="fbar">
              {models.slice(0, 2).map((m) => (
                <span class="mchip" title={m}>
                  <span class="fam">{familyOf(m)}</span>{shortName(m)}
                </span>
              ))}
              {models.length > 2 && <span class="mchip more">+{models.length - 2}</span>}
            </div>
          </div>

          {bench.headline && (
            <div>
              <div class="pc-metrics">
                <div class="m">
                  <div class="v">{bench.headline.dec.toFixed(1)}<u>tok/s</u></div>
                  <div class="k">decode tok/s</div>
                </div>
                <div class="m">
                  <div class="v">{bench.headline.pf.toFixed(0)}<u>tok/s</u></div>
                  <div class="k">prefill</div>
                </div>
              </div>
              <div class="pc-src mono">
                measured on <b>{bench.headline.modelId}</b> · {runner.lane}
              </div>
            </div>
          )}

          <div class="pc-foot">
            {profile.first_party ? (
              <span class="chip amber" title="First-party run on hal0 reference hardware">first-party</span>
            ) : (
              <span style="display:inline-flex; align-items:center; gap:6px">
                <img
                  src={`https://github.com/${profile.author}.png?size=32`}
                  loading="lazy"
                  alt={`@${profile.author}`}
                  width="16"
                  height="16"
                  style="border-radius: var(--rad-sm)"
                />
                <span class="mono" style="font-size:11.5px; color:var(--fg-3)">@{profile.author}</span>
              </span>
            )}
            <span class="pc-open">config &amp; flags →</span>
          </div>
        </article>
      ))}
    </div>

    <div style="margin-top: 48px">
      <span class="eyebrow">component spec</span>
      <h2 class="site-h2" style="margin: 10px 0 16px">profile card anatomy</h2>
      <div class="anat">
        <ol>
          <li><b>1</b>eyebrow: version and lane, so the card states its provenance before anything else.</li>
          <li><b>2</b>slug in mono at 21px — the thing you type into the CLI, and the card's biggest element.</li>
          <li><b>3</b>one line of description. The full summary, flags and config live in the drawer, not here.</li>
          <li><b>4</b>the models this profile actually runs, as chips: family in amber, short model name after it. This is what people scan for, so it sits above the numbers.</li>
          <li><b>5</b>decode and prefill from the profile's own measured runs — never a number none of its runs produced. Omitted entirely when nothing in the roster matches.</li>
          <li><b>6</b>a mono footnote naming the exact model and lane the metrics came from. Metrics without this line are unfalsifiable.</li>
          <li><b>7</b>attribution slot — avatar and handle, or the amber first-party chip — and the affordance that opens the drawer.</li>
          <li><b>8</b>2px filament along the bottom edge, brightening on hover. Same motif as the header and the OG cards.</li>
        </ol>
        <p class="site-sm">Cards stay one column on mobile at full width; the model chips wrap and the metric row keeps its columns.</p>
      </div>
    </div>
  </div>

  <div class="scrim" data-profile-scrim hidden></div>

  {cards.map(({ record, profile, latest, bench, toml }) => (
    <aside class="drawer-run" role="dialog" aria-label="profile detail" hidden data-profile={profile.slug}>
      <div class="dr-head">
        <div>
          <span class="eyebrow">profile · v{latest.v} · {latest.date}</span>
          <div class="mono" style="font-size:14px; margin-top:6px">{profile.slug}</div>
          <div class="site-sm" style="margin-top:4px">{profile.title}</div>
        </div>
        <button type="button" class="iconbtn" data-profile-close aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" />
          </svg>
        </button>
      </div>
      <div class="dr-body">
        <p class="site-body" style="font-size:14px">{profile.summary}</p>

        <div class="dr-actions">
          <button type="button" class="btn ghost" data-profile-copy-flags data-flags={record.args.raw}>copy flags</button>
          <a class="btn ghost" href={`${PROFILES_REPO_RAW}/${profile.slug}.toml`} rel="noopener">install with hal0</a>
        </div>

        <section>
          <h4 class="label">install</h4>
          <div class="well" style="padding:12px 14px; margin-top:8px">
            <span class="amber">hal0</span> profile install {profile.slug}
          </div>
        </section>

        <section>
          <div class="dr-sec-head">
            <h4 class="label">flags</h4>
            <span class="mono dim" style="font-size:11px">{record.runner.kind}</span>
          </div>
          <pre class="well toml" style="white-space:pre-wrap; word-break:break-all">{record.args.raw}</pre>
        </section>

        <section>
          <div class="dr-sec-head">
            <h4 class="label">config</h4>
            <span class="mono dim" style="font-size:11px">{profile.slug}.toml</span>
          </div>
          <pre class="well toml">
            {toml.map((line) => {
              if (line.cls === 'c') return <div class="c">{line.text}</div>;
              if (line.cls === 'h') return <div class="h">{line.text}</div>;
              if (line.cls === 'kv') return (
                <div><span class="k">{line.key}</span><span class={line.valueCls}>{line.value}</span></div>
              );
              return <div>{line.text}</div>;
            })}
          </pre>
        </section>

        <section>
          <div class="dr-sec-head">
            <h4 class="label">runs produced by this config</h4>
            <span class="mono dim" style="font-size:11px">{record.runner.lane}</span>
          </div>
          {bench.runs.length > 0 ? (
            <div class="panel" style="overflow:hidden">
              <table class="dtable">
                <thead>
                  <tr>
                    <th>model</th>
                    <th class="n">decode</th>
                    <th class="n">prefill</th>
                    <th class="n">gb</th>
                  </tr>
                </thead>
                <tbody>
                  {bench.runs.map((r) => (
                    <tr>
                      <td class="lead" style="max-width:210px; overflow:hidden; text-overflow:ellipsis">{r.modelId}</td>
                      <td class="n">{r.dec.toFixed(1)}</td>
                      <td class="n">{r.pf.toFixed(0)}</td>
                      <td class="n">{r.gb}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="site-sm">no measured runs yet — numbers appear when a sweep covers this config</p>
          )}
        </section>

        <section>
          <h4 class="label">versions</h4>
          <div class="vhist">
            {record.history.map((h) => (
              <div class="vh"><span class="v">v{h.v}</span><span>{h.date}</span><span>{h.note}</span></div>
            ))}
          </div>
        </section>
      </div>
    </aside>
  ))}
</MarketingLayout>

<style>
