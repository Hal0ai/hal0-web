---
/**
 * /releases — the release surface (the old /changelog and /releases pages
 * merged; /changelog 301s here via astro.config.mjs's `redirects` map).
 *
 * DERIVED, never hand-maintained: content comes from hal0's CHANGELOG.md
 * (synced to src/data/changelog.md by scripts/sync-changelog.mjs at build
 * time) through src/lib/changelog.js's parseChangelog, with the GitHub tag
 * list (src/data/release-tags.json) deciding which headings really shipped.
 *
 * Shape, top to bottom:
 *   1. a latest-stable card: version, date, its Highlights (or the first
 *      bullets of Added, Changed, Fixed when it has none), a Breaking
 *      callout when the entry has one, the install and update commands and
 *      the GitHub link;
 *   2. the eight most recent tagged entries as collapsible <details>, each
 *      an excerpt (Highlights in full, every other section cut to its first
 *      few bullets with a "+N more" link) so the page stays small;
 *   3. an archive: every older version as a version + date link to its
 *      GitHub release. This replaced one 1.09 MB page that inlined the
 *      whole history.
 * Untagged headings (changelog content ahead of the next git tag) stay in
 * the recent list with an "unreleased" badge.
 *
 * Version-neutral copy: every version string below comes from the data.
 *
 * Unrelated to the machine-readable updater manifest at releases.hal0.dev
 * (functions/_middleware.ts) — do not conflate the two.
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/site-data.css';
import rawChangelog from '../data/changelog.md?raw';
import releaseTags from '../data/release-tags.json';
import {
  parseChangelog,
  releaseTagUrl,
  releaseHighlights,
  releaseSections,
  splitReleases,
  plainText,
} from '../lib/changelog.js';

const { versions, latestTagged } = parseChangelog(rawChangelog, { tags: releaseTags.tags });
const { recent, archive } = splitReleases(versions);

// Tagged versions deep-link to their tag; untagged ones (changelog content
// ahead of the next tag, or old headings that never got a GitHub release)
// fall back to the always-valid releases index.
const RELEASES_URL = 'https://github.com/hal0ai/hal0/releases';
const entryUrl = (v: { untagged: boolean; version: string }) =>
  v.untagged ? RELEASES_URL : releaseTagUrl(v.version);

const isHighlights = (title: string) => title.trim().toLowerCase() === 'highlights';
const tagName = (version: string) => (/^v/i.test(version) ? version : `v${version}`);

// ── latest-stable card ──
const latest = latestTagged;
const CARD_MAX = 8;
const cardAll = latest ? releaseHighlights(latest, 3) : [];
const cardItems = cardAll.slice(0, CARD_MAX);
const cardMore = cardAll.length - cardItems.length;
const cardHasHighlights = !!latest && latest.sections.some((s) => isHighlights(s.title));
const breaking = latest
  ? releaseSections(latest, { max: 1 }).find((s) => s.kind === 'breaking')
  : undefined;

// ── recent entries ──
// One line for the collapsed row: the first highlight (or first bullet),
// else the intro, trimmed at a word boundary.
function oneLine(v: (typeof versions)[number]): string {
  const first = releaseHighlights(v, 1)[0] ?? v.intro ?? '';
  // Changelog bullets open with a bold headline; that is the summary.
  const lead = first.match(/^\s*(?:<p>)?\s*<strong>([\s\S]*?)<\/strong>/);
  const text = plainText(lead ? lead[1] : first).replace(/\.$/, '');
  if (text.length <= 120) return text;
  const cut = text.slice(0, 120);
  return `${cut.slice(0, cut.lastIndexOf(' ') > 60 ? cut.lastIndexOf(' ') : 120)}…`;
}

function status(v: (typeof versions)[number]): { label: string; cls: string } {
  if (v.untagged) return { label: 'unreleased', cls: 'chip' };
  if (v.prerelease) return { label: 'pre-release', cls: 'chip amber' };
  if (v.gaPreview) return { label: 'preview', cls: 'chip warn' };
  return { label: 'stable', cls: 'chip ok' };
}

const entries = recent.map((v) => {
  const isLatest = !!latest && v.slug === latest.slug;
  // The card already shows the latest entry's Highlights; the entry below
  // repeats them only when the card had to cut some.
  const sections = releaseSections(v, {
    max: 4,
    skipHighlights: isLatest && cardHasHighlights && cardMore === 0,
  });
  return { v, isLatest, sections, one: oneLine(v), status: status(v) };
});

const title = 'hal0 Changelog: Release Notes for the Local AI Server';
const description =
  'Every hal0 release, newest first: new features, fixes and breaking changes for the self-hosted AI inference server, with install and upgrade commands.';

// Mirrors the BreadcrumbList the other inner pages carry. MarketingLayout has
// no head slot, so this sits in the body, which search engines read equally.
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hal0.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Releases', item: 'https://hal0.dev/releases/' },
  ],
};
const breadcrumbsJson = JSON.stringify(breadcrumbs).replace(/</g, '\\u003c');
---

<MarketingLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={breadcrumbsJson} />

  <div class="wrap wide">
    <div class="phead phead-row">
      <div>
        <span class="eyebrow">release history &middot; derived from CHANGELOG.md</span>
        <h1 class="site-h1" style="margin: 10px 0 10px;">Releases</h1>
        <p class="site-body" style="max-width: 62ch;">
          Every hal0 release, newest first, from the product changelog. The latest stable is what
          <code>install.sh</code> installs and what <code>hal0 update</code> moves you to.
        </p>
      </div>
      <div class="rel-channels" aria-label="Update channels">
        <span class="chip ok">stable &middot; default</span>
        <span class="chip">preview &middot; next line</span>
        <span class="chip">nightly &middot; ahead of stable</span>
      </div>
    </div>

    {latest && (
      <article class="rel-latest" data-latest-release>
        <div class="rel-lcard">
          <div class="rel-lcard-h">
            <span class="chip ok">latest stable</span>
            <span class="rel-v">{latest.version}</span>
            <span class="rel-d">{latest.date ? `${latest.date} · ` : ''}tag {tagName(latest.version)}</span>
          </div>
          <div class="rel-lcard-b">
            {cardItems.length > 0 && (
              <>
                <h3>{cardHasHighlights ? 'Highlights' : 'What changed'}</h3>
                <ul class="rel-hl">
                  {cardItems.map((item) => <li set:html={item} />)}
                </ul>
                {cardMore > 0 && (
                  <p class="rel-hl-more"><a href={`#${latest.slug}`}>{cardMore} more in the notes below</a></p>
                )}
              </>
            )}
            {breaking && (
              <div class="rel-brk">
                <b>breaking</b>
                <span set:html={breaking.items[0]} />
                {breaking.more > 0 && (
                  <>
                    {' '}<a href={`#${latest.slug}`}>More under Breaking in the notes below.</a>
                  </>
                )}
              </div>
            )}
          </div>
          <div class="rel-lcard-f">
            <a class="btn" href={releaseTagUrl(latest.version)} rel="noopener">Release on GitHub &#8599;</a>
            <a class="btn ghost" href={`#${latest.slug}`}>Full notes below</a>
          </div>
        </div>

        <div class="rel-side">
          <div class="rel-cmd">
            <div class="rel-cmd-h"><span>fresh box</span><span class="m">Linux x86_64</span></div>
            <div class="rel-cmd-b">
              <span class="p" aria-hidden="true">$</span>
              <code>curl -fsSL https://hal0.dev/install.sh | sudo bash</code>
              <button type="button" class="btn ghost sm" data-copy="curl -fsSL https://hal0.dev/install.sh | sudo bash">copy</button>
            </div>
          </div>
          <div class="rel-cmd">
            <div class="rel-cmd-h"><span>existing box</span><span class="m">cosign-verified swap</span></div>
            <div class="rel-cmd-b">
              <span class="p" aria-hidden="true">$</span>
              <code>sudo hal0 update</code>
              <button type="button" class="btn ghost sm" data-copy="sudo hal0 update">copy</button>
            </div>
          </div>
          <p class="site-sm">
            Switch lines with <code>hal0 update --channel preview</code> or <code>--channel nightly</code>.
            <code>hal0 update --rollback</code> reverts the code in one step; config and state do not roll back.
          </p>
        </div>
      </article>
    )}

    <section class="rel-list" aria-labelledby="recent-h">
      <h2 id="recent-h">Recent releases</h2>
      {entries.map(({ v, isLatest, sections, one, status: st }) => (
        <details class="rel-entry" id={v.slug} open={isLatest}>
          <summary>
            <span class="v">{v.version}</span>
            {v.date && <span class="d">{v.date}</span>}
            {one && <span class="one">{one}</span>}
            <span class={st.cls}>{st.label}</span>
            <span class="car" aria-hidden="true">&#9662;</span>
          </summary>
          <div class="rel-body">
            {sections.map((s) => (
              <>
                <h4 class={s.kind === 'breaking' ? 'rel-sec warn' : 'rel-sec'}>{s.title}</h4>
                <ul>
                  {s.items.map((item) => <li set:html={item} />)}
                  {s.more > 0 && (
                    <li class="rel-more">
                      <a href={entryUrl(v)} rel="noopener">+{s.more} more on GitHub &#8599;</a>
                    </li>
                  )}
                </ul>
              </>
            ))}
            {sections.length === 0 && v.intro && <div class="rel-intro" set:html={v.intro} />}
          </div>
          <div class="rel-foot">
            <a href={entryUrl(v)} rel="noopener">{v.untagged ? 'all releases on GitHub' : `${tagName(v.version)} on GitHub`} &#8599;</a>
            <a href={`#${v.slug}`}>link to this entry</a>
          </div>
        </details>
      ))}
    </section>

    {archive.length > 0 && (
      <section class="rel-list" id="archive" aria-labelledby="archive-h">
        <h2 id="archive-h">Archive</h2>
        <ul class="rel-archive">
          {archive.map((v) => (
            <li>
              <a href={entryUrl(v)} rel="noopener" data-slug={v.slug}>
                <span class="k">{v.version}</span>
                <span>{v.untagged ? 'unreleased' : (v.date ?? '')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</MarketingLayout>

<style is:global>
  /* Reuses the site's .chip / .btn (site-data.css) and the global .phead,
   * .wrap, .eyebrow and .site-* type classes. Everything else is `rel-`
   * prefixed, so it is global (no scoping class on the markup) without
   * colliding with anything. No element min-width above phone width: the layout
   * is fluid and collapses with max-width queries only. */
  .rel-channels {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--jbm);
    font-size: 11px;
    color: var(--fg-3);
  }

  /* ── latest card ── */
  .rel-latest {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 16px;
    margin-top: 10px;
  }
  .rel-lcard {
    border: 1px solid var(--accent-line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    overflow: hidden;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .rel-lcard-h {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 14px 18px;
    background: var(--bg);
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--jbm);
  }
  .rel-v {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .rel-d {
    margin-left: auto;
    font-size: 12px;
    color: var(--fg-4);
  }
  .rel-lcard-b {
    padding: 18px;
    overflow-wrap: anywhere;
  }
  .rel-lcard-b h3 {
    margin: 0 0 10px;
    font-family: var(--jbm);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--accent);
  }
  .rel-hl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rel-hl li {
    position: relative;
    padding-left: 14px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .rel-hl li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }
  .rel-hl strong,
  .rel-brk strong {
    color: var(--fg);
    font-weight: 500;
  }
  .rel-hl code,
  .rel-brk code,
  .rel-body code,
  .rel-intro code,
  .rel-side code,
  .rel-side code {
    font-family: var(--jbm);
    font-size: 0.86em;
    color: var(--fg);
  }
  .rel-hl a,
  .rel-body a,
  .rel-brk a {
    color: var(--accent);
  }
  .rel-brk {
    margin-top: 16px;
    padding: 10px 12px;
    border: 1px solid var(--warn-line);
    border-radius: var(--rad);
    background: var(--warn-soft);
    font-size: 13px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .rel-hl-more {
    margin: 12px 0 0;
    font-family: var(--jbm);
    font-size: 11.5px;
  }
  .rel-hl-more a {
    color: var(--accent);
  }
  .rel-brk b {
    margin-right: 8px;
    font-family: var(--jbm);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--warn);
  }
  .rel-lcard-f {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    background: var(--bg);
    border-top: 1px solid var(--line-soft);
  }

  .rel-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .rel-cmd {
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-sunken);
    overflow: hidden;
  }
  .rel-cmd-h {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 12px;
    background: var(--bg-1);
    border-bottom: 1px solid var(--line);
    font-family: var(--jbm);
    font-size: 11px;
    color: var(--fg-3);
  }
  .rel-cmd-h .m {
    color: var(--fg-4);
  }
  .rel-cmd-b {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    font-family: var(--jbm);
    font-size: 13.5px;
  }
  .rel-cmd-b .p {
    color: var(--accent);
    user-select: none;
  }
  .rel-cmd-b code {
    flex: 1;
    min-width: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .rel-cmd-b .btn {
    flex-shrink: 0;
  }
  .rel-side p {
    color: var(--fg-3);
  }

  /* ── recent entries + archive ── */
  .rel-list {
    margin-top: 48px;
  }
  .rel-list h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 14px;
    font-family: var(--jbm);
    font-size: 13px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--fg-3);
  }
  .rel-list h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .rel-entry {
    margin-bottom: 10px;
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    overflow: hidden;
    scroll-margin-top: 96px;
  }
  .rel-entry summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    list-style: none;
    cursor: pointer;
    font-family: var(--jbm);
    font-size: 13px;
  }
  .rel-entry summary::-webkit-details-marker {
    display: none;
  }
  .rel-entry summary .v {
    min-width: 64px;
    font-weight: 600;
    color: var(--fg);
  }
  .rel-entry summary .d {
    font-size: 11.5px;
    color: var(--fg-4);
  }
  .rel-entry summary .one {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--geist);
    font-size: 13.5px;
    color: var(--fg-2);
  }
  .rel-entry summary .chip {
    margin-left: auto;
  }
  .rel-entry summary .one + .chip {
    margin-left: 0;
  }
  .rel-entry summary .car {
    color: var(--fg-4);
    transition: transform var(--dur-fast) var(--ease);
  }
  .rel-entry[open] summary .car {
    transform: rotate(180deg);
    color: var(--accent);
  }
  .rel-entry[open] summary {
    background: var(--bg);
    border-bottom: 1px solid var(--line-soft);
  }
  .rel-body {
    padding: 14px 16px 16px;
    overflow-wrap: anywhere;
  }
  .rel-sec {
    margin: 14px 0 8px;
    font-family: var(--jbm);
    font-size: 10.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--fg-3);
  }
  .rel-sec:first-child {
    margin-top: 0;
  }
  .rel-sec.warn {
    color: var(--warn);
  }
  .rel-body ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding-left: 18px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .rel-body li.rel-more {
    list-style: none;
    margin-left: -18px;
    font-family: var(--jbm);
    font-size: 11.5px;
  }
  .rel-lcard-b pre,
  .rel-body pre {
    max-width: 100%;
    overflow-x: auto;
  }
  .rel-intro {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--fg-2);
  }
  .rel-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 10px 16px;
    background: var(--bg);
    border-top: 1px solid var(--line-soft);
    font-family: var(--jbm);
    font-size: 11px;
    color: var(--fg-3);
  }
  .rel-foot a {
    color: var(--accent);
  }
  .rel-archive {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rel-archive a {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: var(--rad);
    background: var(--bg-1);
    font-family: var(--jbm);
    font-size: 12px;
    color: var(--fg-2);
    overflow-wrap: anywhere;
  }
  .rel-archive a span:last-child {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--fg-4);
  }
  .rel-archive a:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  @media (max-width: 1000px) {
    .rel-latest {
      grid-template-columns: minmax(0, 1fr);
    }
    .rel-archive {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .rel-archive {
      grid-template-columns: minmax(0, 1fr);
    }
    .rel-entry summary .one {
      display: none;
    }
    .rel-entry summary .chip {
      margin-left: auto;
    }
    .rel-d {
      margin-left: 0;
    }
  }
</style>

<script>
  // Copy buttons on the install and update commands.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'failed';
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 1200);
    });
  });

  // A fragment that names a collapsed entry opens it; one that names an
  // archived version (old /changelog#<version> links) goes to that
  // version's GitHub release, since the archive no longer inlines bodies.
  function followHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView();
      return;
    }
    if (!target) {
      const link = document.querySelector<HTMLAnchorElement>(`#archive a[data-slug="${CSS.escape(id)}"]`);
      if (link) location.replace(link.href);
    }
  }
  followHash();
  window.addEventListener('hashchange', followHash);
</script>
