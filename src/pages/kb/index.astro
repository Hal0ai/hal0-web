---
/**
 * /kb — knowledge base landing.
 *
 * Custom Astro page (MarketingLayout, not a Starlight route) per the scope
 * decision in the team-lead handoff: the six category cards render here;
 * each category's actual article(s) live as Starlight pages under
 * src/content/docs/kb/<category>/*.mdx (see astro.config.mjs's "Knowledge
 * base" sidebar group). This split mirrors /profiles (custom gallery page)
 * + Starlight-rendered detail content.
 *
 * Visual source of truth: docs/design/2026-08-09-community-comps/04 Blog
 * and KB.html, the KbLanding component. One deliberate deviation from the
 * comp: each category there lists four page links (this repo hasn't
 * written four KB pages per category yet). Rather than fabricate three
 * dead or duplicate links per card, each card here links only to the real
 * seed page it has, plus an honest "N more planned" note — see the
 * category CONTENT list below.
 */
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import '../../styles/site-blog-kb.css';
import { Icon } from 'astro-icon/components';

interface KbPage {
  title: string;
  href?: string;
}

interface KbCategory {
  slug: string;
  label: string;
  icon: string;
  blurb: string;
  pages: KbPage[];
}

// The four planned page titles per category are lifted from the comp's KB
// array (04 Blog and KB.html) so the card previews real planned IA, not
// placeholder copy — only the first page per category is written yet
// (`href` set); the rest are honest "planned" list items with no link.
const CATEGORIES: KbCategory[] = [
  {
    slug: 'getting-started',
    label: 'getting started',
    icon: 'lucide:rocket',
    blurb: 'Install, first slot, first request. The path from a bare box to a working /v1/ endpoint.',
    pages: [
      { title: 'Your first slot', href: '/kb/getting-started/your-first-slot/' },
      { title: 'Talking to /v1/chat/completions' },
      { title: 'Picking a loadout' },
      { title: 'Install on a bare Linux box' },
    ],
  },
  {
    slug: 'hardware-notes',
    label: 'hardware notes',
    icon: 'lucide:cpu',
    blurb: 'What each machine can actually hold, and where the wall is.',
    pages: [
      { title: 'Unified memory is not VRAM', href: '/kb/hardware-notes/unified-memory-is-not-vram/' },
      { title: 'Strix Halo: 128 GB, ~96 GB addressable' },
      { title: 'HX 370 on 32 GB' },
      { title: 'Thermals and why decode drifts' },
    ],
  },
  {
    slug: 'runtime-and-backends',
    label: 'runtime & backends',
    icon: 'lucide:layers',
    blurb: 'ROCm, Vulkan, the NPU lane, and how to tell which one you are on.',
    pages: [
      { title: 'ROCm vs vulkan_radv', href: '/kb/runtime-and-backends/rocm-vs-vulkan-radv/' },
      { title: 'Building the rocmfp4 fork' },
      { title: 'XDNA and FastFlowLM today' },
      { title: 'When to pin a container digest' },
    ],
  },
  {
    slug: 'models-and-quants',
    label: 'models & quants',
    icon: 'lucide:boxes',
    blurb: 'Choosing a model that fits, and a quant that does not ruin it.',
    pages: [
      { title: 'Reading a quant name', href: '/kb/models-and-quants/reading-a-quant-name/' },
      { title: 'q4 vs q8 KV cache' },
      { title: 'MoE models on unified memory' },
      { title: 'Draft models for speculative pairs' },
    ],
  },
  {
    slug: 'operating-hal0',
    label: 'operating hal0',
    icon: 'lucide:activity',
    blurb: 'Running the box day to day: slots, eviction, logs, upgrades.',
    pages: [
      { title: 'Reading the memory map', href: '/kb/operating-hal0/reading-the-memory-map/' },
      { title: 'Co-resident slots without eviction' },
      { title: 'Upgrading without downtime' },
      { title: 'What the journal ribbon is telling you' },
    ],
  },
  {
    slug: 'tool-reviews',
    label: 'tool reviews',
    icon: 'lucide:plug-zap',
    blurb: 'Honest notes on the things people plug into hal0.',
    pages: [
      { title: 'OpenWebUI as the chat tab', href: '/kb/tool-reviews/openwebui-as-the-chat-tab/' },
      { title: 'Continue.dev against a coder slot' },
      { title: 'MCP servers worth running' },
    ],
  },
];

const DISTINCTION = [
  {
    surface: 'docs',
    sub: 'reference for the version you run',
    rows: [
      ['shape', 'sidebar + versioned'],
      ['stamp', 'applies to v0.5.x'],
      ['owner', 'maintainers'],
      ['shell', 'starlight'],
    ],
  },
  {
    surface: 'blog',
    sub: 'what changed, and when',
    rows: [
      ['shape', 'reverse-chronological'],
      ['stamp', 'posted 2026-06-19'],
      ['owner', 'named author'],
      ['shell', 'wide reading column'],
    ],
  },
  {
    surface: 'knowledge base',
    sub: 'things that stay true',
    rows: [
      ['shape', 'categories + sidebar'],
      ['stamp', 'reviewed 2026-08-09'],
      ['owner', 'community, editable'],
      ['shell', 'docs-style, undated'],
    ],
  },
];
---

<MarketingLayout
  title="Knowledge base — hal0"
  description="Guides, hardware notes, explainers and honest tool reviews. Undated on purpose — every page carries a last-reviewed stamp instead."
>
  <div class="site">
    <div class="wrap wide phead">
      <div class="phead-row">
        <div>
          <span class="surface-tag">knowledge base &middot; evergreen</span>
          <h1 class="site-h1" style="margin: 12px 0 10px;">things that stay true</h1>
          <p class="site-body" style="max-width: 58ch;">
            Guides, hardware notes, explainers and honest tool reviews. Undated on purpose — every
            page carries a last-reviewed stamp instead, and gets revised rather than superseded.
          </p>
        </div>
      </div>
    </div>

    <div class="wrap wide">
      <div class="kbgrid">
        {CATEGORIES.map((cat) => (
          <div class="kbcat">
            <span class="kbcat-icon"><Icon name={cat.icon} width={16} height={16} /></span>
            <h3>{cat.label}</h3>
            <p>{cat.blurb}</p>
            <ul>
              {cat.pages.slice(0, 4).map((p) =>
                p.href ? (
                  <li><a href={p.href}>{p.title}</a></li>
                ) : (
                  <li><span class="planned">{p.title} &middot; planned</span></li>
                )
              )}
            </ul>
          </div>
        ))}
      </div>

      <div style="margin-top: 48px;">
        <span class="eyebrow">system note</span>
        <h2 class="site-h2" style="margin: 10px 0 6px;">docs, blog and kb are the same site</h2>
        <p class="site-body" style="max-width: 64ch;">
          All three sit under <span class="mono">learn</span> and share the header, footer and
          type. They differ only in the three things a reader needs to judge trust: whether it is
          dated, whether it is versioned against a release, and who owns it.
        </p>
        <div class="diffgrid">
          {DISTINCTION.map((d) => (
            <div class="diff">
              <div class="mono diff-title">{d.surface}</div>
              <div class="site-sm" style="margin-top: 4px;">{d.sub}</div>
              <dl>
                {d.rows.map(([k, v]) => (
                  <>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</MarketingLayout>
