---
/**
 * Landing page, / (hal0.dev), built around named slots.
 *
 * Section copy lives in src/data/landing.ts and the board's state in
 * src/data/slot-board.ts. Every claim follows section 4 of the redesign spec.
 * Copy is version-neutral: the release version comes from the latest tagged
 * entry in the synced changelog, and the benchmark note states the sweep's own
 * date and version because those numbers are not current-release numbers.
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SlotBoard from '../components/landing/SlotBoard.astro';
import ConsoleShotFrame from '../components/landing/ConsoleShot.astro';
import CompareTable from '../components/landing/CompareTable.astro';
import Faq from '../components/landing/Faq.astro';
import ReleaseTeaser from '../components/landing/ReleaseTeaser.astro';
import HermesCard from '../components/HermesCard.astro';
import ForumTopics from '../components/landing/ForumTopics.astro';
import FeaturedProfiles from '../components/landing/FeaturedProfiles.astro';
import LatestWriting from '../components/landing/LatestWriting.astro';
import BenchHighlights from '../components/landing/BenchHighlights.astro';
import rawChangelog from '../data/changelog.md?raw';
import releaseTags from '../data/release-tags.json';
import { ROSTER_DATE } from '../data/model-roster';
import { BOARD_SLOTS } from '../data/slot-board';
import {
  CLIENT_DEFAULTS,
  CONSOLE_SHOTS,
  ENDPOINT_MAP,
  FAQ,
  HARDWARE_TIERS,
  IDEA_COLUMNS,
  LAN_NOTE,
  MEMORY_POINTS,
  PARALLEL_NOTE,
  PRIVACY_FACTS,
  PRIVACY_LEDE,
  ROUTING_NOTE,
  SWAP_STEPS,
  WIRED_NOTE,
  WIRED_TILES,
  codeSpans,
} from '../data/landing';
import { parseChangelog } from '../lib/changelog.js';
import { ORG_ID, SITE_URL } from '../lib/seo.ts';
import '../styles/site-data.css';

const TITLE = 'hal0: Self-Hosted Local AI Server for AMD Strix Halo';
const DESCRIPTION =
  'Run LLMs, speech and images on your own hardware. Open-source, OpenAI-compatible local AI server for AMD Strix Halo (Ryzen AI Max+ 395) and Linux.';
const INSTALL_COMMAND = 'curl -fsSL https://hal0.dev/install.sh | sudo bash';
const DOCS_URL = 'https://forum.hal0.dev/t/hal0-documentation/19';
const GITHUB_URL = 'https://github.com/hal0ai/hal0';

// Latest *tagged* stable, so an untagged heading never reads as shipped.
const version = parseChangelog(rawChangelog, { tags: releaseTags.tags }).latestTagged?.version ?? '';

// The ticker agrees with the board below it. Ten is the product's seeded slot count.
const slotsUp = `${BOARD_SLOTS.length} / 10`;

const shotByFile = (file: string) => {
  const shot = CONSOLE_SHOTS.find((s) => s.file === file);
  if (!shot) throw new Error(`no console shot named ${file}`);
  return shot;
};
const swapShots = ['slot-model-picker-open', 'openwebui-picker'].map(shotByFile);
const memoryShot = shotByFile('memory-bank');
const heroShot = shotByFile('slots-inference');
const offGrid = new Set([...swapShots, memoryShot, heroShot]);
const gridShots = CONSOLE_SHOTS.filter((s) => !offGrid.has(s));

const shotUrl = (file: string) => `${SITE_URL}/screenshots/${file}.png`;

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'hal0',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  description: FAQ[0].a,
  url: `${SITE_URL}/`,
  image: shotUrl(heroShot.file),
  screenshot: CONSOLE_SHOTS.filter((s) => !s.todo).map((s) => shotUrl(s.file)),
  featureList: [
    'Named slots for chat, embeddings, rerank, speech and images',
    'One OpenAI-compatible /v1 API, one slot per medium',
    'Swap the model behind a slot without reconfiguring clients',
    'Reusable inference profiles',
    'Open WebUI and Hermes configured on install',
    'One Hindsight memory shared by your agents',
    'MCP servers for admin and memory, with human approval for gated calls',
    'Cosign-verified updates with one-flag rollback',
  ],
  softwareRequirements: 'Linux x86_64, Python 3.12+, systemd, podman',
  releaseNotes: `${SITE_URL}/releases/`,
  installUrl: `${SITE_URL}/install.sh`,
  downloadUrl: `${SITE_URL}/install.sh`,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  softwareVersion: version,
  codeRepository: GITHUB_URL,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'hal0ai', url: 'https://github.com/hal0ai' },
  publisher: { '@id': ORG_ID },
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<MarketingLayout title={TITLE} description={DESCRIPTION} jsonLd={[softwareApplication, faqPage]}>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="shell-wide hero-grid">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="blip"></span> {version ? `latest stable ${version} · ` : ''}Apache-2.0
        </div>
        <h1 class="hero-h1">
          <span class="h1-line">Own Your</span>
          <span class="h1-line accent">Inference</span>
        </h1>
        <p class="hero-tagline">All local. All yours.</p>
        <p class="lede">
          hal0 runs several specialised models side by side on your own hardware, each in a <strong>named slot</strong>.
          Your apps and agents talk to the slot, so you swap the model behind it from a dropdown and
          your apps keep the name they already use.
        </p>
        <div class="cta-row">
          <a href={DOCS_URL} class="btn lg">Read the docs</a>
          <a href={GITHUB_URL} rel="noopener" class="btn ghost lg">★ Star on GitHub</a>
          <span class="cta-meta">Linux + systemd · one-line install</span>
        </div>
        <div class="ticker">
          <span><span class="mdot"></span> hal0-api <b>:8080</b> ready</span>
          <span class="sep">·</span>
          <span>slots <b>{slotsUp}</b> up</span>
          <span class="sep">·</span>
          <span>probe <b>strix-halo</b></span>
        </div>
      </div>

      <SlotBoard />
    </div>

    <div class="shell-wide hero-install">
      <div class="install install-hero" id="install">
        <div class="install-head">
          <div class="install-dots"><i></i><i></i><i></i></div>
          <div class="install-title">install.sh</div>
          <div class="install-meta">Linux x86_64 · Python ≥3.12</div>
        </div>
        <div class="install-body">
          <span class="prompt">$</span>
          <span class="cmd">{INSTALL_COMMAND}</span>
          <button type="button" class="btn ghost sm" data-copy={INSTALL_COMMAND}>copy</button>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE IDEA -->
  <section class="section rule" id="idea">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ the idea</div>
          <h2 class="sec-title">One giant model is the wrong shape for a home box.</h2>
        </div>
        <p class="sec-sub">
          A 128 GB box has room for several specialists. hal0 gives each job its own slot with its
          own model and tune, behind one OpenAI-compatible API. Clients name the slot; hal0 keeps
          the model, the flags and the placement straight.
        </p>
      </div>

      <div class="idea-cols">
        {IDEA_COLUMNS.map((col) => (
          <div class="idea">
            <div class="k">{col.key}</div>
            <h3>{col.title}</h3>
            <p>{col.body}</p>
            <div class="ex">{col.examples}</div>
          </div>
        ))}
      </div>

      <p class="routing-note">{ROUTING_NOTE}</p>
      <div class="endpoint-map" role="group" aria-label="Which endpoint lands on which slot">
        {ENDPOINT_MAP.map((ep) => (
          <div class="ep">
            <span class="path">{ep.path}</span>
            <span class="slot"><span class="mdot"></span>{ep.slot}</span>
          </div>
        ))}
      </div>
      <p class="par-note">{PARALLEL_NOTE}</p>
    </div>
  </section>

  <!-- 3. SWAP -->
  <section class="section" id="swap">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ slots as models</div>
          <h2 class="sec-title">Swap the model, keep the name.</h2>
        </div>
        <p class="sec-sub">
          Open WebUI, Hermes, pi and the memory engine are pointed at slot names, not model files.
          When a better model lands, pick it from the slot's dropdown. The slot reloads and every
          chat client keeps the config it already has.
        </p>
      </div>

      <div class="swap-grid">
        <div>
          <ul class="defaults" aria-label="What each client points at">
            {CLIENT_DEFAULTS.map((row) => (
              <li>
                <span class="c">{row.client}</span>
                <span class="d" set:html={codeSpans(row.detail)} />
              </li>
            ))}
          </ul>
          <div class="how">
            {SWAP_STEPS.map((step) => <div set:html={codeSpans(step)} />)}
          </div>
        </div>
        <div class="shots-2">
          {swapShots.map((shot) => <ConsoleShotFrame shot={shot} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PRIVACY -->
  <section class="section rule" id="privacy">
    <div class="shell-wide priv">
      <div>
        <div class="sec-tag">/ privacy</div>
        <h2 class="sec-title priv-title">Your prompts stay on your box.</h2>
        <p class="priv-lede">
          {PRIVACY_LEDE.before}<em>{PRIVACY_LEDE.aside}</em>{PRIVACY_LEDE.after}
        </p>
      </div>
      <div class="facts">
        {PRIVACY_FACTS.map((fact) => (
          <div class="fact">
            <h3><span class="mdot"></span>{fact.title}</h3>
            <p>{fact.body}</p>
          </div>
        ))}
        <div class="lan-note"><b>on your LAN</b> {LAN_NOTE}</div>
      </div>
    </div>
  </section>

  <!-- 5. WIRED -->
  <section class="section" id="wired">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ wired on first boot</div>
          <h2 class="sec-title">The apps come configured.</h2>
        </div>
        <p class="sec-sub">
          One install brings up the API, a chat UI, an agent and memory, already pointed at each other, and pulls a small model for the steward. You pick the models for the other slots from the console.
          Add a slot and it appears in Open WebUI and Hermes within seconds; pi sees it after a restart.
        </p>
      </div>

      <div class="wired-grid">
        <div>
          <div class="tiles">
            {WIRED_TILES.map((tile) => (
              <div class="tile card-hover">
                <div class="tag">{tile.tag}</div>
                <h3>{tile.title}</h3>
                <p set:html={codeSpans(tile.body)} />
              </div>
            ))}
          </div>
          <p class="wired-note" set:html={codeSpans(WIRED_NOTE)} />
        </div>
        <div class="hermes-card-wrap">
          <HermesCard />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. MEMORY -->
  <section class="section rule" id="memory">
    <div class="shell-wide mem-grid">
      <div>
        <div class="sec-tag">/ memory</div>
        <h2 class="sec-title">One memory your agents share.</h2>
        <p class="sec-sub mem-sub">
          A Hindsight engine runs on loopback with local embeddings. Hermes and pi are wired to it
          automatically, with shared and private banks. Anything that speaks MCP can connect to it.
        </p>
        <ul class="mem-list">
          {MEMORY_POINTS.map((point) => <li><b>{point.term}</b> {point.text}</li>)}
        </ul>
        <div class="cta-row mem-cta">
          <a class="btn" href="https://forum.hal0.dev/t/agents-hal0-docs/23">Agents &amp; memory docs</a>
        </div>
      </div>
      <ConsoleShotFrame shot={memoryShot} />
    </div>
  </section>

  <!-- 7. CONSOLE -->
  <section class="section" id="console">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ the console</div>
          <h2 class="sec-title">Every slot, model and agent in one console.</h2>
        </div>
        <p class="sec-sub">
          Slots with their pickers and live metrics, a dock with the GPU's state and a merged event
          feed, profiles, stacks, image generation, memory, MCP, logs and settings. Dark by default,
          works on a phone.
        </p>
      </div>

      <ConsoleShotFrame shot={heroShot} hero />
      <div class="console-grid">
        {gridShots.map((shot) => <ConsoleShotFrame shot={shot} />)}
      </div>
    </div>
  </section>

  <!-- 8. HARDWARE -->
  <section class="section rule" id="hardware">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ hardware</div>
          <h2 class="sec-title">Strix Halo first. Linux everywhere.</h2>
        </div>
        <p class="sec-sub">
          Built and benchmarked on the Ryzen AI Max+ 395 with its 128 GB unified pool, XDNA NPU and
          RDNA 3.5 iGPU. The same install runs on other Linux boxes, with less headroom.
        </p>
      </div>

      <div class="tier-row">
        {HARDWARE_TIERS.map((hw) => (
          <div class:list={['tier', { ref: hw.reference }]}>
            <div class="t">{hw.tier}</div>
            <div class="n">{hw.name}</div>
            <div class="s">{hw.note}</div>
          </div>
        ))}
      </div>
      <p class="hw-note">Linux x86_64 with systemd and podman. No macOS, no Windows, no Docker.</p>
    </div>
  </section>

  <!-- 9. COMPARE -->
  <section class="section" id="compare">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ alongside the alternatives</div>
          <h2 class="sec-title">Where hal0 sits.</h2>
        </div>
        <p class="sec-sub">
          hal0 is the orchestration around llama.cpp, FastFlowLM and ComfyUI, not a new engine, so
          the table compares the layer above the engine. Several of these tools can be configured
          otherwise; the cells describe their defaults.
        </p>
      </div>
      <CompareTable />
    </div>
  </section>

  <!-- 10 + 11. BENCHMARKS + RELEASES -->
  <div class="two-up-wrap">
    <div class="shell-wide two-up">
      <section id="benchmarks">
        <BenchHighlights />
        <p class="bench-note">
          Sweep from {ROSTER_DATE} on hal0 0.5 with the earlier runner.
        </p>
      </section>
      <section id="releases" class="rel-col">
        <!-- Old links to /#whats-new and /#roadmap land on the release that replaced them. -->
        <span id="whats-new"></span>
        <span id="roadmap"></span>
        <ReleaseTeaser />
      </section>
    </div>
  </div>

  <!-- 12. FAQ -->
  <section class="section" id="faq">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ questions</div>
          <h2 class="sec-title">Straight answers.</h2>
        </div>
        <p class="sec-sub">The things people ask before they run the installer.</p>
      </div>
      <Faq />
    </div>
  </section>

  <!-- 13. COMMUNITY: social proof for someone already sold, so it sits low. The
       forum block renders nothing at all when its fetch fails at build time. -->
  <div class="shell-wide community">
    <ForumTopics />
    <FeaturedProfiles />
    <LatestWriting />
  </div>

  <!-- 14. GET HAL0 -->
  <section class="cta" id="get">
    <div class="shell-wide">
      <div class="sec-tag">/ get hal0</div>
      <h2>Put the whole stack<br />on <span class="accent">your own box.</span></h2>
      <p class="cta-sub">
        One command on a fresh Linux box brings up the API, the chat UI, the agent and memory. Then pick models for your slots from the console.
      </p>
      <div class="install" id="install-cta">
        <div class="install-head">
          <div class="install-dots"><i></i><i></i><i></i></div>
          <div class="install-title">install.sh</div>
          <div class="install-meta">Linux x86_64 · Python ≥3.12</div>
        </div>
        <div class="install-body">
          <span class="prompt">$</span>
          <span class="cmd">{INSTALL_COMMAND}</span>
          <button type="button" class="btn ghost sm" data-copy={INSTALL_COMMAND}>copy</button>
        </div>
      </div>
      <div class="cta-row cta-row-centered">
        <a href={DOCS_URL} class="btn lg">Read the docs</a>
        <a href={GITHUB_URL} rel="noopener" class="btn ghost lg">View on GitHub ↗</a>
      </div>
      <div class="cta-chips">
        <span class="chip ok">Apache-2.0</span>
        <span class="chip">Linux + systemd</span>
        <span class="chip">no telemetry</span>
        <span class="chip">signed releases</span>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      document.querySelectorAll('button[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-copy') || '';
          try { await navigator.clipboard.writeText(cmd); } catch {}
          const original = btn.textContent;
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = original; }, 1400);
        });
      });
    })();
  </script>
</MarketingLayout>

<style is:global>
  /* Landing-only styles. Shared primitives (.btn, .chip, .card-hover) come from
   * site-data.css, and components carry their own scoped styles. */
  .accent { color: var(--hal0-accent); }

  /* A plain amber marker, for lists. Status dots live on the slot board. */
  .mdot {
    display: inline-block;
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hal0-accent);
  }

  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .cta-meta { margin-left: 6px; font-family: var(--hal0-font-mono); font-size: 11px; color: var(--hal0-fg-dim); }

  /* Sections */
  .section { padding-block: 96px; }
  .section[id], .cta[id], .two-up section[id] { scroll-margin-top: 72px; }
  .section.rule { border-top: 1px solid var(--hal0-border); }
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 64px;
    align-items: end;
    margin-bottom: 48px;
  }
  .sec-tag {
    margin-bottom: 14px;
    font-family: var(--hal0-font-mono);
    font-size: 11px;
    letter-spacing: var(--hal0-ls-label);
    text-transform: uppercase;
    color: var(--hal0-accent);
  }
  .sec-title {
    margin: 0;
    font-family: var(--hal0-font-mono);
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: var(--hal0-ls-display);
    text-wrap: balance;
  }
  .sec-sub {
    max-width: 560px;
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--hal0-fg-muted);
    text-wrap: pretty;
  }
  .sec-sub code { font-size: 14px; color: var(--hal0-fg); }

  /* Install box */
  .install {
    overflow: hidden;
    border: 1px solid var(--hal0-border);
    border-radius: var(--hal0-rad-lg);
    background: var(--hal0-bg-elevated);
  }
  .install-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--hal0-border-soft);
    background: var(--hal0-bg);
    font-family: var(--hal0-font-mono);
    font-size: 11px;
    color: var(--hal0-fg-dim);
  }
  .install-dots { display: flex; gap: 6px; }
  .install-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--hal0-border-strong); }
  .install-title { flex: 1; text-align: center; }
  .install-body {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 18px 18px 22px;
    font-family: var(--hal0-font-mono);
    font-size: 15px;
    color: var(--hal0-fg);
  }
  .prompt { color: var(--hal0-accent); user-select: none; }
  .cmd { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }

  /* 1. Hero */
  .hero { padding-block: 72px 56px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    padding: 5px 10px;
    border: 1px solid var(--hal0-accent-line);
    border-radius: var(--hal0-rad-pill);
    background: var(--hal0-accent-soft);
    font-family: var(--hal0-font-mono);
    font-size: 11px;
    letter-spacing: var(--hal0-ls-label);
    text-transform: uppercase;
    color: var(--hal0-accent);
  }
  .blip {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hal0-accent);
    animation: pulse 1.6s ease-in-out infinite;
  }
  /* Two fixed lines, sized off the column so "Inference" never wraps. */
  .hero-copy { container-type: inline-size; }
  .hero-h1 {
    margin: 0 0 16px;
    font-family: var(--hal0-font-mono);
    font-size: clamp(36px, 15cqi, 88px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-feature-settings: 'zero' 1;
  }
  .h1-line { display: block; white-space: nowrap; }
  .hero-tagline {
    margin: 0 0 18px;
    font-family: var(--hal0-font-mono);
    font-size: clamp(13px, 1.1vw, 15px);
    letter-spacing: 0.02em;
    color: var(--hal0-accent);
  }
  .lede {
    max-width: 580px;
    margin: 0 0 26px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--hal0-fg-muted);
    text-wrap: pretty;
  }
  .lede strong { font-weight: 500; color: var(--hal0-fg); }
  .ticker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid var(--hal0-border);
    font-family: var(--hal0-font-mono);
    font-size: 11px;
    color: var(--hal0-fg-dim);
  }
  .ticker b { font-weight: 500; color: var(--hal0-fg); }
  .ticker .sep { color: var(--hal0-border-strong); }
  .ticker .mdot { vertical-align: 1px; }
  .hero-install { display: flex; justify-content: center; margin-top: 48px; }
  .install-hero {
    width: 100%;
    max-width: 920px;
    border-color: color-mix(in srgb, var(--hal0-accent) 38%, var(--hal0-border));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--hal0-accent) 12%, transparent),
      0 18px 60px -24px color-mix(in srgb, var(--hal0-accent) 45%, transparent);
  }
