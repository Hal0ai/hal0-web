---
/**
 * Landing page — / (hal0.dev).
 *
 * hal0 v2 design — sodium amber on graphite. Strix Halo first, the rest
 * of the matrix honest. Claims and numbers trace to the hal0 codebase
 * (src/hal0) — verify there, not from a copy doc. Copy is version-neutral:
 * the only version on the page is derived from the latest tagged release.
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LiveArtifact from '../components/landing/LiveArtifact.astro';
import HermesCard from '../components/HermesCard.astro';
import ForumTopics from '../components/landing/ForumTopics.astro';
import FeaturedProfiles from '../components/landing/FeaturedProfiles.astro';
import LatestWriting from '../components/landing/LatestWriting.astro';
import BenchHighlights from '../components/landing/BenchHighlights.astro';
import rawChangelog from '../data/changelog.md?raw';
import releaseTags from '../data/release-tags.json';
import { parseChangelog } from '../lib/changelog.js';
import '../styles/site-data.css';

const canonicalUrl = 'https://hal0.dev/';
// Latest *tagged* stable from the synced changelog, so an untagged heading
// never reads as shipped. Never hardcoded.
const version = parseChangelog(rawChangelog, { tags: releaseTags.tags }).latestTagged?.version ?? '';

// Full copy feeds the structured-data schema (no length limit); a tight ~155-char
// version is the page meta + OG description (search snippets cap ~160).
const description =
  'hal0 is an open-source homelab AI inference platform built for the AMD Ryzen AI Max+ 395 ("Strix Halo") with 128 GB of unified memory and an XDNA NPU, and it runs on other Linux boxes with a GPU, NPU or plain CPU. One OpenAI-compatible /v1/* API serves chat, embeddings, rerank, speech, transcription and images from pinned, hardware-gated runner images: the Standard runner (llama.cpp on ROCm or Vulkan), CPU, FastFlowLM on the NPU, Kokoro, Moonshine and ComfyUI. Every tune lives in a named profile you can fork, export and import. Open WebUI, ComfyUI, the Hermes agent and Hindsight memory come up wired to each other, with an MCP server and signed self-update. One command installs all of it.';
const metaDescription =
  'Open-source homelab AI for AMD Strix Halo: one OpenAI-compatible /v1/* API, pinned runner images, named profiles, Hermes agent, Hindsight memory, Open WebUI.';

const softwareApplicationLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'hal0',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  description,
  url: canonicalUrl,
  downloadUrl: 'https://hal0.dev/install.sh',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  softwareVersion: version,
  codeRepository: 'https://github.com/hal0ai/hal0',
  keywords:
    'Strix Halo, Ryzen AI Max+ 395, AMD XDNA NPU, 128 GB unified memory, homelab AI, self-hosted AI, OpenAI-compatible API, local LLM, Proxmox LXC, llama.cpp, runner images, Standard runner, ROCm, Vulkan, FastFlowLM, inference profiles, Open WebUI, ComfyUI, local image generation, Kokoro, Moonshine, Qwen3 TTS, Hermes agent, Hindsight memory, agent memory, MCP server, signed updates',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'hal0ai', url: 'https://github.com/hal0ai' },
};

const features = [
  {
    tag: 'agents',
    title: 'Agents that live on the box',
    body: 'Hermes installs and bootstraps itself on first run, prewired to the local /v1 API, and your own model screens its risky shell commands before you are asked. hal0-brain is the second: a resident operator you ask about the box in plain language, from the dashboard or a headless terminal.',
  },
  {
    tag: 'profiles',
    title: 'Model = facts, profile = tune, slot = placement',
    body: 'A model records facts about its file. A profile holds every tune: flags, context, thinking, vision, MTP and the runtime. A slot holds placement. One model runs several ways through several profiles, and the launch command is shown layer by layer.',
  },
  {
    tag: 'memory',
    title: 'Memory that never leaves the box',
    body: 'The Hindsight engine runs embedded and loopback-only, embeddings included. A write lands or is refused up front with a reason, never dropped quietly, and you set the extraction limits in Settings. Destructive operations write an attributable audit row.',
  },
  {
    tag: 'voice',
    title: 'Speech in and out, device-keyed',
    body: 'One stt slot and one tts slot, each resolving by device. Moonshine on the CPU or FastFlowLM on the XDNA NPU listens; Kokoro on the CPU or the optional Qwen3 TTS runner on the GPU speaks. Switch the engine, not the plumbing.',
  },
  {
    tag: 'images',
    title: 'Image generation on the same API',
    body: 'POST /v1/images/generations runs SDXL, SD 1.5 or Flux through a ComfyUI engine. Generating flips the iGPU into exclusive image mode and back, so chat and images share one accelerator without fighting over it.',
  },
  {
    tag: 'prewired',
    title: 'Wired up before you log in',
    body: 'One command brings up the API, a coherent set of slots, ComfyUI, the agent and Open WebUI on :3001. Open WebUI arrives wired for chat, voice, documents (RAG on hal0 embeddings) and images through ComfyUI.',
  },
];

// Runner catalogue: titles and blurbs from src/hal0/runners/__init__.py,
// pinned upstream builds from manifest.json `runners` (never image tags).
const runners = [
  { prov: 'Standard', ver: 'llama.cpp b11596', blurb: 'llama.cpp for AMD GPUs, on ROCm or Vulkan. The default on AMD; runs plain GGUF models.', hw: 'ROCm (default) · Vulkan', eps: '/v1/chat · /v1/embeddings · /v1/rerank' },
  { prov: 'CPU', ver: 'llama.cpp b11596', blurb: 'llama.cpp on the processor, no GPU needed. A slow fallback for boxes without a supported GPU.', hw: 'CPU', eps: '/v1/chat · /v1/embeddings' },
  { prov: 'NPU (FastFlowLM)', ver: 'FastFlowLM 0.9.44', blurb: 'Runs supported models on the AMD XDNA 2 NPU, leaving the GPU free.', hw: 'AMD XDNA NPU (opt-in)', eps: '/v1/chat · /v1/embeddings · /v1/audio/transcriptions' },
  { prov: 'Kokoro speech', ver: 'pinned 0.4.9', blurb: 'Text-to-speech on the CPU. Works on any box, no GPU needed.', hw: 'CPU', eps: '/v1/audio/speech' },
  { prov: 'Moonshine transcription', ver: 'pinned 20251121', blurb: 'Speech-to-text on the CPU. Works on any box, no GPU or NPU needed.', hw: 'CPU', eps: '/v1/audio/transcriptions' },
  { prov: 'ComfyUI', ver: 'pinned 0.28.0', blurb: 'Image and video generation on the GPU (ROCm).', hw: 'ROCm', eps: '/v1/images/generations' },
  { prov: 'Qwen3 TTS', ver: 'optional · pinned 0.1.1', blurb: 'Higher-quality multilingual text-to-speech on the GPU (ROCm). Opt-in; a large download (about 10 GB).', hw: 'ROCm', eps: '/v1/audio/speech' },
  { prov: 'NVIDIA CUDA', ver: 'optional · llama.cpp b11580', blurb: 'llama.cpp for NVIDIA GPUs. Pick it on a box with an NVIDIA card.', hw: 'CUDA (experimental)', eps: '/v1/chat · /v1/embeddings' },
];

const tiers = [
  {
    cls: 'first-class',
    tag: 'reference deployment',
    name: 'Ryzen AI Max+ 395',
    spec: '"Strix Halo" iGPU + XDNA NPU + 128 GB LPDDR5X-8000 unified memory',
    stats: [
      { v: '128', u: 'GB', l: 'unified · BIOS-tunable to ~96 GB GPU' },
      { v: '96', u: 'K', l: 'default context, Qwen3.8 27B' },
    ],
    note: 'All published perf numbers come from this box. Q4 70B fits with room to spare; Q4 MoE 100B+ with a 17–22B active path becomes feasible.',
  },
  {
    cls: 'first-class',
    tag: 'first-class',
    name: 'Ryzen AI Max 385 / 390',
    spec: 'Strix Halo with 64 GB unified',
    stats: [
      { v: '64', u: 'GB', l: 'unified memory' },
      { v: '~70', u: 'B', l: 'Q4 ceiling, shorter context' },
    ],
    note: 'Same install path. Every small + mid tier fits; 70B Q4 works with tighter context windows.',
  },
  {
    cls: 'supported',
    tag: 'experimental',
    name: 'NVIDIA RTX 30 / 40 / 50',
    spec: '10–32 GB dedicated VRAM · CUDA runner, optional tier',
    stats: [
      { v: '32', u: 'GB', l: 'RTX 5090 VRAM ceiling' },
      { v: '~30', u: 'B', l: 'Q4 comfortable' },
    ],
    note: 'The CUDA runner is opt-in and used when the NVIDIA container toolkit is present. It is not in the release gate yet, so treat it as experimental. Same slot lifecycle, dedicated VRAM instead of UMA.',
  },
  {
    cls: 'supported',
    tag: 'supported',
    name: 'AMD Radeon RX 7000',
    spec: '16–24 GB discrete · Standard runner on ROCm or Vulkan',
    stats: [
      { v: '24', u: 'GB', l: '7900 XTX VRAM' },
      { v: 'ROCm', u: '', l: '· Vulkan' },
    ],
    note: 'Discrete AMD path on the same Standard runner and hal0-slot@<name> lifecycle as Strix Halo, on either lane.',
  },
  {
    cls: 'supported',
    tag: 'fallback',
    name: 'CPU-only x86_64',
    spec: 'CPU runner · llama.cpp on the processor',
    stats: [
      { v: '0.5–4', u: 'B', l: 'practical model size' },
      { v: '0', u: 'GPU', l: 'needed for Kokoro + Moonshine' },
    ],
    note: 'A real CPU-only llama.cpp runner ships, so a box with no supported GPU installs and serves. Fine for small models, speech and smoke tests, not the headline experience.',
  },
  {
    cls: 'supported',
    tag: 'supported',
    name: 'Proxmox LXC',
    spec: 'privileged Ubuntu LXC · iGPU + XDNA passthrough',
    stats: [
      { v: '1', u: 'script', l: 'quick-start builds the LXC' },
      { v: 'segmented', u: '', l: 'host-pressure overlay' },
    ],
    note: 'The quick-start script builds a privileged LXC with GPU and NPU passthrough already wired. Add a read-only PVEAuditor token in Settings and the memory bar shows other tenants and ZFS ARC pressure.',
  },
];

const compareCols = ['hal0', 'ollama', 'LM Studio', 'OpenAI cloud'];
const compareRows = [
  { lbl: 'OpenAI-compatible /v1/*', cells: ['chat · embed · rerank · STT · TTS · img', 'chat · embed', 'chat · embed', 'chat · embed · STT · TTS · img'] },
  { lbl: 'Concurrent slots', cells: ['as memory fits', 'one at a time', 'one at a time', 'fully concurrent'] },
  { lbl: 'Slot lifecycle state machine', cells: ['typed, atomic, SSE-streamed', 'no', 'no', '—'] },
  { lbl: 'UMA-aware hardware probe', cells: ['Strix Halo · NPU · platform-aware', 'CPU / GPU only', 'CPU / GPU only', '—'] },
  { lbl: 'XDNA NPU support', cells: ['first-class via FLM', 'no', 'no', '—'] },
  { lbl: 'Tune portability', cells: ['named profiles you fork, export, import', 'per-model flags', 'GUI presets', 'n/a'] },
  { lbl: 'Dispatcher with upstreams', cells: ['OpenRouter · Anthropic · OpenAI · custom', 'no', 'no', '—'] },
  { lbl: 'Signed updates + component convergence', cells: ['signed, converges every component, one-flag rollback', 'no', 'auto-update', '—'] },
  { lbl: 'Headless / Linux-first', cells: ['systemd-required, headless', 'cross-platform', 'GUI required', 'cloud'] },
  { lbl: 'Your data, your hardware', cells: ['yes', 'yes', 'yes', 'no'] },
  { lbl: 'Cost per million tokens', cells: ['$0 + electricity', '$0 + electricity', '$0 + electricity', '$0.50 – $60'] },
];

const whatsNew = [
  { tag: 'runners', title: 'One name per runner', body: 'The AMD llama.cpp runner is now Standard, built from upstream llama.cpp for ROCm and Vulkan. One pin table drives every runner image, each tag is immutable and hardware-gated, and the catalogue syncs itself.' },
  { tag: 'profiles', title: 'Tune once, run many ways', body: 'Context, thinking, vision, MTP, flags and runtime moved off the model and the slot onto the profile. Existing installs convert automatically, with a backup.' },
  { tag: 'models', title: 'A bigger default model', body: 'A box with a 32 GB or larger memory pool now seeds Qwen3.8 27B with vision at 96K context. Smaller boxes keep Qwen3.5 9B or Qwen3 4B.' },
  { tag: 'memory', title: 'Memory that lands or refuses', body: 'Writes that used to vanish on a slow box now land, or are refused up front with a reason. Extraction limits live under Settings ▸ Memory.' },
  { tag: 'open webui', title: 'Open WebUI, fully wired', body: 'Document uploads go through RAG on hal0 embeddings and the image button generates through ComfyUI as soon as the matching slots are bound. It keeps working with auth on.' },
  { tag: 'updates', title: 'Updates that finish the job', body: 'hal0 update converges Open WebUI, runner images, Hermes and Hindsight, restarts slots whose runner image changed, and rolls back with one flag.' },
];

const shotSet = (name: string) => `/screenshots/${name}.png 1x, /screenshots/${name}@2x.png 2x`;

---

<MarketingLayout
  title="hal0 — Strix Halo native AI inference, image gen & agents for homelabs."
  description={metaDescription}
>
  <!-- HERO -->
  <header class="hero">
    <div class="shell-wide hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="blip"></span> {version ? `latest stable ${version} · ` : ''}Apache-2.0
        </div>
        <h1 class="h1 hero-h1">
          <span class="h1-line">Own Your</span>
          <span class="h1-line"><span class="accent">Inference</span></span>
        </h1>
        <p class="hero-tagline">All local. All yours.</p>
        <p class="lede">
          Chat, speech, images, embeddings — every modality, served from one
          OpenAI-compatible API on your <strong>Strix Halo</strong> box or any Linux machine.
        </p>

        <div class="cta-row">
          <a href="https://forum.hal0.dev/t/hal0-documentation/19" class="btn">Read the docs →</a>
          <a href="https://github.com/hal0ai/hal0" rel="noopener" class="btn ghost">★ Star on GitHub</a>
          <span class="cta-meta">Apache-2.0 · Linux + systemd</span>
        </div>

        <div class="ticker">
          <span class="tk"><span class="dot"></span> hal0-api</span>
          <span class="tk"><b>:8080</b> ready</span>
          <span class="tk-sep">·</span>
          <span class="tk">all slots <b>up</b></span>
          <span class="tk-sep">·</span>
          <span class="tk">GTT <b>9.2 / 96 GB</b></span>
          <span class="tk-sep">·</span>
          <span class="tk">probe <b>strix-halo</b></span>
        </div>
      </div>

      <LiveArtifact />
    </div>

    <div class="shell-wide hero-install">
      <div class="install install-hero" id="install">
        <div class="install-head">
          <div class="install-dots"><i></i><i></i><i></i></div>
          <div class="install-title">install.sh</div>
          <div class="install-meta">Linux x86_64 · Python ≥3.12</div>
        </div>
        <div class="install-body">
          <span class="prompt">$</span>
          <span class="cmd">curl -fsSL https://hal0.dev/install.sh | sudo bash</span>
          <span class="caret"></span>
          <button class="copy-btn" data-copy="curl -fsSL https://hal0.dev/install.sh | sudo bash">copy</button>
        </div>
      </div>
    </div>
  </header>

  <!-- STACK -->
  <section class="section section-tight" id="stack">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ runner images</div>
          <h2 class="sec-title">Six runners,<br />one <span class="accent">/v1/*</span> surface.</h2>
        </div>
        <p class="sec-sub">
          Chat, embeddings, rerank, speech both ways and image generation, each
          served by a runner image on the accelerator that suits it, behind one
          OpenAI-compatible API. Every tag is immutable and hardware-gated. Six
          runners ship by default; Qwen3 TTS and CUDA are opt-in.
        </p>
      </div>

      <div class="matrix">
        <div class="matrix-row head">
          <div>Runner</div>
          <div>What it runs</div>
          <div>Hardware</div>
          <div>Endpoints</div>
        </div>
        {runners.map((r) => (
          <div class="matrix-row">
            <div class="prov">
              <span class="prov-name">{r.prov}</span>
              <span class="prov-ver">{r.ver}</span>
            </div>
            <div class="uses">{r.blurb}</div>
            <div class="hw">{r.hw}</div>
            <div class="ep">
              {r.eps.split(' · ').map((e) => <span class="ep-chip">{e}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT'S IN THE BOX -->
  <section class="section" id="what">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ what's in the box</div>
          <h2 class="sec-title">More than models.<br />A whole <span class="accent">AI stack</span>.</h2>
        </div>
        <p class="sec-sub">
          Agents, profiles, memory, voice and image generation ship in the box
          and come up wired to each other. Not a model runner you then spend a
          weekend assembling a platform around.
        </p>
      </div>

      <div class="feat-grid">
        {features.map((f) => (
          <article class="feat-card">
            <div class="feat-tag">{f.tag}</div>
            <div class="feat-title">{f.title}</div>
            <p class="feat-body">{f.body}</p>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- USE CASES — outcome-led. Used to sit directly under the hero, where the
       hero supplied its spacing and context; now that it follows the feature
       grid it carries its own header and section rhythm. -->
  <section class="section section-tight usecases" id="use-cases">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ what people run it for</div>
          <h2 class="sec-title">One box,<br />three <span class="accent">day jobs</span>.</h2>
        </div>
        <p class="sec-sub">
          The same install serves all three at once — the slots share the
          accelerator instead of taking turns with it.
        </p>
      </div>
      <div class="uc-grid">
      <article class="uc-card">
        <div class="uc-eye">/ local coding stack</div>
        <h3 class="uc-title">Point your editor at your own box</h3>
        <p class="uc-body">
          Aim any OpenAI-compatible client at <code class="mono accent-mono">:8080/v1</code> —
          chat, completions, and a dedicated coder slot. Your code never leaves the LAN,
          and there's no per-token bill.
        </p>
      </article>
      <article class="uc-card">
        <div class="uc-eye">/ private knowledge &amp; RAG</div>
        <h3 class="uc-title">Retrieval grounded on your data</h3>
        <p class="uc-body">
          Embeddings, reranking, Open WebUI document uploads that go through RAG on
          hal0 embeddings, and a bundled agent with memory and MCP tools. Retrieval
          runs on your hardware, not someone else's server.
        </p>
      </article>
      <article class="uc-card">
        <div class="uc-eye">/ voice &amp; image lab</div>
        <h3 class="uc-title">Speech and images, one control plane</h3>
        <p class="uc-body">
          Transcription, text-to-speech and local image generation behind the same API.
          STT runs on the XDNA NPU or the CPU, TTS on the CPU or the GPU, and ComfyUI on
          the iGPU, switched cleanly so they share the box.
        </p>
      </article>
      </div>
    </div>
  </section>

  <!-- Bench highlights — first-party roster sweep. ROSTER is a committed
       snapshot, not a live fetch, so there is no unreachable case; only an
       aging ROSTER_DATE, which the section surfaces itself. -->
  <div class="shell-wide">
    <BenchHighlights />
  </div>

  <!-- HARDWARE -->
  <section class="section" id="hardware">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ hardware</div>
          <h2 class="sec-title">Strix Halo native.<br />Not Strix-Halo-<span class="accent">only</span>.</h2>
        </div>
        <p class="sec-sub">
          The probe is UMA-aware on Strix Halo and falls back to portable
          parsers on every other host. The dashboard only labels memory
          "unified" when it actually is. Linux + systemd is the only hard
          requirement.
        </p>
      </div>

      <div class="tiers">
        {tiers.map((t) => (
          <article class={`tier ${t.cls}`}>
            <div class="tier-tag">{t.tag}</div>
            <div class="tier-name">{t.name}</div>
            <div class="tier-spec">{t.spec}</div>
            <div class="tier-stats">
              {t.stats.map((s) => (
                <div class="tier-stat">
                  <div class="v">{s.v}{s.u && <span class="u">{s.u}</span>}</div>
                  <div class="l">{s.l}</div>
                </div>
              ))}
            </div>
            <div class="tier-note">{t.note}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ vs. the alternatives</div>
          <h2 class="sec-title">The <span class="accent">orchestration</span> layer<br />around your inference engine.</h2>
        </div>
        <p class="sec-sub">
          Slots survive <code class="mono accent-mono">hal0-api</code> restarts. Embeddings, rerank,
          STT, TTS, and image gen all sit behind the same
          <code class="mono accent-mono">/v1/*</code> surface. UMA-aware hardware probe and
          slot-fit warnings are first-class, not a slash command in a chat window.
        </p>
      </div>

      <div class="compare">
        <div class="cmp-row head">
          <div></div>
          {compareCols.map((c, i) => (
            <div class={i === 0 ? 'us' : ''}>{c}{i === 0 && ' (this)'}</div>
          ))}
        </div>
        {compareRows.map((r) => (
          <div class="cmp-row">
            <div class="lbl">{r.lbl}</div>
            {r.cells.map((c, j) => (
              <div class={j === 0 ? 'us-cell' : ''}>{c}</div>
            ))}
          </div>
        ))}
      </div>
      <p class="cmp-note">
        Competitor capabilities reflect each project's published docs as of October 2026
        and move fast — treat this as a snapshot, not a live scorecard.
      </p>
    </div>
  </section>

  <!-- OPERATOR CONSOLE — real dashboard screenshots (1440×900 with @2x, dark, live hal0 instance) -->
  <section class="section section-tight" id="console">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ the console</div>
          <h2 class="sec-title">Slots, profiles and memory,<br /><span class="accent">one console</span>.</h2>
        </div>
        <p class="sec-sub">
          Slots, models, profiles, image generation, agent memory, an agent task
          board, MCP and logs: every surface in one React operator console.
          SSE-backed, dark by default. Real screenshots from a live hal0 instance.
        </p>
      </div>

      <figure class="shot-hero">
        <img
          src="/screenshots/dashboard-overview.png"
          srcset={shotSet('dashboard-overview')}
          alt="hal0 dashboard overview with slots, throughput and live service health"
          width="1440"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="shot-grid">
        <figure class="shot">
          <img src="/screenshots/slots-inference.png" srcset={shotSet('slots-inference')} alt="Slots view with a card per slot, each showing its model, profile and context" width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption class="shot-cap"><strong>Slots</strong>: each card carries a model picker, a profile picker and a context chip, so you see what runs where and swap it in place.</figcaption>
        </figure>
        <figure class="shot">
          {/* TODO(shots): switch to profile-edit-drawer once the recapture lands. */}
          <img src="/screenshots/slot-detail.png" srcset={shotSet('slot-detail')} alt="Slot drawer with its model, profile and effective context" width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption class="shot-cap"><strong>Profiles</strong>: the profile drawer owns context, thinking, vision, MTP, flags and the runtime. Seeds stay read-only; duplicate one to edit it.</figcaption>
        </figure>
        <figure class="shot">
          <img src="/screenshots/memory-graph.png" srcset={shotSet('memory-graph')} alt="Agent memory rendered as a navigable semantic and temporal knowledge graph" width="1440" height="900" loading="lazy" decoding="async" />
          <figcaption class="shot-cap"><strong>Graph memory</strong>: facts become a navigable semantic and temporal graph, shared or private per agent.</figcaption>
        </figure>
      </div>

      <p class="shot-note">
        Plus the Hermes agent, the Operator Board kanban wired to it, the Runner
