---
/**
 * Landing page — / (hal0.dev).
 *
 * hal0 v2 design — sodium amber on graphite. Strix Halo first, the rest
 * of the matrix honest. Claims and numbers trace to the hal0 codebase
 * (src/hal0) — verify there, not from a copy doc.
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import LiveArtifact from '../components/landing/LiveArtifact.astro';
import HermesCard from '../components/HermesCard.astro';
import ForumTopics from '../components/landing/ForumTopics.astro';
import FeaturedProfiles from '../components/landing/FeaturedProfiles.astro';
import LatestWriting from '../components/landing/LatestWriting.astro';
import BenchHighlights from '../components/landing/BenchHighlights.astro';
import rawChangelog from '../data/changelog.md?raw';
import { parseChangelog } from '../lib/changelog.js';
import '../styles/site-data.css';

const canonicalUrl = 'https://hal0.dev/';
// Derived from the changelog (synced from the product repo) — never hardcoded.
const version = parseChangelog(rawChangelog).latest?.version ?? '';

// Full copy feeds the structured-data schema (no length limit); a tight ~155-char
// version is the page meta + OG description (search snippets cap ~160).
const description =
  'hal0 is an open-source homelab AI inference platform built for the AMD Ryzen AI Max+ 395 — "Strix Halo" — with 128 GB of unified memory and an XDNA NPU. OpenAI-compatible /v1/* API, declarative Stacks, systemd-managed slots, GPU voice (Qwen3-TTS) and NPU speech-to-text, local image generation (ComfyUI), a bundled Hermes agent with audited memory, an MCP server, and signed self-update. One command installs all of it.';
const metaDescription =
  'Open-source homelab AI for AMD Strix Halo: declarative Stacks, OpenAI-compatible /v1/* API, GPU voice, local image gen, agents + audited memory, signed self-update.';

const softwareApplicationLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'hal0',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  description,
  url: canonicalUrl,
  downloadUrl: 'https://hal0.dev/install.sh',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  softwareVersion: version,
  codeRepository: 'https://github.com/hal0ai/hal0',
  keywords:
    'Strix Halo, Ryzen AI Max+ 395, AMD XDNA NPU, 128 GB unified memory, homelab AI, OpenAI-compatible API, local LLM, Proxmox LXC, llama.cpp, FLM, AI inference appliance, declarative Stacks, local image generation, ComfyUI, SDXL, Flux, GPU voice, Qwen3-TTS, whisper-v3, AI agents, Hermes agent, agent memory, Hindsight, audit trail, MCP server, agent kanban, Operator Board, NPU occupancy, self-hosted AI',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'hal0ai', url: 'https://github.com/hal0ai' },
};

const features = [
  {
    tag: 'agents',
    title: 'Agents that live on the box',
    body: 'Hermes installs and bootstraps itself on first run, prewired to the local /v1 API. hal0-brain is the second: a resident operator you ask about the box in plain language, from the dashboard or a headless terminal.',
  },
  {
    tag: 'mcp',
    title: '180 tools over MCP',
    body: 'Two Streamable-HTTP servers mount straight onto the API: models, slots, memory, stacks, bench, telemetry and the updater, all reachable by any MCP client. The 54 destructive ones return pending_approval and wait for a human.',
  },
  {
    tag: 'memory',
    title: 'Memory that never leaves the box',
    body: 'Opt-in Hindsight-backed memory with a 26-tool surface. The engine runs embedded and loopback-only, embeddings included, so recall costs nothing and reaches no one. Banks are scoped per agent, and destructive operations write an attributable audit row.',
  },
  {
    tag: 'voice',
    title: 'Speech in and out, device-keyed',
    body: 'One stt slot and one tts slot, each resolving by device: Moonshine on CPU or whisper-v3:turbo on the XDNA NPU for listening, Kokoro (CPU) or Qwen3-TTS (GPU) for speaking. Switch the engine, not the plumbing.',
  },
  {
    tag: 'images',
    title: 'Image generation on the same API',
    body: 'POST /v1/images/generations runs SDXL, SD 1.5 or Flux through a ComfyUI engine. Generating flips the iGPU into exclusive image mode and back, so chat and images share one accelerator without fighting over it.',
  },
  {
    tag: 'prewired',
    title: 'Wired up before you log in',
    body: 'One command brings up the API, a coherent set of slots, Open WebUI on :3001, ComfyUI and the agent — lifecycle-managed as extensions, with cosign-verified updates and one-flag rollback from day one.',
  },
];

const providers = [
  {
    prov: 'llama.cpp',
    ver: 'hal0-combined:0826',
    hw: 'ROCm (default) · Vulkan · CUDA',
    uses: 'chat · embed · rerank · vision',
    eps: '/v1/chat · /v1/embeddings · /v1/rerankings',
  },
  {
    prov: 'FLM',
    ver: 'v0.9.44',
    hw: 'AMD XDNA NPU (opt-in)',
    uses: 'chat · embed (ASR multiplex)',
    eps: '/v1/chat · /v1/embeddings',
  },
  {
    prov: 'FLM / Whisper',
    ver: 'whisper-v3:turbo',
    hw: 'AMD XDNA NPU',
    uses: 'speech-to-text (co-loaded with chat)',
    eps: '/v1/audio/transcriptions',
  },
  {
    prov: 'Moonshine',
    ver: 'moonshine-base-en',
    hw: 'CPU',
    uses: 'speech-to-text (cpu device)',
    eps: '/v1/audio/transcriptions',
  },
  {
    prov: 'Kokoro / Qwen3-TTS',
    ver: 'kokoro-v1 82M · Qwen3-TTS 1.7B',
    hw: 'CPU (Kokoro) · ROCm (Qwen3-TTS)',
    uses: 'text-to-speech · one-switch CPU⇄GPU swap',
    eps: '/v1/audio/speech',
  },
  {
    prov: 'ComfyUI',
    ver: 'digest-pinned',
    hw: 'ROCm',
    uses: 'image gen · SDXL / SD 1.5 / Flux',
    eps: '/v1/images/generations',
  },
];

const tiers = [
  {
    cls: 'first-class',
    tag: 'reference deployment',
    name: 'Ryzen AI Max+ 395',
    spec: '"Strix Halo" iGPU + XDNA NPU + 128 GB LPDDR5X-8000 unified memory',
    stats: [
      { v: '128', u: 'GB', l: 'unified · BIOS-tunable to ~96 GB GPU' },
      { v: '258', u: 'tok/s', l: 'primary + embed concurrent' },
    ],
    note: 'All published perf numbers come from this box. Q4 70B fits with massive headroom; Q4 MoE 100B+ with a 17–22B active path becomes feasible.',
  },
  {
    cls: 'first-class',
    tag: 'first-class',
    name: 'Ryzen AI Max 385 / 390',
    spec: 'Strix Halo with 64 GB unified',
    stats: [
      { v: '64', u: 'GB', l: 'unified memory' },
      { v: '~70', u: 'B', l: 'Q4 ceiling, shorter context' },
    ],
    note: 'Same install path. Every small + mid tier fits; 70B Q4 works with tighter context windows.',
  },
  {
    cls: 'supported',
    tag: 'experimental',
    name: 'NVIDIA RTX 30 / 40 / 50',
    spec: '10–32 GB dedicated VRAM · CUDA llama.cpp',
    stats: [
      { v: '32', u: 'GB', l: 'RTX 5090 VRAM ceiling' },
      { v: '~30', u: 'B', l: 'Q4 comfortable' },
    ],
    note: 'Same slot lifecycle, dedicated VRAM instead of UMA — higher tok/s on small models, lower ceiling on the big ones.',
  },
  {
    cls: 'supported',
    tag: 'supported',
    name: 'AMD Radeon RX 7000',
    spec: '16–24 GB discrete · ROCm or Vulkan container profiles',
    stats: [
      { v: '24', u: 'GB', l: '7900 XTX VRAM' },
      { v: 'ROCm', u: '', l: '· Vulkan' },
    ],
    note: 'Discrete AMD path, same hal0-slot@<name> lifecycle as Strix Halo — both ROCm and Vulkan container profiles run today.',
  },
  {
    cls: 'supported',
    tag: 'fallback',
    name: 'CPU-only x86_64',
    spec: 'Vulkan-CPU · usable for tiny models',
    stats: [
      { v: '0.5–4', u: 'B', l: 'practical model size' },
      { v: 'Qwen', u: '0.5B', l: 'the CI smoke model' },
    ],
    note: 'CI runs Qwen 0.5B here. Usable for tiny models and smoke tests, not the headline experience.',
  },
  {
    cls: 'supported',
    tag: 'supported',
    name: 'Proxmox LXC',
    spec: 'privileged container · iGPU + XDNA passthrough',
    stats: [
      { v: '0600', u: '', l: 'PVE token, never echoed back' },
      { v: 'segmented', u: '', l: 'host-pressure overlay' },
    ],
    note: 'Drop a read-only PVEAuditor token into Settings and the memory bar shows physical DIMM total + a muted "Proxmox host" segment for other-tenant + ZFS ARC pressure.',
  },
];

const compareCols = ['hal0', 'ollama', 'LM Studio', 'OpenAI cloud'];
const compareRows = [
  { lbl: 'OpenAI-compatible /v1/*', cells: ['chat · embed · rerank · STT · TTS · img', 'chat · embed', 'chat · embed', 'chat · embed · STT · TTS · img'] },
  { lbl: 'Concurrent slots', cells: ['as memory fits', 'one at a time', 'one at a time', 'fully concurrent'] },
  { lbl: 'Slot lifecycle state machine', cells: ['typed, atomic, SSE-streamed', 'no', 'no', '—'] },
  { lbl: 'UMA-aware hardware probe', cells: ['Strix Halo · NPU · platform-aware', 'CPU / GPU only', 'CPU / GPU only', '—'] },
  { lbl: 'XDNA NPU support', cells: ['first-class via FLM', 'no', 'no', '—'] },
  { lbl: 'Dispatcher with upstreams', cells: ['OpenRouter · Anthropic · OpenAI · custom', 'no', 'no', '—'] },
  { lbl: 'Cosign-signed updates', cells: ['keyless OIDC + rollback', 'no', 'auto-update', '—'] },
  { lbl: 'Headless / Linux-first', cells: ['systemd-required, headless', 'cross-platform', 'GUI required', 'cloud'] },
  { lbl: 'Your data, your hardware', cells: ['yes', 'yes', 'yes', 'no'] },
  { lbl: 'Cost per million tokens', cells: ['$0 + electricity', '$0 + electricity', '$0 + electricity', '$0.50 – $60'] },
];

interface RoadmapItem { t: string; d: string; }
type RoadmapTheme = { id: string; name: string; blurb: string; shipped: RoadmapItem[]; soon: RoadmapItem[]; later: RoadmapItem[]; };
const themes: RoadmapTheme[] = [
  {
    id: 'inference',
    name: 'Inference + providers',
    blurb: 'The /v1/* surface and the engines behind it.',
    shipped: [
      { t: 'OpenAI-compatible /v1/* API', d: 'Chat, completions, embeddings, rerank, transcriptions, speech, images. Every OpenAI SDK works unchanged against the local box.' },
      { t: 'Six-provider stack', d: 'llama.cpp (Vulkan / ROCm) for chat and embed, FLM for the XDNA NPU (chat + whisper-v3:turbo STT + embed, one process), Moonshine (CPU) or whisper-v3:turbo (NPU) behind one stt slot, Kokoro (CPU) or Qwen3-TTS (GPU) behind one tts slot, ComfyUI for image generation.' },
      { t: 'Image generation + iGPU switchover', d: 'POST /v1/images/generations served by a ComfyUI engine; generating flips the GPU into exclusive image mode and back, so chat and image share one accelerator.' },
      { t: 'FLM NPU provider', d: 'Self-contained NPU toolbox pinned by digest. The chat + STT + embed trio is surfaced only when XDNA hardware is present.' },
      { t: 'Bundled chat UI + voice', d: 'Open WebUI on :3001 prewired to the local API, whisper-v3:turbo STT (NPU, via FLM), and a one-switch Kokoro (CPU) ⇄ Qwen3-TTS (GPU) TTS engine served through the capability API.' },
      { t: 'Hands-free voice', d: 'Open WebUI\'s Call mode wired to hal0\'s /v1/audio/transcriptions and /v1/audio/speech endpoints — whisper-v3:turbo for listen, Kokoro for reply. hal0 also serves its own WS /v1/realtime for clients that want to drive the loop directly.' },
    ],
    soon: [],
    later: [
      { t: 'Fine-tune & LoRA hot-swap', d: 'Attach and rotate LoRAs against a warm base model without unloading the underlying weights.' },
      { t: 'Per-model rate limits & budgets', d: 'Cost-style accounting for local inference so a chatty agent can be capped without taking the whole box down.' },
    ],
  },
  {
    id: 'lifecycle',
    name: 'Stability + slot lifecycle',
    blurb: 'Atomic transitions, health gated on a real probe, state that survives a restart.',
    shipped: [
      { t: 'Slot lifecycle state machine', d: 'Atomic transitions (offline → pulling → starting → warming → ready → serving), persisted and SSE-streamed.' },
      { t: 'Honest slot health + derived context', d: 'A slot is marked ready only once its real /health passes — never on a systemd snapshot. Context size is derived per slot, never silently inheriting the 4096 default.' },
      { t: 'Capability slots + profiles', d: 'Embed / Voice / Image capability cards and an NPU rollup over flat slots; per-device profiles unify the launch flags, all from one Slots tab.' },
    ],
    soon: [
      { t: 'Benchmarks & presets UI', d: 'In-dashboard tok/s + latency runs, plus curated loadout presets you can flash onto a fresh install.' },
    ],
    later: [],
  },
  {
    id: 'install',
    name: 'Install + distribution',
    blurb: 'One command. Signed. Resumable.',
    shipped: [
      { t: 'One-command install', d: 'install.sh probes the host, picks a hardware-anchored tier, and provisions a coherent set of slots, extensions and models in one pass — resumable, and re-runnable to repair a box in place.' },
      { t: 'Cosign-signed self-update', d: 'Atomic version swap with one-flag rollback. Stable, preview, and nightly channels, GitHub OIDC-verified release tarballs, manifest proxied at releases.hal0.dev.' },
      { t: 'Extensions framework', d: 'Apps and agents (Open WebUI, ComfyUI, Hermes) packaged as auto-wired extensions: lifecycle-managed, selectable at install.' },
    ],
    soon: [
      { t: 'AUR PKGBUILD & Ubuntu PPA', d: 'Native distro packages on top of the install script: pacman and apt as first-class install paths.' },
    ],
    later: [],
  },
  {
    id: 'hardware',
    name: 'Hardware + observability',
    blurb: 'Probe before you load. A memory bar that reads the live driver total.',
    shipped: [
      { t: 'UMA-aware probe', d: 'Detects iGPU, XDNA NPU, and the unified memory pool; surfaces fit warnings inline before you load a model that won\'t fit.' },
      { t: 'Live GTT total + honest memory bar', d: 'The memory bar reports the live GTT total from the driver, not a stale cached probe — so the unified pool you see is the pool you have.' },
      { t: 'NPU occupancy grid', d: 'A living per-slot occupancy view of the XDNA NPU that breathes with real activity instead of a static picker.' },
    ],
    soon: [],
    later: [
      { t: 'Multi-host federation', d: 'A slot mesh across LAN boxes: chat on the Strix Halo, embed on the workstation, all behind one /v1/* surface.' },
    ],
  },
  {
    id: 'agents',
    name: 'Agents + memory + MCP',
    blurb: 'Agents that run on the box, with memory and tool access.',
    shipped: [
      { t: 'Bundled Hermes agent', d: 'Hermes installs and bootstraps on first run — confined by its own systemd unit, prewired to the local /v1 API and MCP servers, with an agent-card library in the dashboard.' },
      { t: 'Operator Board', d: 'A hal0-skinned kanban wired to Hermes (/api/board/*), with a live agent-chat drawer and working task creation.' },
      { t: 'Hindsight-backed memory', d: 'Opt-in memory engine (HAL0_MEMORY_ENABLED), running embedded and loopback-only. Shared by default; the X-hal0-Agent header scopes a client\'s writes to its own namespace. Every destructive op — bank delete, memory/document/directive wipes — records a durable, attributable audit row.' },
      { t: 'MCP host + server', d: 'hal0 speaks Model Context Protocol both directions: an admin + memory MCP server, plus an allow-listed client that composes external MCP tools. Destructive calls gate through an approval bell + CLI.' },
    ],
    soon: [],
    later: [
      { t: 'ChatOps adapters', d: 'Slack and Matrix bridges as extensions, so you can talk to hal0 from the rooms you already live in.' },
    ],
  },
  {
    id: 'security',
    name: 'Security',
    blurb: 'Signed supply chain, contained agents, audited tool calls, LAN-scoped by design.',
    shipped: [
      { t: 'LAN-scoped by design, proxy at the edge', d: 'hal0 ships no auth layer and no TLS of its own. The API binds 0.0.0.0:8080 for the LAN and stops there; the edge is yours — Traefik, nginx, or a Cloudflare Tunnel in front, using the identity provider you already run.' },
      { t: 'Cosign-keyless supply chain', d: 'Every release tarball is verified against its GitHub OIDC identity before it unpacks. The version swap is atomic against a /usr/lib/hal0/current symlink, and --rollback reverts it in one flag.' },
      { t: 'Contained agent execution', d: 'The bundled agent runs under its own systemd unit with NoNewPrivileges, ProtectSystem=strict and a pinned ReadWritePaths set, and its terminal is off by default. Gated tools clear an approval bell before they fire.' },
      { t: 'Attributable audit trail', d: 'Every destructive memory operation — bank delete, memory/document/directive wipes — writes a durable audit row naming the caller, and an x-request-id ties a response back to rows in both the metrics and audit tables.' },
    ],
    soon: [],
    later: [],
  },
];

// Everything still ahead of us, in one list — the page no longer sorts the
// future into confidence tiers it cannot honour.
const nextItems: RoadmapItem[] = themes.flatMap((th) => [...th.soon, ...th.later]);
const deliveredCount = themes.reduce((n, th) => n + th.shipped.length, 0);

const shipNowHighlights = [
  {
    tag: 'mcp',
    title: 'The whole platform is reachable over MCP',
    body: 'The admin MCP catalog grew from 92 to 180 tools — services, ComfyUI, updater/doctor/health, telemetry, slots, models, bench, approvals — including a 26-tool memory surface at feature parity with Hindsight 0.8.4.',
  },
  {
    tag: 'slots',
    title: 'Slots start when you say so',
    body: 'A new autoload setting decouples binding a model from boot start, and an eviction priority (0–100) replaces the inert lru opt-in — memory-pressure eviction actually works on a stock box. On-demand capability slots and per-slot profiles round it out.',
  },
  {
    tag: 'stability',
    title: 'Nothing reports ready until it is',
    body: 'A slot reaches ready only when its own /health passes — never on a systemd snapshot. Transitions are atomic and persisted to state.json, so slots survive an hal0-api restart, and context size is derived per slot instead of silently inheriting the 4096 default.',
  },
  {
    tag: 'security',
    title: 'Signed, sandboxed, audited',
    body: 'Release tarballs verify against their GitHub OIDC identity before they unpack, and the version swap reverts with one flag. The bundled agent runs under NoNewPrivileges and ProtectSystem=strict with its shell off by default, gated MCP tools clear an approval bell, and every destructive memory op writes an attributable audit row.',
  },
];

---

<MarketingLayout
  title="hal0 — Strix Halo native AI inference, image gen & agents for homelabs."
  description={metaDescription}
>
  <!-- HERO -->
  <header class="hero">
    <div class="shell-wide hero-grid">
      <div>
        <div class="eyebrow">
          <span class="blip"></span> {version} shipping now · Apache-2.0
        </div>
        <h1 class="h1">
          Your Strix Halo box,<br />
          running real <span class="accent">/v1/*</span><br />
          inference.
        </h1>
        <p class="lede">
          Every modality — <strong>agents, chat, speech, images, memory</strong> — served
          from a single OpenAI-compatible API on your <strong>Strix Halo</strong> box
          or any Linux machine.
        </p>

        <div class="install" id="install">
          <div class="install-head">
            <div class="install-dots"><i></i><i></i><i></i></div>
            <div class="install-title">install.sh</div>
            <div class="install-meta">Linux x86_64 · Python ≥3.12</div>
          </div>
          <div class="install-body">
            <span class="prompt">$</span>
            <span class="cmd">curl -fsSL https://hal0.dev/install.sh | bash</span>
            <span class="caret"></span>
            <button class="copy-btn" data-copy="curl -fsSL https://hal0.dev/install.sh | bash">copy</button>
          </div>
        </div>

        <div class="cta-row">
          <a href="https://forum.hal0.dev/t/hal0-documentation/19" class="btn">Read the docs →</a>
          <a href="https://github.com/hal0ai/hal0" rel="noopener" class="btn ghost">★ Star on GitHub</a>
          <span class="cta-meta">Apache-2.0 · Linux + systemd</span>
        </div>

        <div class="ticker">
          <span class="tk"><span class="dot"></span> hal0-api</span>
          <span class="tk"><b>:8080</b> ready</span>
          <span class="tk-sep">·</span>
          <span class="tk">all slots <b>up</b></span>
          <span class="tk-sep">·</span>
          <span class="tk">GTT <b>9.2 / 96 GB</b></span>
          <span class="tk-sep">·</span>
          <span class="tk">probe <b>strix-halo</b></span>
        </div>
      </div>

      <LiveArtifact />
    </div>
  </header>

  <!-- STACK -->
  <section class="section section-tight" id="stack">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ provider stack</div>
          <h2 class="sec-title">Six engines,<br />one <span class="accent">/v1/*</span> surface.</h2>
        </div>
        <p class="sec-sub">
          Chat, embeddings, rerank, speech both ways and image generation — each
          served by the engine that suits it, on the accelerator that suits it,
          all behind one OpenAI-compatible API. The picker only offers a backend
          your hardware can actually honour.
        </p>
      </div>

      <div class="matrix">
        <div class="matrix-row head">
          <div>Provider</div>
          <div>Workloads</div>
          <div>Hardware</div>
          <div>Endpoints</div>
        </div>
        {providers.map((r) => (
          <div class="matrix-row">
            <div class="prov">
              <span class="prov-name">{r.prov}</span>
              <span class="prov-ver">{r.ver}</span>
            </div>
            <div class="uses">{r.uses}</div>
            <div class="hw">{r.hw}</div>
            <div class="ep">
              {r.eps.split(' · ').map((e) => <span class="ep-chip">{e}</span>)}
            </div>
          </div>
        ))}
      </div>

      <div class="lifecycle-wrap">
        <div class="hr-line">SLOT LIFECYCLE — ENFORCED IN _transition()</div>
        <div class="lifecycle">
          <div class="lifecycle-track">
            <span class="state-pill done">offline</span>
            <span class="arrow">→</span>
            <span class="state-pill done">pulling</span>
            <span class="arrow">→</span>
            <span class="state-pill done">starting</span>
            <span class="arrow">→</span>
            <span class="state-pill done">warming</span>
            <span class="arrow">→</span>
            <span class="state-pill done">ready</span>
            <span class="arrow">⇄</span>
            <span class="state-pill active">serving</span>
            <span class="arrow">⇄</span>
            <span class="state-pill done">idle</span>
            <span class="arrow">→</span>
            <span class="state-pill done">unloading</span>
            <span class="arrow">→</span>
            <span class="state-pill done">offline</span>
            <span class="state-err"><span class="arrow">↳</span> <span class="state-pill err">error</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S IN THE BOX -->
  <section class="section" id="what">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ what's in the box</div>
          <h2 class="sec-title">More than models.<br />A whole <span class="accent">AI stack</span>.</h2>
        </div>
        <p class="sec-sub">
          Agents, tools, memory, voice and image generation ship in the box and
          come up wired to each other — not a model runner you then spend a
          weekend assembling a platform around.
        </p>
      </div>

      <div class="feat-grid">
        {features.map((f) => (
          <article class="feat-card">
            <div class="feat-tag">{f.tag}</div>
            <div class="feat-title">{f.title}</div>
            <p class="feat-body">{f.body}</p>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- USE CASES — outcome-led. Used to sit directly under the hero, where the
       hero supplied its spacing and context; now that it follows the feature
       grid it carries its own header and section rhythm. -->
  <section class="section section-tight usecases" id="use-cases">
    <div class="shell-wide">
      <div class="sec-head">
        <div>
          <div class="sec-tag">/ what people run it for</div>
          <h2 class="sec-title">One box,<br />three <span class="accent">day jobs</span>.</h2>
        </div>
        <p class="sec-sub">
          The same install serves all three at once — the slots share the
          accelerator instead of taking turns with it.
        </p>
      </div>
