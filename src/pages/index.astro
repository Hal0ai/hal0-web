---
/**
 * Landing page, / (hal0.dev).
 *
 * Written for someone setting up a first local AI server. It reads top to
 * bottom as one story in plain words: what hal0 is, why slots matter, what
 * arrives connected, the agent, the memory, privacy, models, a tour of the
 * dashboard, what you need, and how to start. Product vocabulary is kept out of
 * the first three sections, and the technical layer sits behind the "Want the
 * details?" links, the named comparison's disclosure and the docs.
 *
 * Copy lives in src/data/landing.ts, with the limits on what it may claim.
 * Copy is version-neutral: the release version comes from the latest tagged
 * entry in the synced changelog, and the benchmark note states the sweep's own
 * date and version because those numbers are not current-release numbers.
 *
 * Section headings use the body face; the mono face is kept for small labels,
 * the install command and the blocks shared with the rest of the site.
 */
import { Icon } from 'astro-icon/components';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Shot from '../components/Shot.astro';
import HermesCard from '../components/HermesCard.astro';
import TeamBoard from '../components/landing/TeamBoard.astro';
import SlotVersus from '../components/landing/SlotVersus.astro';
import DashboardTour from '../components/landing/DashboardTour.astro';
import CompareTable from '../components/landing/CompareTable.astro';
import Faq from '../components/landing/Faq.astro';
import ReleaseTeaser from '../components/landing/ReleaseTeaser.astro';
import ForumTopics from '../components/landing/ForumTopics.astro';
import FeaturedProfiles from '../components/landing/FeaturedProfiles.astro';
import LatestWriting from '../components/landing/LatestWriting.astro';
import BenchHighlights from '../components/landing/BenchHighlights.astro';
import rawChangelog from '../data/changelog.md?raw';
import releaseTags from '../data/release-tags.json';
import { ROSTER_DATE } from '../data/model-roster';
import {
  AGENT_NOTE,
  AGENT_POINTS,
  DETAILS,
  FAQ,
  HARDWARE,
  MEMORY_NOTE,
  MEMORY_POINTS,
  MODEL_KINDS,
  PLAIN_COMPARE,
  PRIVACY_FACTS,
  PRIVACY_NOTE,
  SHOT_CONNECTED,
  SHOT_MEMORY,
  SHOT_MODELS,
  SLOT_NOTE,
  SLOT_WINS,
  STEPS,
  TOUR,
  USES,
  WIRED,
} from '../data/landing';
import { parseChangelog } from '../lib/changelog.js';
import { ORG_ID, SITE_URL } from '../lib/seo.ts';
import '../styles/site-data.css';

const TITLE = 'hal0: Self-Hosted Local AI Server for AMD Strix Halo';
const DESCRIPTION =
  'Run LLMs, speech and images on your own hardware. Open-source, OpenAI-compatible local AI server for AMD Strix Halo (Ryzen AI Max+ 395) and Linux.';
// Copied from docs/getting-started/install.mdx in the product repo, not retyped.
const INSTALL_COMMAND = 'curl -fsSL https://hal0.dev/install.sh | sudo bash';
const DOCS_URL = 'https://forum.hal0.dev/t/hal0-documentation/19';
const FORUM_URL = 'https://forum.hal0.dev';
const GITHUB_URL = 'https://github.com/hal0ai/hal0';

// Latest *tagged* stable, so an untagged heading never reads as shipped.
const version = parseChangelog(rawChangelog, { tags: releaseTags.tags }).latestTagged?.version ?? '';

const shotUrl = (name: string) => `${SITE_URL}/screenshots/${name}.png`;
const pageShots = [SHOT_CONNECTED.name, SHOT_MEMORY.name, SHOT_MODELS.name, ...TOUR.map((stop) => stop.shot)];

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'hal0',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  description: FAQ[0].a,
  url: `${SITE_URL}/`,
  // A capture with no performance figures in it.
  image: shotUrl(SHOT_CONNECTED.name),
  screenshot: pageShots.map(shotUrl),
  featureList: [
    'Several models loaded side by side, each in a named slot',
    'Change the model behind a slot without reconfiguring your apps',
    'Open WebUI and the Hermes agent connected on install',
    'One Hindsight memory shared by the chat app and the agents',
    'Chat, embeddings, rerank, speech and images behind one OpenAI-compatible API',
    'MCP servers for agents, memory and admin, with approval for risky calls',
    'Runs on your own hardware, with no account',
    'Signed updates with rollback',
  ],
  softwareRequirements: 'Linux x86_64, Python 3.12+, systemd, podman',
  releaseNotes: `${SITE_URL}/releases/`,
  installUrl: `${SITE_URL}/install.sh`,
  downloadUrl: `${SITE_URL}/install.sh`,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  softwareVersion: version,
  codeRepository: GITHUB_URL,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'hal0ai', url: 'https://github.com/hal0ai' },
  publisher: { '@id': ORG_ID },
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<MarketingLayout title={TITLE} description={DESCRIPTION} jsonLd={[softwareApplication, faqPage]}>
  <div class="lp">
    <!-- 1. HERO -->
    <section class="hero">
      <div class="lp-wrap hero-grid">
        <div>
          <p class="hero-eyebrow">Own your inference · free and open source</p>
          <h1>Private AI for your home.</h1>
          <p class="hero-sub">A whole team of models, always ready, on a box you own.</p>
          <p class="lede">
            hal0 turns a Strix Halo mini PC, or another Linux machine, into your own AI server. Chat, write code, talk,
            make images and run agents. Several models stay loaded side by side, and the apps that use them arrive
            already connected.
          </p>
          <div class="cta-row">
            <a href="#start" class="btn lg">Get started</a>
            <a href="#slots" class="btn ghost lg">See how it works</a>
          </div>
          <ul class="assure">
            <li><Icon name="lucide:check" />No account</li>
            <li><Icon name="lucide:check" />No tracking</li>
            <li><Icon name="lucide:check" />One command to install</li>
          </ul>
        </div>
        <TeamBoard />
      </div>
    </section>

    <!-- 2. WHAT YOU CAN DO -->
    <section class="band" id="uses" aria-label="What you can do with it">
      <div class="lp-wrap">
        <ul class="uses">
          {USES.map((use) => (
            <li>
              <span class="use-ic"><Icon name={use.icon} /></span>
              <h2>{use.title}</h2>
              <p>{use.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. SLOTS. Old links to /#idea and /#swap land here. -->
    <section class="sec" id="slots">
      <span id="idea"></span>
      <span id="swap"></span>
      <div class="lp-wrap">
        <header class="head">
          <p class="tag">What makes hal0 different</p>
          <h2>A team of models, not a queue for one.</h2>
          <p class="sub">
            Many local AI tools keep a single model in memory and swap it out when you ask for a different one. Every
            swap is a wait. hal0 gives each job its own <strong>slot</strong>: a named seat where a model sits loaded
            and ready.
          </p>
        </header>
        <SlotVersus />
        <ul class="wins">
          {SLOT_WINS.map((win) => (
            <li>
              <h3>{win.title}</h3>
              <p>{win.body}</p>
            </li>
          ))}
        </ul>
        <p class="fine">
          <span>{SLOT_NOTE}</span>
          <a href="/docs/concepts/slots/">How slots work, in detail →</a>
        </p>
      </div>
    </section>

    <!-- 4. CONNECTED. Old links to /#wired land here. -->
    <section class="sec alt" id="connected">
      <span id="wired"></span>
      <div class="lp-wrap split">
        <div>
          <p class="tag">Ready out of the box</p>
          <h2>Everything arrives connected.</h2>
          <p class="sub">
            The installer sets up a chat app, an agent and a memory, and points them at your slots. There is no
            settings file to edit and no address to copy from one app to another. Change what a slot runs and they
            follow.
          </p>
          <ul class="wired">
            {WIRED.map((item) => (
              <li>
                <span class="chip-ic"><Icon name={item.icon} /></span>
                <div>
                  <h3>{item.name} <span>{item.product}</span></h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="frame crop-services">
          <Shot name={SHOT_CONNECTED.name} alt={SHOT_CONNECTED.alt} caption={SHOT_CONNECTED.caption} />
        </div>
      </div>
    </section>

    <!-- 5. AGENT -->
    <section class="sec" id="agent">
      <div class="lp-wrap agent">
        <div class="agent-card">
          <HermesCard />
        </div>
        <div>
          <p class="tag">A built-in agent</p>
          <h2>An agent that gets on with it.</h2>
          <p class="sub">
            A chat model answers questions. An agent can also use tools and work through a job step by step. hal0
            installs one, called Hermes, and connects it to your models and your memory.
          </p>
          <ul class="ticks">
            {AGENT_POINTS.map((point) => (
              <li><Icon name="lucide:check" /><span><b>{point.term}</b> {point.text}</span></li>
            ))}
          </ul>
          <p class="aside">{AGENT_NOTE} <a href="/docs/concepts/security/">Security notes →</a></p>
          <a class="more" href="/docs/guides/run-agents/">How to run agents →</a>
        </div>
      </div>
    </section>

    <!-- 6. MEMORY -->
    <section class="sec alt" id="memory">
      <div class="lp-wrap split flip">
        <div class="frame">
          <Shot name={SHOT_MEMORY.name} alt={SHOT_MEMORY.alt} caption={SHOT_MEMORY.caption} />
        </div>
        <div>
          <p class="tag">Built-in memory</p>
          <h2>An assistant that remembers.</h2>
          <p class="sub">
            A chatbot normally forgets you when the conversation ends. hal0 includes a memory engine that keeps the
            useful facts and brings them back when they matter.
          </p>
          <ul class="ticks">
            {MEMORY_POINTS.map((point) => (
              <li><Icon name="lucide:check" /><span><b>{point.term}</b> {point.text}</span></li>
            ))}
          </ul>
          <p class="aside">{MEMORY_NOTE}</p>
          <a class="more" href="/docs/concepts/memory/">How memory works →</a>
        </div>
      </div>
    </section>

    <!-- 7. PRIVACY -->
    <section class="sec" id="privacy">
      <div class="lp-wrap">
        <header class="head center">
          <p class="tag">Privacy</p>
          <h2>What happens on your box stays on your box.</h2>
          <p class="sub">
            Your questions, your documents, your voice, and the half-finished idea you would rather not hand to a
            company: all of it is processed on hardware you own.
          </p>
        </header>
        <ul class="facts">
          {PRIVACY_FACTS.map((fact) => (
            <li>
              <span class="chip-ic"><Icon name={fact.icon} /></span>
              <h3>{fact.title}</h3>
              <p>{fact.body}</p>
            </li>
          ))}
        </ul>
        <p class="heads-up">
          <Icon name="lucide:info" />
          <span>
            <b>One thing to know.</b>{' '}
            {PRIVACY_NOTE}{' '}
            <a href="/docs/operate/auth/">How to add a sign-in →</a>
          </span>
        </p>
      </div>
    </section>

    <!-- 8. MODELS -->
    <section class="sec alt" id="models">
      <div class="lp-wrap">
        <header class="head">
          <p class="tag">Models</p>
          <h2>Run the models people are talking about.</h2>
          <p class="sub">
            New open models appear every week. Browse and download them inside the dashboard, and see whether one fits
            your machine before you spend an hour downloading it.
          </p>
        </header>
        <div class="split">
          <ul class="kinds">
            {MODEL_KINDS.map((kind) => (
              <li>
                <h3>{kind.title}</h3>
                <p>{kind.body}</p>
                <span class="eg">{kind.examples}</span>
              </li>
            ))}
          </ul>
          <div class="frame crop-top">
            <Shot name={SHOT_MODELS.name} alt={SHOT_MODELS.alt} caption={SHOT_MODELS.caption} />
          </div>
        </div>
      </div>
    </section>

    <!-- 9. TOUR. Old links to /#console land here. -->
    <section class="sec" id="tour">
      <span id="console"></span>
      <div class="lp-wrap wide">
        <header class="head">
          <p class="tag">The dashboard</p>
          <h2>See it before you install it.</h2>
          <p class="sub">One dashboard runs the whole box, from any browser on your network. Pick a tab.</p>
        </header>
        <DashboardTour />
      </div>
    </section>

    <!-- 10. HARDWARE -->
    <section class="sec alt" id="hardware">
      <div class="lp-wrap">
        <header class="head">
          <p class="tag">Hardware</p>
          <h2>What you need.</h2>
          <p class="sub">
            A 64-bit Intel or AMD computer running Linux, about 20 GB of free disk and room for the models you choose.
            A graphics chip helps a lot. macOS and Windows are not supported.
          </p>
        </header>
        <ul class="hw">
          {HARDWARE.map((hw) => (
            <li class:list={{ best: hw.best }}>
              <span class="hw-tier">{hw.tier}</span>
              <h3>{hw.name}</h3>
              <p>{hw.body}</p>
            </li>
          ))}
        </ul>
        <p class="fine">
          <a href="/profiles">See the setups other people run →</a>
          <a href="/docs/reference/hardware-matrix/">Full hardware list →</a>
        </p>
      </div>
    </section>

    <!-- 11. START. Old links to /#install and /#get land here. -->
    <section class="sec" id="start">
      <span id="get"></span>
      <div class="lp-wrap">
        <header class="head center">
          <p class="tag">Get started</p>
          <h2>Up and running in three steps.</h2>
        </header>
        <ol class="steps">
          {STEPS.map((step, i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
        <div class="install" id="install">
          <span class="prompt">$</span>
          <code class="cmd">{INSTALL_COMMAND}</code>
          <button type="button" class="btn ghost sm" data-copy={INSTALL_COMMAND}>copy</button>
        </div>
        <p class="install-note">
          {version && <span>Latest stable release: {version}. </span>}
          This form takes the default choices. To pick which parts are installed, follow the{' '}
          <a href="/docs/getting-started/install/">install guide</a>.
        </p>
        <div class="cta-row center">
          <a href="/docs/getting-started/beginners-guide/" class="btn lg">Read the beginner’s guide</a>
          <a href={DOCS_URL} class="btn ghost lg">All documentation</a>
          <a href={FORUM_URL} class="btn ghost lg">Ask on the forum</a>
        </div>
      </div>
    </section>

    <!-- 12. DETAILS: where the technical layer starts -->
    <section class="sec alt" id="details">
      <div class="lp-wrap">
        <header class="head">
          <p class="tag">For the curious</p>
          <h2>Want the details?</h2>
          <p class="sub">The plumbing is documented, measured and open. Start wherever you like.</p>
        </header>
        <ul class="details">
          {DETAILS.map((item) => (
            <li>
              <a href={item.href}>
                <span class="chip-ic"><Icon name={item.icon} /></span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <span class="det-link">{item.link} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 13. COMPARE: plain first, the named table behind a disclosure -->
    <section class="sec" id="compare">
      <div class="lp-wrap">
        <header class="head center">
          <p class="tag">How it compares</p>
          <h2>More than a model runner.</h2>
        </header>
        <div class="cmp-wrap">
          <table class="cmp">
            <thead>
              <tr>
                <td></td>
                <th scope="col">A typical local AI app</th>
                <th scope="col" class="us">hal0</th>
              </tr>
            </thead>
            <tbody>
              {PLAIN_COMPARE.map(([label, them, us]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{them}</td>
                  <td class="us">{us}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <details class="named">
          <summary>Already use Ollama, LM Studio, llama-swap or Lemonade? See the side-by-side comparison</summary>
          <p class="named-lede">
            hal0 is not a new engine. It is the layer around the engines you may already know, so this table compares
            that layer, and it describes each tool’s defaults.
          </p>
          <p class="swipe-hint">Swipe the table sideways to see the other tools.</p>
          <CompareTable />
        </details>
      </div>
    </section>

    <!-- 14. BENCHMARKS + RELEASES -->
    <div class="two-up-wrap">
      <div class="lp-wrap two-up">
        <section id="benchmarks">
          <BenchHighlights />
          <p class="bench-note">
            Sweep from {ROSTER_DATE} on hal0 0.5 with the earlier runner.
          </p>
        </section>
        <section id="releases" class="rel-col">
          <!-- Old links to /#whats-new and /#roadmap land on the release that replaced them. -->
          <span id="whats-new"></span>
          <span id="roadmap"></span>
          <ReleaseTeaser />
        </section>
      </div>
    </div>

    <!-- 15. FAQ -->
    <section class="sec alt" id="faq">
      <div class="lp-wrap">
        <header class="head center">
          <p class="tag">Questions</p>
          <h2>Before you start.</h2>
        </header>
        <Faq />
      </div>
    </section>

    <!-- 16. COMMUNITY: social proof for someone already sold, so it sits low. The
         forum block renders nothing at all when its fetch fails at build time. -->
    <div class="lp-wrap community">
      <ForumTopics />
      <FeaturedProfiles />
      <LatestWriting />
    </div>

    <!-- 17. FINAL CTA -->
    <section class="final">
      <div class="lp-wrap narrow">
        <h2>Your own AI server is one command away.</h2>
        <p>One command on a Linux machine. The chat app, the agent and the memory come with it.</p>
        <div class="cta-row center">
          <a href="#start" class="btn lg">Get started</a>
          <a href={GITHUB_URL} rel="noopener" class="btn ghost lg">View on GitHub</a>
        </div>
        <div class="final-chips">
          <span class="chip ok">Apache-2.0</span>
          <span class="chip">Linux + systemd</span>
          <span class="chip">no account</span>
          <span class="chip">signed releases</span>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      document.querySelectorAll('button[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-copy') || '';
          try { await navigator.clipboard.writeText(cmd); } catch {}
          const original = btn.textContent;
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = original; }, 1400);
        });
      });
    })();
  </script>
</MarketingLayout>

<style>
  /* Landing-only styles. Shared primitives (.btn, .chip, .card-hover) come from
   * site-data.css, and components carry their own scoped styles. */
  .lp {
    font-size: 16px;
  }
  .lp-wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .lp-wrap.narrow {
    max-width: 860px;
  }
  .lp-wrap.wide {
    max-width: 1400px;
  }
  .lp :global(svg[data-icon]) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--hal0-font-body);
    color: var(--hal0-fg);
    text-wrap: balance;
  }
  p {
    margin: 0;
  }
  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lp a:not(.btn) {
    color: var(--hal0-accent);
    text-decoration: none;
  }
  .lp a:not(.btn):hover {
    text-decoration: underline;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta-row.center {
    justify-content: center;
  }
  .lp :global(.btn.lg) {
    height: 44px;
    padding: 10px 22px;
    font-size: 14px;
  }

  /* 1. Hero */
  .hero {
    padding-block: 88px 72px;
    background: radial-gradient(ellipse 70% 60% at 80% 0%, var(--hal0-accent-glow), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 64px;
    align-items: center;
  }
  /* Not `.eyebrow`: the site-wide rule of that name wins and sets 10px, too small on a phone. */
  .hero-eyebrow {
    margin-bottom: 22px;
    font-family: var(--hal0-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hal0-accent);
  }
  h1 {
    font-size: clamp(40px, 5.6vw, 72px);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero-sub {
    margin-top: 18px;
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.3;
    color: var(--hal0-accent);
    text-wrap: balance;
  }
  .lede {
    max-width: 560px;
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--hal0-fg-muted);
    text-wrap: pretty;
  }
  .hero .cta-row {
    margin-top: 30px;
  }
  .assure {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 26px;
    font-size: 14px;
    color: var(--hal0-fg-dim);
  }
  .assure li {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .assure :global(svg) {
    color: var(--hal0-ok);
  }

  /* 2. Uses */
  .band {
    padding-block: 40px;
    border-block: 1px solid var(--hal0-border);
    background: var(--hal0-bg-elevated);
  }
  .uses {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px;
  }
  .use-ic {
    display: block;
    margin-bottom: 12px;
    font-size: 22px;
    color: var(--hal0-accent);
  }
  .uses h2 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .uses p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--hal0-fg-dim);
  }

  /* Sections */
  .sec {
    padding-block: 104px;
  }
  .sec[id],
  .two-up section[id] {
    scroll-margin-top: 64px;
  }
  .sec > span[id] {
    display: block;
    scroll-margin-top: 64px;
  }
  .sec.alt {
    border-block: 1px solid var(--hal0-border);
    background: var(--hal0-bg-elevated);
  }
  .head {
    max-width: 760px;
    margin-bottom: 52px;
  }
  .head.center {
    margin-inline: auto;
    text-align: center;
  }
