---
/**
 * /docs/concepts/ — section listing page.
 *
 * hal0's docs content moved off hal0.dev to forum.hal0.dev (Discourse
 * topics, Docs category) — src/content/docs/docs/** is gone, and every
 * individual page path 301s straight to its forum topic (see the
 * `docsRedirects` spread in astro.config.mjs, sourced from
 * src/data/docs-redirects.json). This page is the one thing that
 * doesn't redirect: a per-section map, so a reader lands somewhere with
 * an overview instead of getting bounced straight into Discourse from
 * the /docs hub.
 *
 * `<StarlightPage>` renders it inside the normal docs shell — sidebar,
 * header, footer and the site's themed chrome all behave as they do for
 * a real docs entry (the PageFrame override keys off `entry.id`, which
 * StarlightPage resolves from the URL to "docs/concepts" here, so
 * `[data-docs]` is applied as usual — this holds regardless of whether
 * any content collection entry actually exists at that id).
 *
 * The row list itself is derived from src/data/docs-forum-pages.ts by
 * SectionPageList — never hand-maintained — and every row links out to
 * the page's forum.hal0.dev topic.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SectionPageList from '../../../components/SectionPageList.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Concepts',
		description:
			'The mental model behind hal0 — slots, capabilities, stacks, memory, agents, and the hardware they run on.',
		tableOfContents: false,
	}}
>
	<p>
		How hal0 thinks. These pages explain the moving parts — what a slot is, how
		capabilities route requests, where memory lives — so the guides read as
		applications of a model you already hold, not incantations.
	</p>
	<SectionPageList section="concepts" />
</StarlightPage>
