---
/**
 * /docs — the documentation hub.
 *
 * `/docs` used to 301 straight to /docs/getting-started/, which dropped a
 * reader into the middle of Starlight with a 40-entry sidebar and no map
 * of what else exists. This page is the map: one screen that shows every
 * docs section, the whole knowledge base, and the way onward to the
 * changelog and blog — then hands off to Starlight deliberately rather
 * than by redirect.
 *
 * A MarketingLayout page, not a Starlight route, for the same reason /kb
 * is one: it is a landing surface with a card grid, not an article with a
 * sidebar and a TOC. It reuses the KB landing's `.kbcat` card idiom
 * verbatim (site-blog-kb.css) so the two hubs read as siblings.
 *
 * EVERYTHING IS DERIVED. Section cards list real pages pulled from the
 * docs collection via deriveSectionRows — the same function that renders
 * the section listing pages — so a link here can never point at a page
 * that doesn't exist, and adding a docs page needs no edit to this file.
 * Only the section blurbs (src/data/docs-sections.ts) and the KB category
 * copy (src/data/kb-categories.ts) are authored.
 */
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import '../../styles/site-blog-kb.css';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { DOCS_SECTIONS } from '../../data/docs-sections';
import { KB_CATEGORIES } from '../../data/kb-categories';
import { deriveSectionRows } from '../../lib/section-pages.mjs';

const entries = await getCollection('docs');
const collection = entries.map((e) => ({ id: e.id, filePath: e.filePath, data: e.data }));

// One card per docs section: real page titles, real hrefs, real counts.
const sections = DOCS_SECTIONS.map((s) => {
  const rows = deriveSectionRows(collection, s.slug);
  // getting-started's own index IS the docs landing page, and
  // deriveSectionRows excludes a section's index by design — so surface it
  // explicitly rather than letting the section that matters most start its
  // list at page two.
  const landing =
    s.slug === 'getting-started'
      ? collection.find((e) => e.id === 'docs/getting-started')
      : undefined;
  const pages = [
    ...(landing ? [{ title: landing.data.title as string, href: '/docs/getting-started/' }] : []),
    ...rows.map((r) => ({ title: r.title, href: r.href })),
  ];
  return { ...s, href: `/docs/${s.slug}/`, count: pages.length, pages: pages.slice(0, 4) };
});

// The three pages a first-time reader almost always wants, in order.
const START_HERE = [
  { title: 'Install hal0', href: '/docs/getting-started/install/', blurb: 'One line: fetch, verify, unpack, bring the API up.' },
  { title: 'Load your first model', href: '/docs/getting-started/first-model/', blurb: 'Pull from Hugging Face and assign it to a slot.' },
  { title: 'Send your first chat', href: '/docs/getting-started/first-chat/', blurb: 'OpenWebUI, or curl the OpenAI-compatible endpoint.' },
];

const ELSEWHERE = [
  { label: 'changelog', href: '/changelog', blurb: 'Every release, newest first — derived from CHANGELOG.md.' },
  { label: 'blog', href: '/blog', blurb: 'Releases, sweeps and post-mortems, in order.' },
  { label: 'benchmarks', href: '/benchmarks/', blurb: 'Decode, prefill and first-token, measured on one box.' },
  { label: 'profiles', href: '/profiles', blurb: 'Community hardware profiles and tuned flag bundles.' },
];
---

<MarketingLayout
  title="Documentation — hal0"
  description="Every hal0 docs section and knowledge-base category on one page: install and first run, the concepts behind slots and stacks, task guides, day-two operations, and the exact reference contracts."
>
  <div class="site">
    <div class="wrap wide phead">
      <div class="phead-row">
        <div>
          <span class="surface-tag">documentation &middot; versioned</span>
          <h1 class="site-h1" style="margin: 12px 0 10px;">everything, and where it lives</h1>
          <p class="site-body" style="max-width: 62ch;">
            Reference for the version you actually run. Start at the top if the box is new;
            otherwise every section, and the whole <a class="amber" href="/kb">knowledge base</a>,
            is one click from here.
          </p>
        </div>
      </div>
    </div>

    <div class="wrap wide">
      {/* ── the fast path in ── */}
      <span class="eyebrow">start here</span>
      <h2 class="site-h2" style="margin: 10px 0 14px;">bare box to first token</h2>
      <div class="hubstart">
        {START_HERE.map((p, i) => (
          <a class="hubstart-card" href={p.href}>
            <span class="hubstart-ord">{String(i + 1).padStart(2, '0')}</span>
            <span class="hubstart-t">{p.title}</span>
            <span class="hubstart-d">{p.blurb}</span>
          </a>
        ))}
      </div>

      {/* ── docs sections ── */}
      <div style="margin-top: 48px;">
        <span class="eyebrow">docs</span>
        <h2 class="site-h2" style="margin: 10px 0 6px;">five sections, in reading order</h2>
        <p class="site-body" style="max-width: 64ch; margin-bottom: 20px;">
          Diátaxis, roughly: learn it, then apply it, then run it, then look it up.
        </p>
        <div class="kbgrid hubgrid">
          {sections.map((s) => (
            <div class="kbcat">
              <span class="kbcat-icon"><Icon name={s.icon} width={16} height={16} /></span>
              <h3>{s.label}</h3>
              <p>{s.blurb}</p>
              <ul>
                {s.pages.map((p) => (
                  <li><a href={p.href}>{p.title}</a></li>
                ))}
              </ul>
              <a class="kbcat-all" href={s.href}>
                all {s.count} pages &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>

      {/* ── knowledge base ── */}
      <div id="knowledge-base" style="margin-top: 48px;">
        <span class="eyebrow">knowledge base</span>
        <h2 class="site-h2" style="margin: 10px 0 6px;">things that stay true</h2>
        <p class="site-body" style="max-width: 64ch; margin-bottom: 20px;">
          Undated on purpose — every page carries a last-reviewed stamp instead, and gets revised
          rather than superseded.
        </p>
        <div class="kbgrid hubgrid">
          {KB_CATEGORIES.map((cat) => (
            <div class="kbcat">
              <span class="kbcat-icon"><Icon name={cat.icon} width={16} height={16} /></span>
              <h3>{cat.label}</h3>
              <p>{cat.blurb}</p>
              <ul>
                {cat.pages.slice(0, 3).map((p) =>
                  p.href ? (
                    <li><a href={p.href}>{p.title}</a></li>
                  ) : (
                    <li><span class="planned">{p.title} &middot; planned</span></li>
                  )
                )}
              </ul>
              {/* No "open <category> →" footer link here, unlike the docs
                * section cards above: docs sections have real listing pages
                * at /docs/<section>/, whereas /kb/<category>/ is not a route —
                * only the articles beneath it are. The page links in the list
                * ARE the navigation; once inside any article, Starlight's
                * sidebar carries the rest of the category. */}
            </div>
          ))}
        </div>
      </div>

      {/* ── onward ── */}
      <div style="margin-top: 48px;">
        <span class="eyebrow">elsewhere</span>
        <h2 class="site-h2" style="margin: 10px 0 14px;">not documentation, still worth reading</h2>
        <div class="hubelse">
          {ELSEWHERE.map((e) => (
            <a class="hubelse-card" href={e.href}>
              <span class="hubelse-t mono">{e.label}</span>
              <span class="hubelse-d">{e.blurb}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</MarketingLayout>

<style>
  /* Start-here row — the numbered fast path. Same ordinal idiom as the
   * docs section listing rows (.prow .ord in site-docs.css), rendered as
   * cards because this is a landing surface, not a list page. */
  .hubstart {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .hubstart-card {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    padding: 16px;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .hubstart-card:hover {
    border-color: var(--accent-line);
  }
  .hubstart-ord {
    font-family: var(--jbm);
    font-size: 11px;
    color: var(--fg-5);
  }
  .hubstart-t {
    display: block;
    font-family: var(--jbm);
    font-size: 15px;
    color: var(--fg);
    margin-top: 8px;
  }
  .hubstart-card:hover .hubstart-t {
    color: var(--accent);
  }
  .hubstart-d {
    display: block;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--fg-3);
    margin-top: 6px;
  }

  /* Five docs sections and six KB categories both orphan their last row
   * on the /kb landing's auto-fit grid (4+1 and 4+2 at this width). Three
   * across divides both cleanly — 3+2 and 3+3 — and gives the card list
   * previews room to breathe. Below 1100px it falls back to the shared
   * auto-fit behaviour in site-blog-kb.css.
   *
   * The `.site` prefix is load-bearing: site-blog-kb.css nests `.kbgrid`
   * inside `.site`, so it compiles to `.site .kbgrid` (0,2,0) — the same
   * specificity a bare scoped `.hubgrid[data-astro-cid]` would have, and
   * the imported sheet wins the tie on source order. */
  @media (min-width: 1100px) {
    .site .hubgrid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Onward row — quieter than the section cards; these leave the docs. */
  .hubelse {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .hubelse-card {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    padding: 14px 16px;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .hubelse-card:hover {
    border-color: var(--accent-line);
  }
  .hubelse-t {
    display: block;
    font-size: 13px;
    color: var(--fg);
  }
  .hubelse-card:hover .hubelse-t {
    color: var(--accent);
  }
  .hubelse-d {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg-3);
    margin-top: 6px;
  }
</style>
