---
/**
 * PageFrame override: render Starlight's default frame, then append the
 * shared SiteFooter OUTSIDE <main> so it is a real contentinfo landmark
 * and spans full width — identical chrome to marketing pages.
 *
 * Also the seam for scoping the comp's long-form prose scale (16px/1.68,
 * 68–74ch measure — see docs/design/2026-08-09-community-comps/04 Blog
 * and KB.html) to blog posts and KB articles WITHOUT touching regular
 * docs pages. Starlight's actual page shell (`<html>`, `.content-panel`,
 * `.sl-markdown-content`) is core and not an overridable component —
 * PageFrame is the innermost slot this repo does override — so a
 * `data-longform` attribute is set on a wrapper div here, one level above
 * Starlight's own frame, and site-blog-kb.css scopes its prose rules to
 * `[data-longform] .sl-markdown-content` instead of the bare class.
 * `entry.id` is the collection slug (e.g. "blog/whats-new-in-the-v0-8-line"
 * or "kb/hardware-notes/unified-memory-is-not-vram"); plain docs pages
 * ("docs/...") never match. The `[data-longform]` wrapper div itself is
 * only rendered for those matching pages — not rendered-but-attributeless
 * for everyone else — so a docs page's DOM is byte-identical to before
 * this wrapper existed (verified: `dist/docs/**` diffs clean against the
 * pre-wrapper build; no incidental extra `<div>` on every Starlight page).
 *
 * `data-docs` is the mirror-image seam added for the docs-shape pass (see
 * docs/design/2026-08-09-community-comps/08 Docs.html): docs pages get
 * their own attribute for docs-only chrome (the LinkCard grid, state-table
 * headers, the landing page's Sections cards) that has no blog/KB
 * equivalent, plus a page-title/TOC/pager treatment that IS shared with
 * blog (see `data-blog` below). Every Starlight-rendered entry.id is
 * exactly one of docs/blog/kb, so this if/else is exhaustive — no third,
 * attributeless case exists among Starlight routes.
 *
 * Reading measure (68ch, 16px/1.68) is shared across ALL THREE surfaces —
 * `site-blog-kb.css`'s prose rule matches `:is([data-longform],
 * [data-docs])`, i.e. every Starlight route — per the operator's site-wide
 * baseline: "all pages must fit the same width/layout system as the KB
 * page — same content measure, container widths, and gutter rhythm."
 * (An earlier pass here kept docs prose at the comp's literal, denser
 * docs-article spec — 15.5px/1.68 @ 74ch vs. 16px/1.68 @ 68ch for
 * blog/KB — before that broader instruction landed and superseded it.)
 *
 * `data-blog` is an ADDITIONAL attribute (not a branch) on the same
 * `[data-longform]` wrapper, only for entry.id starting "blog/". It exists
 * so the docs-shape pass can also polish a few blog-only chrome elements
 * (page-title, TOC, pager) that the comp draws IDENTICALLY for docs and
 * blog — site-docs.css shares those rules via `:is([data-docs],
 * [data-blog])` — WITHOUT touching KB: `[data-longform]` itself, and
 * every existing rule scoped to it, is untouched, so KB's build output
 * stays byte-for-byte identical; only `[data-blog]`-scoped selectors (new,
 * additive) can ever affect blog.
 */
import Default from '@astrojs/starlight/components/PageFrame.astro';
import SiteFooter from './SiteFooter.astro';

const { entry } = Astro.locals.starlightRoute;
const isBlog = entry.id.startsWith('blog/');
const isLongForm = isBlog || entry.id.startsWith('kb/');
const isDocs = entry.id.startsWith('docs/');
---
{isLongForm ? (
  <div data-longform data-blog={isBlog ? true : undefined}>
    <Default>
      <slot name="header" slot="header" />
      <slot name="sidebar" slot="sidebar" />
      <slot />
    </Default>
  </div>
) : isDocs ? (
  <div data-docs>
    <Default>
      <slot name="header" slot="header" />
      <slot name="sidebar" slot="sidebar" />
      <slot />
    </Default>
  </div>
) : (
  <Default>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </Default>
)}
{/* Search-palette source tags (handoff 3.5 Tier B) — annotates Pagefind
  * result rows with a docs/kb/blog tag; see public/js/search-source-tags.js.
  * Rendered from HERE, not the global `head` config, and only on docs/blog
  * pages: a head script would land in every page's HTML including
  * dist/kb/** and break the KB byte-parity invariant. Cost: the modal
  * opened FROM a KB page shows untagged rows — accepted, parity wins. */}
{(isDocs || isBlog) && <script is:inline src="/js/search-source-tags.js" defer />}
<SiteFooter />
