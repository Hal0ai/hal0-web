---
/**
 * Faq: the visible questions. The page builds its FAQPage schema from the same
 * FAQ array in src/data/landing.ts, so the markup and the schema cannot drift.
 * Answers are plain text; API paths inside them render as code here.
 */
import { FAQ } from '../../data/landing';

const API_PATH = /(\/v1\/[a-z/]+)/;
---

<div class="faq">
  {FAQ.map(({ q, a }, i) => (
    <details open={i < 2}>
      <summary>{q}</summary>
      <p>{a.split(API_PATH).map((part, n) => (n % 2 === 1 ? <code>{part}</code> : part))}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 32px;
    align-items: start;
  }
  details {
    padding: 14px 0;
    border-top: 1px solid var(--hal0-border);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--hal0-font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--hal0-fg);
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex-shrink: 0;
    color: var(--hal0-accent);
  }
  details[open] summary::after {
    content: '−';
  }
  p {
    margin: 10px 0 0;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--hal0-fg-muted);
    overflow-wrap: anywhere;
  }
  code {
    font-size: 12.5px;
    color: var(--hal0-fg);
  }

  @media (max-width: 720px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
