---
/**
 * BenchHighlights: headline figures from the first-party sweep, compact enough
 * for half a row on the landing page. The full table lives on /benchmarks.
 *
 * Source of truth: ROSTER in src/data/model-roster.ts, the same sweep /benchmarks
 * reads. Figures are measured runs only, and the link carries the sweep's date.
 */
import { ROSTER, ROSTER_MEASURED, ROSTER_DATE } from '../../data/model-roster';

const BENCH_HREF = '/benchmarks';

const measured = ROSTER.filter((r) => r.measured && r.dec != null);
const fastestDecode = measured.reduce((max, r) => Math.max(max, r.dec ?? 0), 0);
const peakPrefill = measured.reduce((max, r) => Math.max(max, r.pf ?? 0), 0);
---

<section class="sec bench-sec">
  <div class="sec-h">
    <div>
      <span class="eyebrow">first-party sweep</span>
      <h2 class="site-h2">what this box does</h2>
    </div>
    <a href={BENCH_HREF} class="mono sec-link">all {ROSTER.length} models · sweep {ROSTER_DATE} →</a>
  </div>
  <a class:list={['benchstrip', 'card-hover']} href={BENCH_HREF} aria-label="View the full model roster benchmark">
    <div class="figs">
      <div class="fig">
        <div class="n">{fastestDecode.toFixed(1)}</div>
        <div class="label">fastest decode · tok/s</div>
      </div>
      <div class="fig">
        <div class="n plain">{ROSTER_MEASURED}</div>
        <div class="label">models measured</div>
      </div>
      <div class="fig">
        <div class="n plain">{peakPrefill.toFixed(0)}</div>
        <div class="label">peak prefill · tok/s</div>
      </div>
    </div>
  </a>
</section>

<style>
  .bench-sec {
    padding-block: 52px 0;
  }
  .sec-h {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .sec-h .site-h2 {
    margin: 8px 0 0;
  }
  .sec-link {
    font-size: 12px;
    color: var(--fg-3);
    text-decoration: none;
  }
  .sec-link:hover {
    color: var(--accent);
  }
  .benchstrip {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .figs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 18px;
  }
  .fig .n {
    font-family: var(--jbm);
    font-size: 26px;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-feature-settings: var(--num-features);
  }
  .fig .n.plain {
    color: var(--fg);
  }
  @media (max-width: 560px) {
    .figs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
