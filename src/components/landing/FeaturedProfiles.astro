---
/**
 * FeaturedProfiles — homepage section (c): featured profiles.
 *
 * Three profiles a visitor can import. A profile with a measured run in the
 * roster (joined the same way /profiles does, src/lib/profiles-join.mjs) comes
 * first, ranked by headline decode tok/s, and shows that number. The
 * remaining places go to importable profiles in registry order, which show
 * the first setting they make instead: a card never carries a borrowed or
 * missing metric. Built-in profiles are left out, since they are already on
 * every box. The full gallery lives at /profiles.
 *
 * Cards link to /profiles?p=<slug>, the deep-link convention the profile
 * detail drawer already listens for.
 */
import profilesSnapshot from '../../data/profiles.json';
import { benchFor } from '../../lib/profiles-join.mjs';
import { isSeed, tuneFacts } from '../../lib/profile-envelope.mjs';
import { ROSTER } from '../../data/model-roster';

const FEATURED_COUNT = 3;

const candidates = profilesSnapshot.profiles
  .filter((record) => !isSeed(record))
  .map((record) => ({ record, bench: benchFor(record, ROSTER), fact: tuneFacts(record)[0] }));

const benched = candidates
  .filter((c) => c.bench.headline)
  .sort((a, b) => (b.bench.headline?.dec ?? 0) - (a.bench.headline?.dec ?? 0));
const unbenched = candidates.filter((c) => !c.bench.headline);

const featured = [...benched, ...unbenched].slice(0, FEATURED_COUNT);
---

{featured.length > 0 && (
  <section class="sec">
    <div class="sec-h">
      <div>
        <span class="eyebrow">profiles</span>
        <h2 class="site-h2">tuned settings you can import in one step</h2>
      </div>
      <a href="/profiles" class="mono sec-link">all profiles →</a>
    </div>
    <div class="cards3">
      {featured.map(({ record, bench, fact }) => (
        <a class:list={['pmini', 'card-hover']} href={`/profiles?p=${record.profile.slug}`}>
          <div class="pmini-top">
            <span class="slug mono">{record.profile.slug}</span>
            <span class="chip amber">{record.profile.intent}</span>
          </div>
          <p class="site-sm pmini-desc">{record.profile.summary}</p>
          <div class="pmini-foot">
            {bench.headline ? (
              <span class="mono pmini-dec">{bench.headline.dec.toFixed(1)}<u>tok/s</u></span>
            ) : (
              <span class="mono pmini-dec">{fact ? <>{fact.value}<u>{fact.label}</u></> : record.runtime?.family}</span>
            )}
            {record.profile.first_party ? (
              <span class="chip amber">first-party</span>
            ) : (
              <span class="pmini-author">
                <img
                  src={`https://github.com/${record.profile.author}.png?size=32`}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                />
                <span class="mono">@{record.profile.author}</span>
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .sec {
    padding-block: 52px 0;
  }
  .sec-h {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .sec-h .site-h2 {
    margin: 8px 0 0;
  }
  .sec-link {
    font-size: 12px;
    color: var(--fg-3);
    text-decoration: none;
  }
  .sec-link:hover {
    color: var(--accent);
  }
  .cards3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .pmini {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .pmini-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .slug {
    font-size: 13px;
    color: var(--fg);
  }
  .pmini-desc {
    margin: 0;
  }
  .pmini-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line-soft);
    padding-top: 10px;
  }
  .pmini-dec {
    color: var(--fg);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .pmini-dec u {
    text-decoration: none;
    color: var(--fg-4);
    font-size: 10px;
    margin-left: 3px;
  }
  .pmini-author {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--fg-3);
  }
  .pmini-author img {
    border-radius: var(--rad-sm);
  }
  @media (max-width: 1080px) {
    .cards3 {
      grid-template-columns: 1fr;
    }
  }

  /* Phone: labels that are 10 to 11px on a desktop are too small to read here.
   * Below 640px they get a floor of about 12px; wider screens keep the dense scale. */
  @media (max-width: 640px) {
    .pmini-author {
      font-size: 12px;
    }
    .pmini-dec u {
      font-size: 11.5px;
    }
  }
</style>
