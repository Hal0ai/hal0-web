---
/**
 * DashboardTour: the dashboard, one tab per page, with a real capture in each.
 *
 * Stops come from TOUR in src/data/landing.ts and every capture goes through
 * <Shot>, so it gets AVIF and WebP, the right size, and the lightbox. Several
 * captures carry sample readings; TOUR_NOTE under the panels says so, and the
 * tour is kept away from the benchmark figures.
 *
 * Tabs follow the WAI-ARIA pattern (roving tabindex, arrow keys, Home and End).
 * Without the script every panel is visible, one after another: the panels are
 * hidden by the script, not in the markup.
 */
import { Icon } from 'astro-icon/components';
import Shot from '../Shot.astro';
import { TOUR, TOUR_NOTE } from '../../data/landing';
---

<div class="tour" data-tour>
  <div class="tabs" role="tablist" aria-label="Dashboard tour">
    {TOUR.map((stop, i) => (
      <button
        type="button"
        role="tab"
        id={`tour-tab-${stop.key}`}
        aria-controls={`tour-panel-${stop.key}`}
        aria-selected={i === 0 ? 'true' : 'false'}
      >
        {stop.label}
      </button>
    ))}
  </div>

  {TOUR.map((stop) => (
    <div class="stop" role="tabpanel" id={`tour-panel-${stop.key}`} aria-labelledby={`tour-tab-${stop.key}`}>
      <div class="stop-copy">
        <h3>{stop.title}</h3>
        <p>{stop.body}</p>
        <ul>
          {stop.points.map((point) => (
            <li><Icon name="lucide:check" /><span>{point}</span></li>
          ))}
        </ul>
        <a class="stop-link" href={stop.link.href}>{stop.link.label} →</a>
      </div>
      <div class="stop-shot">
        <Shot name={stop.shot} alt={stop.alt} />
      </div>
    </div>
  ))}

  <p class="tour-note">{TOUR_NOTE}</p>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-tour]').forEach((tour) => {
      const tabs = [...tour.querySelectorAll('[role="tab"]')];
      const panelOf = (tab) => document.getElementById(tab.getAttribute('aria-controls'));
      const select = (tab, focus) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          panelOf(t).hidden = !on;
        });
        if (focus) tab.focus();
      };
      tour.classList.add('is-tabbed');
      select(tabs[0], false);
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab, false));
        tab.addEventListener('keydown', (e) => {
          const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
          if (to === undefined) return;
          e.preventDefault();
          select(tabs[(to + tabs.length) % tabs.length], true);
        });
      });
    });
  })();
</script>

<style>
  /* The tab strip only makes sense once the script has hidden the other panels. */
  .tabs {
    display: none;
    gap: 4px;
    overflow-x: auto;
    border-bottom: 1px solid var(--hal0-border);
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .is-tabbed .tabs {
    display: flex;
  }
  .tabs button {
    flex-shrink: 0;
    padding: 12px 18px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    color: var(--hal0-fg-dim);
    cursor: pointer;
    transition: color var(--hal0-dur) var(--hal0-ease), border-color var(--hal0-dur) var(--hal0-ease);
  }
  .tabs button:hover {
    color: var(--hal0-fg);
  }
  .tabs button[aria-selected='true'] {
    border-bottom-color: var(--hal0-accent);
    color: var(--hal0-accent);
  }
  .tabs button:focus-visible {
    outline: 2px solid var(--hal0-accent);
    outline-offset: -2px;
  }

  .stop {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: 48px;
    align-items: center;
    padding-top: 36px;
  }
  .stop[hidden] {
    display: none;
  }
  .stop + .stop {
    margin-top: 28px;
  }
  .is-tabbed .stop + .stop {
    margin-top: 0;
  }
  h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 620;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--hal0-fg);
    text-wrap: balance;
  }
  .stop-copy > p {
    margin: 14px 0 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--hal0-fg-muted);
    text-wrap: pretty;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--hal0-fg-muted);
  }
  li :global(svg) {
    width: 1em;
    height: 1em;
    margin-top: 4px;
    color: var(--hal0-ok);
  }
  .stop-link {
    display: inline-block;
    margin-top: 20px;
    font-size: 15px;
    color: var(--hal0-accent);
    text-decoration: none;
  }
  .stop-link:hover {
    text-decoration: underline;
  }
  .stop-shot :global(.shot) {
    width: 100%;
    margin: 0;
    border-radius: 12px;
    box-shadow: 0 30px 80px -40px var(--hal0-accent-glow);
  }
  .stop-shot :global(img) {
    width: 100%;
    height: auto;
  }
  .tour-note {
    margin: 22px 0 0;
    font-size: 13.5px;
    color: var(--hal0-fg-dim);
  }

  @media (max-width: 1000px) {
    .stop {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-top: 28px;
    }
  }
  /* On a phone six tabs do not fit in one row, and a strip that scrolls hides the last
   * ones with no sign that they exist. Two rows of three keep every tab on screen. */
  @media (max-width: 560px) {
    .is-tabbed .tabs {
      flex-wrap: wrap;
      overflow-x: visible;
      gap: 0;
    }
    .tabs button {
      flex: 1 0 33.33%;
      padding-inline: 6px;
      text-align: center;
    }
  }
</style>
