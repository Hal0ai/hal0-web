---
/**
 * ForumTopics — homepage community layer, section (b): latest forum
 * topics.
 *
 * forum.hal0.dev is not live yet. Per the homepage design
 * (docs/design/2026-08-09-community-comps/README.md, screen 6) this strip
 * is code-present but renders nothing — no skeleton, no error card — when
 * the Discourse API is unreachable at build time (DISCOURSE_URL unset).
 * The page closes up around it; the header nav's forum link stays hidden
 * via nav.json until launch, and this component starts rendering the
 * moment DISCOURSE_URL is set in the build environment.
 */
import { fetchLatestTopics } from '../../lib/forum';
import { header } from '../../lib/nav';

const forumHref = header.find((l) => l.label === 'forum')?.href ?? 'https://forum.hal0.dev';
const topics = await fetchLatestTopics();
---

{topics && topics.length > 0 && (
  <section class="sec">
    <div class="sec-h">
      <div>
        <span class="eyebrow">forum.hal0.dev</span>
        <h2 class="site-h2">what people are working on</h2>
      </div>
      <a href={forumHref} rel="noopener" class="mono sec-link">open the forum ↗</a>
    </div>
    <div class="topics">
      {topics.map((t) => (
        <a class="topic" href={t.href} rel="noopener">
          <span class="t">{t.title}</span>
          <span class="cat">{t.category}</span>
          <span class="n">{t.replies} replies</span>
          <span class="who">
            {t.authorAvatar && <img src={t.authorAvatar} alt="" width="20" height="20" class="avatar" loading="lazy" />}
            <span class="mono who-name">@{t.author}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .sec {
    padding-block: 52px 0;
  }
  .sec-h {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .sec-h .site-h2 {
    margin: 8px 0 0;
  }
  .sec-link {
    font-size: 12px;
    color: var(--fg-3);
    text-decoration: none;
  }
  .sec-link:hover {
    color: var(--accent);
  }
  .topics {
    border: 1px solid var(--line);
    border-radius: var(--rad-lg);
    background: var(--bg-1);
    overflow: hidden;
  }
  .topic {
    display: grid;
    grid-template-columns: 1fr 130px 74px 120px;
    gap: 14px;
    align-items: center;
    padding: 12px 16px;
    border-top: 1px solid var(--line-soft);
    text-decoration: none;
    color: inherit;
  }
  .topic:first-of-type {
    border-top: 0;
  }
  .topic:hover {
    background: var(--bg-2);
  }
  .topic .t {
    font-size: 14px;
    color: var(--fg-2);
  }
  .topic:hover .t {
    color: var(--accent);
  }
  .topic .cat {
    font-family: var(--jbm);
    font-size: 10.5px;
    color: var(--fg-4);
  }
  .topic .n {
    font-family: var(--jbm);
    font-size: 11.5px;
    color: var(--fg-3);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .topic .who {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }
  .who-name {
    font-size: 11px;
    color: var(--fg-3);
  }
  .avatar {
    border-radius: var(--rad-sm);
  }
  @media (max-width: 1080px) {
    .topic {
      grid-template-columns: 1fr 90px;
    }
    .topic .cat,
    .topic .who {
      display: none;
    }
  }
</style>
