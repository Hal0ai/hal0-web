---
/**
 * ForumDiscussLink — the "discuss on the forum ↗" byline link from the
 * post-page spec in docs/design/2026-08-09-community-comps/04 Blog and KB.html.
 * starlight-blog's own Metadata.astro (byline/date/author row) is plugin-owned,
 * so this renders as a small addendum a post drops in manually rather than a
 * fork of the plugin component.
 *
 * The href comes from nav.json's forum entry, so the link text and the target
 * cannot drift apart — every post importing this component follows the nav.
 */
import { header } from '../lib/nav';

const forum = header.find((l) => l.label === 'forum');
const forumHref = forum?.href ?? 'https://forum.hal0.dev';
---

<p class="forum-discuss not-content">
  <a href={forumHref} rel="noopener">discuss on the forum &#8599;</a>
</p>

<style>
  .forum-discuss {
    margin: -0.75rem 0 1.5rem;
    font-family: var(--hal0-font-mono);
    font-size: 12px;
  }
  .forum-discuss a {
    color: var(--hal0-fg-dim);
  }
  .forum-discuss a:hover {
    color: var(--hal0-accent);
  }
</style>
