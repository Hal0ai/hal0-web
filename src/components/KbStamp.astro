---
/**
 * KbStamp — the badge every knowledge-base article opens with, per the
 * "distinction" spec in docs/design/2026-08-09-community-comps/README.md:
 * docs are versioned reference, blog is dated and authored, KB is
 * "undated, reviewed and community-editable" — same chrome, same type,
 * only the surface tag and the stamp differ. Ported from the comp's
 * `.surface-tag` + byline row (`04 Blog and KB.html`).
 *
 * `category` and `reviewed` are read from the current page's own
 * frontmatter (`kbCategory` / `reviewed` in content.config.ts's docs
 * schema extension) via Astro.locals.starlightRoute — not passed as
 * props — so each is a single source of truth instead of being
 * hand-typed twice per page (once in frontmatter, once in a prop). The
 * edit link is derived from the entry's real file path unless overridden.
 *
 * Usage: drop straight into the top of a kb/**\/*.mdx body (Starlight/MDX
 * files don't get a shared layout slot to inject this from, so each KB
 * page imports and renders it once, right under its H1):
 *
 *   <KbStamp />
 */
interface Props {
  editHref?: string;
}

const { editHref } = Astro.props;
const { entry } = Astro.locals.starlightRoute;
const { kbCategory: category, reviewed } = entry.data;

if (!category || !reviewed) {
  throw new Error(
    `<KbStamp /> used on '${entry.id}', which is missing 'kbCategory' and/or 'reviewed' frontmatter.`,
  );
}

const resolvedEditHref =
  editHref ?? `https://github.com/hal0ai/hal0-web/edit/master/${entry.filePath}`;
---

<p class="kb-stamp not-content">
  <span class="kb-surface-tag">knowledge base &middot; {category}</span>
  <span class="kb-stamp-sep">&middot;</span>
  <span>reviewed {reviewed}</span>
  <span class="kb-stamp-sep">&middot;</span>
  <a href={resolvedEditHref} rel="noopener">suggest an edit &#8599;</a>
</p>

<style>
  .kb-stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 10px 0 24px;
    font-family: var(--hal0-font-mono);
    font-size: 11.5px;
    color: var(--hal0-fg-faint);
  }
  .kb-stamp a {
    color: var(--hal0-fg-dim);
  }
  .kb-stamp a:hover {
    color: var(--hal0-accent);
  }
  .kb-stamp-sep {
    color: var(--hal0-fg-ghost);
  }
  .kb-surface-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-transform: uppercase;
    letter-spacing: var(--hal0-ls-label);
    color: var(--hal0-accent);
    font-size: 10px;
  }
  .kb-surface-tag::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hal0-accent);
    box-shadow: 0 0 6px var(--hal0-accent);
  }
</style>
