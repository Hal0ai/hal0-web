---
/**
 * Numbered page listing for a docs section — the comp's Category view
 * (docs/design/2026-08-09-community-comps/08 Docs.html, `.plist`/`.prow`:
 * ordinal, mono title + description, right-aligned marker). Every row now
 * links straight out to the page's forum.hal0.dev topic (hal0's docs
 * moved off hal0.dev) instead of an in-site route, so the trailing marker
 * reads "forum ↗" rather than a source filename.
 *
 * Rows derive from src/data/docs-forum-pages.ts (generated, never
 * hand-maintained); the ordering/exclusion logic lives in
 * src/lib/section-pages.mjs so it is unit-testable. Styles in
 * site-docs.css under `[data-docs]`.
 */
import { DOCS_FORUM_PAGES } from '../data/docs-forum-pages';
import { deriveForumSectionRows } from '../lib/section-pages.mjs';

interface Props {
	section: string;
}
const { section } = Astro.props;

const rows = deriveForumSectionRows(DOCS_FORUM_PAGES, section);
---

<div class="plist not-content">
	{
		rows.map((r) => (
			<a class="prow" href={r.href} rel="noopener">
				<span class="ord">{r.ord}</span>
				<span>
					<span class="t">{r.title}</span>
					{r.description && <span class="d">{r.description}</span>}
				</span>
				<span class="f">forum &rarr;</span>
			</a>
		))
	}
</div>
