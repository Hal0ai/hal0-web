---
/**
 * The docs landing page's "Sections" card grid (comp: 08 Docs.html
 * `.seccards`/`.seccard`).
 *
 * This exists as a COMPONENT rather than inline MDX for two reasons:
 *
 * 1. The landing page it appears on lives in the mirrored, generated
 *    tree (`src/content/docs/docs/getting-started/index.mdx` — see the
 *    `_README.md` there). Anything inline in that file is overwritten by
 *    the next mirror sync, which is exactly how the previous version was
 *    lost. Upstream now carries a bare import + `<DocsSectionCards />`,
 *    and all the presentation — icons, copy, markup, the `astro-icon`
 *    dependency — stays here on the web side where it belongs.
 *
 * 2. Page counts are DERIVED from the content collection. The previous
 *    version carried them as literals guarded by a drift test, because
 *    deriving them inside MDX genuinely doesn't work (MDX splits
 *    `export const`-visible bindings from same-file helpers into
 *    separate chunks, so a `.filter().length` helper reads as "not
 *    defined" at render; an inline `await` IIFE in the initializer fails
 *    to parse outright). In a plain `.astro` component none of that
 *    applies — a top-level `await getCollection()` is just normal code,
 *    so the counts cannot go stale and the guard test is unnecessary.
 *
 * `reference` counts its nested `api/` subgroup, matching how the
 * sidebar nests it. Styles live in site-docs.css under `[data-docs]`.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { DOCS_SECTIONS } from '../data/docs-sections';

const entries = await getCollection('docs');
// Count the section's own index entry too where one exists (only
// getting-started has one — it IS the docs landing page). Without this
// the card would advertise 7 while the sidebar's "Start here" group
// lists 8, since the landing page's id has no trailing segment.
const cards = DOCS_SECTIONS.map((s) => ({
	...s,
	href: `/docs/${s.slug}/`,
	count: entries.filter(
		(e) => e.id === `docs/${s.slug}` || e.id.startsWith(`docs/${s.slug}/`),
	).length,
}));
---

<div class="seccards">
	{
		cards.map((s) => (
			<a class="seccard" href={s.href}>
				<span class="seccard-icon">
					<Icon name={s.icon} width={16} height={16} />
				</span>
				<h3>{s.label}</h3>
				<p>{s.blurb}</p>
				<span class="seccard-count">{s.count} pages &rarr;</span>
			</a>
		))
	}
</div>
