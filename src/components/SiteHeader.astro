---
/**
 * SiteHeader — Astro port of the comp's Header/Drawer (site-chrome.jsx,
 * variant="site"). 56px bar: wordmark left, visibleHeader nav centre,
 * GitHub/Discord iconbtns + burger right. Below 1000px the nav collapses
 * into a burger-triggered `.drawer` with the same links + icon foot.
 *
 * Props:
 *   tone? – "solid" (default) | "transparent". Transparent starts with
 *           the `.ontop` class (bare, for a full-bleed hero) and promotes
 *           to solid once scrolled past 80% of the viewport height — see
 *           the inline scroll watcher below.
 */
import Wordmark from './Wordmark.astro';
import DiscordIcon from './DiscordIcon.astro';
import GithubIcon from './GithubIcon.astro';
import { visibleHeader, isActive, ariaCurrent, getSocial } from '../lib/nav';

interface Props {
  tone?: 'solid' | 'transparent';
}

const { tone = 'solid' } = Astro.props;

const path = Astro.url.pathname;
const github = getSocial('github');
const discord = getSocial('discord');

// Comp shows the external link's host (e.g. "forum.hal0.dev") as a title
// tooltip via a manually-authored `host` field; nav.json only carries the
// full href, so derive the hostname from it for `external` entries.
const hostOf = (href: string) => {
  try {
    return new URL(href).hostname;
  } catch {
    return undefined;
  }
};
---

<header class:list={['hdr', 'sticky', { ontop: tone === 'transparent' }]} data-tone={tone}>
  <div class="wrap wide hdr-in">
    <a class="hdr-brand" href="/" aria-label="hal0 home">
      <Wordmark size="text-xl" />
    </a>
    <nav class="hdr-nav" aria-label="Site">
      {visibleHeader.map((l) => {
        const active = isActive(path, l);
        return (
          <a
            href={l.href}
            class:list={[{ on: active }]}
            aria-current={ariaCurrent(path, l)}
            rel={l.external ? 'noopener' : undefined}
            title={l.external ? hostOf(l.href) : undefined}
          >
            {l.label}
            {l.external && <span class="ext">↗</span>}
          </a>
        );
      })}
    </nav>
    <div class="hdr-right">
      <a class="iconbtn" href={github.href} rel="noopener" aria-label="GitHub">
        <GithubIcon size={16} />
      </a>
      <a class="iconbtn" href={discord.href} rel="noopener" aria-label="Discord">
        <DiscordIcon size={15} />
      </a>
      <button class="iconbtn hdr-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-drawer" id="site-drawer-toggle">
        <svg class="icon-menu" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M2 4.5h12M2 8h12M2 11.5h12" />
        </svg>
        <svg class:list={['icon-close', 'is-hidden']} width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="drawer" id="site-drawer" aria-label="Menu" hidden>
    {visibleHeader.map((l) => {
      const active = isActive(path, l);
      return (
        <a
          href={l.href}
          class:list={['row', { on: active }]}
          aria-current={ariaCurrent(path, l)}
          rel={l.external ? 'noopener' : undefined}
        >
          <span>{l.label}</span>
          <span class="mono" style="font-size: 11px; color: var(--fg-4);">{l.external ? '↗' : ''}</span>
        </a>
      );
    })}
    <div class="foot">
      <a class="iconbtn" href={github.href} rel="noopener" aria-label="GitHub">
        <GithubIcon size={16} />
      </a>
      <a class="iconbtn" href={discord.href} rel="noopener" aria-label="Discord">
        <DiscordIcon size={15} />
      </a>
    </div>
  </nav>
</header>

<style>
  .is-hidden {
    display: none;
  }
</style>

<script>
  // Burger toggle — no framework. Opens/closes the drawer, syncs aria,
  // locks body scroll while open, closes on Escape / link click / an
  // outside click (there's no scrim to click, so any click landing
  // outside the header dismisses it), and resets if the viewport grows
  // back past the 1000px breakpoint where the drawer is hidden anyway.
  // Focus trapping is explicitly out of scope for this pass.
  (() => {
    const header = document.querySelector('header.hdr');
    const btn = document.getElementById('site-drawer-toggle');
    const drawer = document.getElementById('site-drawer');
    if (!header || !btn || !drawer) return;
    const menuIcon = btn.querySelector('.icon-menu');
    const closeIcon = btn.querySelector('.icon-close');
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.hidden = !open;
      menuIcon?.classList.toggle('is-hidden', open);
      closeIcon?.classList.toggle('is-hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => setOpen(Boolean(drawer.hidden)));
    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (drawer.hidden) return;
      if (!header.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (m) => {
      if (m.matches) setOpen(false);
    });
  })();
</script>

<script>
  // Scroll-aware promotion of a transparent (hero) header to solid —
  // mirrors the comp's `.hdr.ontop` state. Only wired up for headers
  // whose data-tone is "transparent"; solid headers are inert here.
  // Tiny + passive, rAF-throttled so it stays cheap on long scrolls.
  (() => {
    const hdr = document.querySelector('header.hdr[data-tone="transparent"]');
    if (!hdr) return;
    const threshold = () => window.innerHeight * 0.8;
    let ticking = false;
    const sync = () => {
      ticking = false;
      hdr.classList.toggle('ontop', window.scrollY <= threshold());
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };
    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  })();
</script>
