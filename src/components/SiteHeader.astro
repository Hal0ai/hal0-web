---
/**
 * SiteHeader — Astro port of the comp's Header/Drawer (site-chrome.jsx,
 * variant="site"). 56px bar: wordmark left, visibleHeader nav centre,
 * GitHub/Discord iconbtns + burger right. Below 1000px the nav collapses
 * into a burger-triggered `.drawer` with the same links + icon foot.
 *
 * Props:
 *   tone? – "solid" (default) | "transparent". Transparent starts with
 *           the `.ontop` class (bare, for a full-bleed hero) and promotes
 *           to solid once scrolled past 80% of the viewport height — see
 *           the inline scroll watcher below.
 */
import Wordmark from './Wordmark.astro';
import DiscordIcon from './DiscordIcon.astro';
import GithubIcon from './GithubIcon.astro';
import { flatHeader, isActive, ariaCurrent, getSocial } from '../lib/nav';

interface Props {
  tone?: 'solid' | 'transparent';
}

const { tone = 'solid' } = Astro.props;

const path = Astro.url.pathname;
const github = getSocial('github');
const discord = getSocial('discord');

// Comp shows the external link's host (e.g. "forum.hal0.dev") as a title
// tooltip via a manually-authored `host` field; nav.json only carries the
// full href, so derive the hostname from it for `external` entries.
const hostOf = (href: string) => {
  try {
    return new URL(href).hostname;
  } catch {
    return undefined;
  }
};
---

<header class:list={['hdr', 'sticky', { ontop: tone === 'transparent' }]} data-tone={tone}>
  <div class="wrap wide hdr-in">
    <a class="hdr-brand" href="/" aria-label="hal0 home">
      <Wordmark size="text-xl" />
    </a>
    <nav class="hdr-nav" aria-label="Site">
      {flatHeader.map((l) => {
        const active = isActive(path, l);
        return (
          <a
            href={l.href}
            class:list={[{ on: active }]}
            aria-current={ariaCurrent(path, l)}
            rel={l.external ? 'noopener' : undefined}
            title={l.external ? hostOf(l.href) : undefined}
          >
            {l.label}
            {l.external && <span class="ext">↗</span>}
          </a>
        );
      })}
    </nav>
    <div class="hdr-right">
      <button class="searchbtn desk" type="button" data-site-search-open aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5L14 14" />
        </svg>
        Search
        <span class="k">Ctrl K</span>
      </button>
      <span class="hdr-sep desk"></span>
      <a class="iconbtn" href={github.href} rel="noopener" aria-label="GitHub">
        <GithubIcon size={16} />
      </a>
      <a class="iconbtn" href={discord.href} rel="noopener" aria-label="Discord">
        <DiscordIcon size={15} />
      </a>
      <button class="iconbtn" type="button" data-theme-toggle aria-label="Toggle theme">
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
          <circle cx="8" cy="8" r="3.4" /><path d="M8 .9v2M8 13.1v2M.9 8h2M13.1 8h2M2.98 2.98l1.41 1.41M11.61 11.61l1.41 1.41M13.02 2.98l-1.41 1.41M4.39 11.61l-1.41 1.41" />
        </svg>
        <svg class="icon-moon is-hidden" width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M13.5 9.8A6 6 0 0 1 6.2 2.5 6 6 0 1 0 13.5 9.8Z" />
        </svg>
      </button>
      <!--
        Discourse SSO auth affordance — bell + avatar (comp: "Header").
        Anchor only; stays [hidden] (renders nothing) until the client
        script confirms a signed-in session via /api/auth/session, per
        the signed-out chrome staying byte-identical to today's. The
        forum's origin is deliberately NOT baked into this markup or the
        script below (it comes back from /api/auth/session's `forum_url`
        field at runtime instead): the forum's nav entry is still hidden
        in nav.json pre-launch, and a chrome-consistency test pins that no
        static page may reveal that hostname until that flips.
      -->
      <div class="hdr-auth desk" id="hdr-auth" hidden>
        <a class="iconbtn hdr-bell" id="hdr-auth-bell" href="#" aria-label="Notifications">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 1.5a4 4 0 0 0-4 4v2.3c0 .5-.16 1-.47 1.4L2.5 10.7c-.5.65-.04 1.6.78 1.6h9.44c.82 0 1.28-.95.78-1.6l-1.03-1.5a2.3 2.3 0 0 1-.47-1.4V5.5a4 4 0 0 0-4-4Z" />
            <path d="M6.3 13.5a1.9 1.9 0 0 0 3.4 0" />
          </svg>
          <span class="pip" id="hdr-auth-pip" hidden></span>
        </a>
        <a class="hdr-avatar" id="hdr-auth-avatar" href="#" aria-label="Your account">
          <img id="hdr-auth-avatar-img" width="22" height="22" alt="" />
        </a>
      </div>
      <button class="iconbtn hdr-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-drawer" id="site-drawer-toggle">
        <svg class="icon-menu" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M2 4.5h12M2 8h12M2 11.5h12" />
        </svg>
        <svg class:list={['icon-close', 'is-hidden']} width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="drawer" id="site-drawer" aria-label="Menu" hidden>
    {flatHeader.map((l) => {
      const active = isActive(path, l);
      return (
        <a
          href={l.href}
          class:list={['row', { on: active }]}
          aria-current={ariaCurrent(path, l)}
          rel={l.external ? 'noopener' : undefined}
        >
          <span>{l.label}</span>
          <span class="mono" style="font-size: 11px; color: var(--fg-4);">{l.external ? '↗' : ''}</span>
        </a>
      );
    })}
    <div class="foot">
      <a class="iconbtn" href={github.href} rel="noopener" aria-label="GitHub">
        <GithubIcon size={16} />
      </a>
      <a class="iconbtn" href={discord.href} rel="noopener" aria-label="Discord">
        <DiscordIcon size={15} />
      </a>
      <button class="searchbtn" type="button" data-site-search-open aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5L14 14" />
        </svg>
        Search
      </button>
    </div>
  </nav>
</header>

<style>
  .is-hidden {
    display: none;
  }

  /* Discourse SSO bell + avatar — self-contained here rather than pulled
     from site-data.css's inert `.avatar`/`.pip` specimens, since this is
     the only place in the header that needs them. Reuses the same token
     aliases (`--accent`, `--fg-3`, `--line`, `--rad-sm`) site.css exposes
     via the `.site` class on <body>, which every page wrapping this
     component carries. */
  .hdr-auth {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .hdr-auth[hidden] {
    display: none;
  }
  .hdr-bell {
    position: relative;
  }
  .hdr-bell .pip {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent, #ffb000);
    box-shadow: 0 0 6px var(--accent, #ffb000);
  }
  .hdr-bell .pip[hidden] {
    display: none;
  }
  .hdr-avatar {
    display: inline-flex;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: var(--rad-sm, 4px);
    border: 1px solid var(--line, #262626);
    overflow: hidden;
    background: var(--bg-3, #1c1c1c);
  }
  .hdr-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  // Burger toggle — no framework. Opens/closes the drawer, syncs aria,
  // locks body scroll while open, closes on Escape / link click / an
  // outside click (there's no scrim to click, so any click landing
  // outside the header dismisses it), and resets if the viewport grows
  // back past the 1000px breakpoint where the drawer is hidden anyway.
  // Focus trapping is explicitly out of scope for this pass.
  (() => {
    const header = document.querySelector('header.hdr');
    const btn = document.getElementById('site-drawer-toggle');
    const drawer = document.getElementById('site-drawer');
    if (!header || !btn || !drawer) return;
    const menuIcon = btn.querySelector('.icon-menu');
    const closeIcon = btn.querySelector('.icon-close');
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.hidden = !open;
      menuIcon?.classList.toggle('is-hidden', open);
      closeIcon?.classList.toggle('is-hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => setOpen(Boolean(drawer.hidden)));
    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (drawer.hidden) return;
      if (!header.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (m) => {
      if (m.matches) setOpen(false);
    });
  })();
</script>

<script>
  // Theme toggle — flips the same localStorage key Starlight's own theme
  // select persists ('starlight-theme'), so the preference stays ONE
  // preference site-wide (3.7 unification). Icon reflects current theme.
  (() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn) return;
    const sun = btn.querySelector('.icon-sun');
    const moon = btn.querySelector('.icon-moon');
    const syncIcon = () => {
      const dark = document.documentElement.dataset.theme !== 'light';
      // Show the icon of the theme you'd switch TO.
      sun?.classList.toggle('is-hidden', dark === false);
      moon?.classList.toggle('is-hidden', dark === true);
    };
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        /* no storage — theme still flips for this page */
      }
      syncIcon();
    });
    syncIcon();
  })();
</script>

<script>
  // Scroll-aware promotion of a transparent (hero) header to solid —
  // mirrors the comp's `.hdr.ontop` state. Only wired up for headers
  // whose data-tone is "transparent"; solid headers are inert here.
  // Tiny + passive, rAF-throttled so it stays cheap on long scrolls.
  (() => {
    const hdr = document.querySelector('header.hdr[data-tone="transparent"]');
    if (!hdr) return;
    const threshold = () => window.innerHeight * 0.8;
    let ticking = false;
    const sync = () => {
      ticking = false;
      hdr.classList.toggle('ontop', window.scrollY <= threshold());
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };
    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  })();
</script>

<script>
  // Discourse SSO auth affordance. Signed-out: does nothing, #hdr-auth
  // stays [hidden] and the chrome is byte-identical to before this
  // shipped. Signed-in: unhides the bell + avatar, points them at the
  // forum, and polls /api/forum/notifications for the unread pip.
  //
  // Silent re-auth: if /api/auth/session 401s but this browser has
  // signed in here before (localStorage 'hal0:seen-session'), we fire a
  // background `fetch('/api/auth/login?prompt=none&...', {credentials:
  // 'include', redirect:'follow'})`. The browser follows the full
  // hal0.dev → forum → hal0.dev redirect chain and applies each hop's
  // Set-Cookie normally (no iframe, so no X-Frame-Options concern); we
  // just re-check /api/auth/session afterwards rather than trying to read
  // the outcome off the fetch response. A miss clears the hint so we
  // stop retrying on every future page load.
  (() => {
    const container = document.querySelector<HTMLElement>('#hdr-auth');
    if (!container) return;
    const bell = document.querySelector<HTMLAnchorElement>('#hdr-auth-bell');
    const pip = document.querySelector<HTMLElement>('#hdr-auth-pip');
    const avatarLink = document.querySelector<HTMLAnchorElement>('#hdr-auth-avatar');
    const avatarImg = document.querySelector<HTMLImageElement>('#hdr-auth-avatar-img');
    const SEEN_KEY = 'hal0:seen-session';

    interface SessionResponse {
      signedIn: boolean;
      username?: string;
      avatar_url?: string;
      forum_url?: string;
    }

    const rememberSeen = () => {
      try {
        localStorage.setItem(SEEN_KEY, '1');
      } catch {
        /* no storage available — session still renders for this page load */
      }
    };
    const forgetSeen = () => {
      try {
        localStorage.removeItem(SEEN_KEY);
      } catch {
        /* no storage available */
      }
    };
    const hasSeenSession = (): boolean => {
      try {
        return localStorage.getItem(SEEN_KEY) === '1';
      } catch {
        return false;
      }
    };

    const fetchSession = async (): Promise<SessionResponse | null> => {
      try {
        const resp = await fetch('/api/auth/session', { credentials: 'same-origin' });
        if (!resp.ok) return null;
        return (await resp.json()) as SessionResponse;
      } catch {
        return null;
      }
    };

    const silentLogin = async (): Promise<void> => {
      const returnPath = location.pathname + location.search;
      try {
        await fetch(`/api/auth/login?prompt=none&return=${encodeURIComponent(returnPath)}`, {
          credentials: 'include',
          redirect: 'follow',
        });
      } catch {
        /* silent check failed to even round-trip — treated as signed-out below */
      }
    };

    const refreshNotifications = async () => {
      if (!pip) return;
      try {
        const resp = await fetch('/api/forum/notifications', { credentials: 'same-origin' });
        if (!resp.ok) return;
        const data = (await resp.json()) as { unread_count?: number };
        pip.hidden = !(typeof data.unread_count === 'number' && data.unread_count > 0);
      } catch {
        /* transient network error — leave the pip as-is rather than flash it */
      }
    };

    const applySession = (session: SessionResponse) => {
      if (!session.username) return;
      const forumUrl = (session.forum_url || '').replace(/\/$/, '');
      if (avatarImg && session.avatar_url) avatarImg.src = session.avatar_url;
      if (forumUrl && avatarLink) avatarLink.href = `${forumUrl}/u/${encodeURIComponent(session.username)}`;
      if (forumUrl && bell) bell.href = `${forumUrl}/u/${encodeURIComponent(session.username)}/notifications`;
      container.hidden = false;
      rememberSeen();
      void refreshNotifications();
    };

    (async () => {
      let session = await fetchSession();
      if (!session?.signedIn && hasSeenSession()) {
        await silentLogin();
        session = await fetchSession();
        if (!session?.signedIn) forgetSeen();
      }
      if (session?.signedIn) applySession(session);
    })();
  })();
</script>
