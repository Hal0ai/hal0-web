---
/**
 * CapGlyphs — capability glyphs for the /benchmarks leaderboard and its
 * legend. The five SVG paths below are lifted VERBATIM from
 * `src/components/ModelRoster.astro`'s ICONS map (do not redraw) — see
 * docs/design/2026-08-09-platform-handoff/README.md ("Capability glyphs:
 * the five paths in ModelRoster.astro, reproduced in bench-app.jsx").
 *
 * Two render modes:
 *  - default: renders `caps` as glyph-only chips (row-level use), each with
 *    its label as a tooltip. Empty caps renders the roster's own "—".
 *  - `legend`: ignores `caps` and renders every known capability as a
 *    glyph + label pair, for the table's bucket/capability legend.
 *
 * Tints: `cap-mtp` reuses the --accent token (already canonical); `cap-vision`
 * is its own hue and is tokenized as --hal0-cap-vision (tokens.css) rather
 * than hard-coded here, per the design tokens' "never a literal hex in a
 * component" rule.
 *
 * Styling (`.caps`, `.cap`, `.cap-legend`, …) lives in
 * src/styles/site-data.css rather than a scoped <style> block here: this
 * component renders both the static filter-bar caps pills (server-only)
 * and the per-row leaderboard glyphs, and bench-island.ts's
 * capGlyphsHtml() reproduces the row markup client-side on every
 * render() pass (including the first one, on page load) — a scoped rule
 * here would stop matching the row glyphs the instant the island
 * hydrates. See site-data.css's "leaderboard row content" section.
 */
export interface Props {
  caps: string[];
  legend?: boolean;
}

const { caps, legend = false } = Astro.props;

const ICONS: Record<string, { label: string; svg: string }> = {
  mtp: { label: 'MTP speculative', svg: '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8.7 1 3 9h3.6l-1 6 6.4-8H9.1z"/></svg>' },
  vision: { label: 'Vision', svg: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M1 8s2.6-4.6 7-4.6S15 8 15 8s-2.6 4.6-7 4.6S1 8 1 8z"/><circle cx="8" cy="8" r="1.9"/></svg>' },
  tools: { label: 'Tool-calling', svg: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 1.6a3.4 3.4 0 0 0-3.2 4.5L1.7 11.4 4 13.7l5.3-5.4a3.4 3.4 0 0 0 4.5-3.2l-2 2-2-2z"/></svg>' },
  coding: { label: 'Coding', svg: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 4 1.6 8 5 12"/><polyline points="11 4 14.4 8 11 12"/></svg>' },
  reasoning: { label: 'Reasoning', svg: '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1l1.5 4.3L14 7l-4.5 1.7L8 13l-1.5-4.3L2 7l4.5-1.7z"/></svg>' },
};

const rowEntries = (caps ?? []).filter((c) => ICONS[c]).map((c) => [c, ICONS[c]] as const);
const legendEntries = Object.entries(ICONS);
---

{legend ? (
  <span class="cap-legend">
    {legendEntries.map(([k, v]) => (
      <span class="lg"><span class={`cap cap-${k}`} title={v.label} set:html={v.svg} />{v.label}</span>
    ))}
  </span>
) : rowEntries.length === 0 ? (
  <span class="capnone">—</span>
) : (
  <span class="caps">
    {rowEntries.map(([k, v]) => (
      <span class={`cap cap-${k}`} title={v.label} set:html={v.svg} />
    ))}
  </span>
)}
