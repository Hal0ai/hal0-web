---
/**
 * Override Starlight's default SiteTitle so the docs/blog chrome carries the
 * same site nav as the marketing apex — otherwise the Starlight section is an
 * island. Renders the inline-SVG wordmark (theme-aware via currentColor; the
 * amber "0" stays accented) followed by `visibleHeader` from src/data/nav.json
 * (the learn IA manifest, filtered for `hidden` entries): `learn` (an
 * umbrella whose `match` array covers /docs, /blog, /changelog, /releases —
 * so it highlights active on docs, blog, changelog, and releases pages alike)
 * and `benchmarks`. `learn`'s per-page sub-links (docs/blog/changelog/
 * releases) render separately via SubNav, not here. The wordmark links
 * home (`/`).
 *
 * Blog/changelog/releases all roll up under `learn` here on the Starlight
 * side; benchmarks is its own top-level entry (mutually exclusive with
 * `learn` via nav.json's `exclude`) — so this nav is the seam that stitches
 * the marketing and Starlight halves together under one manifest.
 * starlight-blog's own header link is disabled (navigation: 'none') since
 * Blog is covered here.
 */
import config from 'virtual:starlight/user-config';
import { visibleHeader as links, isActive } from '../lib/nav';
import Wordmark from './Wordmark.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

const path = Astro.url.pathname;
---

<div class="hal0-sitetitle sl-flex">
  <a href={siteTitleHref} class="site-title sl-flex">
    <Wordmark size="text-xl" />
    <span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
      {siteTitle}
    </span>
  </a>

  <nav class="hal0-docnav" aria-label="Site">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={['hal0-docnav-link', { active: isActive(path, l) }]}
        aria-current={isActive(path, l) ? 'page' : undefined}
      >{l.label}</a>
    ))}
  </nav>
</div>

<style>
  @layer starlight.core {
    .hal0-sitetitle {
      align-items: center;
      gap: 1.5rem;
      min-width: 0;
    }
    .site-title {
      align-items: center;
      gap: var(--sl-nav-gap);
      color: var(--sl-color-white);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    .site-title span {
      overflow: hidden;
    }

    /* Shared nav — hidden on narrow viewports (Starlight shows its mobile
     * menu there); inline next to the brand on wider screens. */
    .hal0-docnav {
      display: none;
    }
    @media (min-width: 56rem) {
      .hal0-docnav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
    }
    .hal0-docnav-link {
      font-family: var(--sl-font-mono, monospace);
      font-size: var(--sl-text-sm, 0.875rem);
      color: var(--sl-color-gray-3, #9ca3af);
      text-decoration: none;
      transition: color 150ms ease;
    }
    .hal0-docnav-link:hover {
      color: var(--sl-color-white);
    }
    .hal0-docnav-link.active {
      color: var(--sl-color-text-accent, var(--hal0-accent, #ffb000));
    }
  }
</style>
