---
/**
 * MarketingLayout — shared chrome for non-docs pages (/, /releases,
 * /benchmarks, /profiles, /contributing). Reuses the global stylesheet (which carries
 * both Starlight tokens and the hal0 design system) and provides a
 * thin top nav + footer.
 *
 * Props:
 *   title         – <title> + og:title
 *   description?  – meta description + og:description
 *   ogImage?      – social card path (defaults to /og-default.png)
 *   navTone?      – "solid" (default) | "transparent" — only the
 *                   landing page wants transparent-on-top, because
 *                   only it has a full-bleed hero. Transparent navs
 *                   automatically promote to solid past the fold
 *                   (see the inline scroll watcher in <body>).
 *   noindex?      – emit <meta name="robots" content="noindex"> for pages
 *                   that must never rank (thank-you / confirmation pages).
 *                   Such pages are also filtered out of the sitemap in
 *                   astro.config.mjs; keep the two lists in step.
 *   jsonLd?       – schema.org nodes for this page. The layout always emits
 *                   ONE JSON-LD script in <head> holding
 *                   {"@context":"https://schema.org","@graph":[...]}, and the
 *                   graph always starts with the site-wide Organization and
 *                   WebSite nodes (src/lib/seo.ts), followed by the page's own.
 *                   Pages pass their nodes here; they never render their own
 *                   JSON-LD script.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SubNav from '../components/SubNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';
import nav from '../data/nav.json';
import { SITE_URL, THEME_COLOR_DARK, THEME_COLOR_LIGHT, organizationSameAs, siteGraph } from '../lib/seo.ts';

// Preload the two latin web fonts that drive above-the-fold rendering —
// without these, the FOUT swap from system fallback → real font pushes
// CLS to ~0.21 on long pages like /releases.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import jbm700 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url';
import jbm400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  navTone?: 'transparent' | 'solid';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Local AI for your home. Strix Halo native.',
  ogImage = '/og-default.png',
  navTone = 'solid',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).toString();
// Social crawlers want an absolute image URL, not a root-relative path.
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE_URL).toString();
// One @graph per page: the site-wide Organization and WebSite nodes first,
// then every node the page hands us, in a single script so crawlers see one
// cross-referenceable document.
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [...siteGraph(organizationSameAs(nav.social)), ...jsonLd],
};
// Every `<` is written as the six characters backslash-u-0-0-3-c so a string
// value containing "</script>" cannot end the script element early; JSON
// parsers decode that escape back to `<`.
const jsonLdText = JSON.stringify(jsonLdGraph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Browser chrome colour per scheme: --hal0-bg in dark and light (tokens.css). -->
    <meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={THEME_COLOR_LIGHT} media="(prefers-color-scheme: light)" />

    <!-- Theme unification (handoff 3.7): marketing pages read the theme
         Starlight's toggle persisted (localStorage 'starlight-theme') so
         the whole site keeps ONE preference. Inline + before any paint to
         avoid a flash; the static data-theme="dark" above stays as the
         no-JS / first-visit default (dark-first). 'auto' or unset follows
         the OS preference, mirroring Starlight's own resolution. -->
    <script is:inline>
      (() => {
        try {
          var stored = localStorage.getItem('starlight-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          /* no storage access — keep the dark default */
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="hal0 blog" href="/blog/rss.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg" color="#feaf00" />

    <!-- Preload critical latin web fonts so above-the-fold content
         doesn't reflow when the swap finally arrives. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbm700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbm400} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="hal0" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hal0 — local AI inference for AMD Strix Halo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Analytics 4 — renders nothing unless PUBLIC_GA_MEASUREMENT_ID
         is set at build time (src/lib/analytics.ts). -->
    <Analytics />

    <script is:inline type="application/ld+json" set:html={jsonLdText} />
  </head>

  <body class="site min-h-screen bg-hal0-bg text-hal0-fg antialiased">
    <SiteHeader tone={navTone} />
    <SubNav />

    <main>
      <slot />
    </main>

    <SiteFooter />

    <!-- Screenshot lightbox (shared with the docs/blog via astro.config head). -->
    <script is:inline src="/js/lightbox.js" defer></script>
    <!-- ⌘K search palette over the Pagefind index (see public/js/site-search.js). -->
    <script is:inline src="/js/site-search.js" defer></script>
  </body>
</html>
