---
/**
 * MarketingLayout — shared chrome for non-docs pages (/, /install,
 * /hardware, /roadmap). Reuses the global stylesheet (which carries
 * both Starlight tokens and the hal0 design system) and provides a
 * thin top nav + footer.
 *
 * Props:
 *   title         – <title> + og:title
 *   description?  – meta description + og:description
 *   ogImage?      – social card path (defaults to /og-default.png)
 *   navTone?      – "solid" (default) | "transparent" — only the
 *                   landing page wants transparent-on-top, because
 *                   only it has a full-bleed hero. Transparent navs
 *                   automatically promote to solid past the fold
 *                   (see the inline scroll watcher in <body>).
 */
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Preload the two latin web fonts that drive above-the-fold rendering —
// without these, the FOUT swap from system fallback → real font pushes
// CLS to ~0.21 on long pages like /hardware.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import jbm700 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url';
import jbm400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  navTone?: 'transparent' | 'solid';
}

const {
  title,
  description = 'Local AI for your home. Strix Halo native.',
  ogImage = '/og-default.png',
  navTone = 'solid',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hal0.dev').toString();
// Social crawlers want an absolute image URL, not a root-relative path.
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://hal0.dev').toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/logo-halo-dark-favico.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#feaf00" />

    <!-- Preload critical latin web fonts so above-the-fold content
         doesn't reflow when the swap finally arrives. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbm700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jbm400} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="hal0" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hal0 — local AI inference for AMD Strix Halo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body class="min-h-screen bg-hal0-bg text-hal0-fg antialiased">
    <header
      class="hal0-nav sticky top-0 z-40"
      data-tone={navTone}
      data-scrolled="false"
    >
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center gap-2">
          <Wordmark size="text-xl" />
          <span class="sr-only">— home</span>
        </a>
        <ul class="hidden items-center gap-7 font-mono text-sm text-hal0-fg-muted md:flex">
          <li><a class="transition hover:text-hal0-fg" href="/docs/">docs</a></li>
          <li><a class="transition hover:text-hal0-fg" href="/blog">blog</a></li>
          <li><a class="transition hover:text-hal0-fg" href="/changelog">changelog</a></li>
          <li><a class="transition hover:text-hal0-fg" href="/releases">releases</a></li>
          <li><a class="transition hover:text-hal0-fg" href="/#roadmap">roadmap</a></li>
          <li>
            <a
              class="transition hover:text-hal0-fg"
              href="https://github.com/hal0ai/hal0"
              rel="noopener"
            >github</a>
          </li>
          <li>
            <a
              class="flex items-center transition hover:text-hal0-fg"
              href="https://discord.gg/7M4y6dcUyq"
              rel="noopener"
              aria-label="Join the hal0 Discord"
              title="Discord"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
              <span class="sr-only">Discord</span>
            </a>
          </li>
        </ul>
        <button
          id="nav-toggle"
          class="hal0-burger md:hidden"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span><span></span><span></span>
        </button>
      </nav>
      <ul id="mobile-menu" class="hal0-mobile-menu md:hidden" hidden>
        <li><a href="/docs/">docs</a></li>
        <li><a href="/blog">blog</a></li>
        <li><a href="/changelog">changelog</a></li>
        <li><a href="/releases">releases</a></li>
        <li><a href="/#roadmap">roadmap</a></li>
        <li><a href="https://github.com/hal0ai/hal0" rel="noopener">github</a></li>
        <li><a href="https://discord.gg/7M4y6dcUyq" rel="noopener">discord</a></li>
      </ul>
    </header>

    <main>
      <slot />
    </main>

    <SiteFooter />

    <!-- Screenshot lightbox (shared with the docs/blog via astro.config head). -->
    <script is:inline src="/js/lightbox.js" defer></script>

    <!-- Scroll-aware navbar:
         data-tone='solid'                    → frosted bg + amber accent
         data-tone='transparent'              → bare (used at top of landing)
         data-tone='transparent' + scrolled   → promotes to solid

         The script is intentionally tiny (no client framework) and uses
         a passive scroll listener, throttled via requestAnimationFrame
         so it stays cheap on long scrolls. -->
    <script is:inline>
      (() => {
        const nav = document.querySelector('header.hal0-nav[data-tone="transparent"]');
        if (!nav) return;
        const threshold = () => window.innerHeight * 0.8;
        let ticking = false;
        const sync = () => {
          ticking = false;
          nav.dataset.scrolled = window.scrollY > threshold() ? 'true' : 'false';
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(sync);
        };
        sync();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', sync, { passive: true });
      })();
    </script>

    <!-- Mobile menu toggle — tiny, no framework. -->
    <script is:inline>
      (() => {
        const btn = document.getElementById('nav-toggle');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        const setOpen = (open) => {
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          menu.hidden = !open;
          btn.classList.toggle('open', open);
        };
        btn.addEventListener('click', () => setOpen(menu.hidden));
        menu.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
        // Reset if the viewport grows back to desktop.
        window.matchMedia('(min-width: 768px)').addEventListener('change', (m) => { if (m.matches) setOpen(false); });
      })();
    </script>
  </body>
</html>

<style>
  /* Two visual states, three triggers.
   *   - tone='solid'                     → solid (always lit)
   *   - tone='transparent'               → bare (only valid at top of landing)
   *   - tone='transparent' + scrolled    → promoted to solid
   *
   * Solid = frosted #0a0a0a, plus the "vacuum-tube" accent:
   *   1) a 1px filament along the bottom edge (gradient → centred amber)
   *   2) a soft amber halo glow under the filament (faint, large radius)
   * Both kept subtle — the goal is "the rack is on", not Vegas. */

  .hal0-nav {
    --hal0-nav-bg: transparent;
    --hal0-nav-shadow: 0 0 0 0 transparent;
    --hal0-nav-filament: 0;

    background-color: var(--hal0-nav-bg);
    box-shadow: var(--hal0-nav-shadow);
    transition:
      background-color 200ms var(--hal0-ease, ease),
      backdrop-filter 200ms var(--hal0-ease, ease),
      box-shadow 200ms var(--hal0-ease, ease);
    position: sticky;
    top: 0;
  }

  .hal0-nav[data-tone='solid'],
  .hal0-nav[data-tone='transparent'][data-scrolled='true'] {
    --hal0-nav-bg: rgba(10, 10, 10, 0.85);
    --hal0-nav-shadow: 0 1px 24px -10px rgba(255, 176, 0, 0.28);
    --hal0-nav-filament: 1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* The filament — a 1px gradient line on the bottom edge that
   * brightens to sodium amber at centre. Faded by --hal0-nav-filament
   * so it inherits the same transition as the bg. */
  .hal0-nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--hal0-accent) 60%, transparent) 50%,
      transparent 100%
    );
    opacity: var(--hal0-nav-filament, 0);
    transition: opacity 200ms var(--hal0-ease, ease);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hal0-nav,
    .hal0-nav::after {
      transition: none;
    }
  }

  /* ── mobile menu ── */
  .hal0-burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 9px;
    border: 1px solid var(--hal0-border);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
  }
  .hal0-burger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--hal0-fg-muted);
    border-radius: 2px;
    transition: transform 200ms var(--hal0-ease, ease), opacity 150ms ease;
  }
  .hal0-burger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hal0-burger.open span:nth-child(2) { opacity: 0; }
  .hal0-burger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .hal0-mobile-menu {
    list-style: none;
    margin: 0;
    padding: 8px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(10, 10, 10, 0.97);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hal0-border);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.7);
  }
  .hal0-mobile-menu[hidden] { display: none; }
  .hal0-mobile-menu a {
    display: block;
    padding: 12px 4px;
    font-family: var(--hal0-font-mono);
    font-size: 0.95rem;
    color: var(--hal0-fg-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--hal0-border);
  }
  .hal0-mobile-menu li:last-child a { border-bottom: none; }
  .hal0-mobile-menu a:hover { color: var(--hal0-fg); }
</style>
