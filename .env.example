# Discourse-as-IdP (DiscourseConnect provider) sign-in — see
# src/pages/api/auth/** and src/pages/api/forum/notifications.ts.
# Set the real values in Vercel project env vars, never in a committed file.

# Forum origin, no trailing slash.
DISCOURSE_URL=https://forum.hal0.dev

# Must match a "discourse connect provider secrets" entry in the forum's
# admin site settings. Used to HMAC-sign/verify the SSO payload and the
# stateless login/logout nonce.
DISCOURSE_CONNECT_SECRET=

# Admin API credentials for the /api/forum/notifications server-side proxy
# (Discourse admin > API keys — scope to Notifications:Read for the key).
DISCOURSE_ADMIN_API_KEY=
DISCOURSE_ADMIN_API_USERNAME=

# Signs the hal0.dev session cookie (src/lib/auth/session.ts). Unrelated to
# DISCOURSE_CONNECT_SECRET — rotate independently.
SESSION_JWT_SECRET=
